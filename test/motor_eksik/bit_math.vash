import math

# bit işlemleri
var a = 12
var b = 10
print(a & b, a | b, a ^ b, 1 << 10, 1024 >> 3, -16 >> 2)
var katmanlar = (1 << 0) | (1 << 3)            # oyuncu ve düşman katmanları
print(katmanlar & (1 << 3) is not 0, katmanlar & (1 << 2) is not 0)
var karma = 0
repeat i from 1 to 5 {
    karma = (karma << 5) ^ i
}
print(karma)

# matematik
print(math.sqrt(2.0), math.sin(math.PI / 2.0), math.cos(0.0), math.round(2.5), math.round(-0.4))
print(math.clamp(15.0, 0.0, 10.0), math.lerp(0.0, 100.0, 0.25), math.max_int(3, 9), math.abs(-2.5))
print(math.degrees(math.PI), math.atan2(1.0, 1.0) * 4.0)
var v = math.vec2(3.0, 4.0)
print(v.length(), v.normalized(), v.add(math.vec2(1.0, 1.0)), v.scale(2.0), v.dot(math.vec2(1.0, 0.0)))
var r = math.vec2(1.0, 0.0).rotated(math.PI / 2.0)
print(math.round(r.x * 1000.0) / 1000.0, r.y, v.distance(math.vec2(0.0, 0.0)))
