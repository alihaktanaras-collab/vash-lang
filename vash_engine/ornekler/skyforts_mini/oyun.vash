# Sky Forts Mini: gökyüzündeki adanda üs kur.
#   vash run oyun.vash            (kayıt: kayit.json; oyun kapalıyken de binalar üretir)
#   vash run oyun.vash --demo --ekran resim.png   (hazır bir üsle açıp ekran görüntüsü alır)
import graphics
import iso
import json
import math

extern "kernel32" needs time {
    fn _GetSystemTimeAsFileTime(veri: bytes)
}

global var KAYNAKLAR = ["metal", "yakit", "kristal"]
global var INSA_EDILEBILIR = ["maden", "pompa", "kristal", "depo", "jenerator"]
global var INSAATCI = 2

# ---------- bina bilgileri (seviye 1..3) ----------
fn bina_adi(tur: text) -> text {
    if tur is "komuta" { return "Komuta Merkezi" }
    if tur is "maden" { return "Metal Madeni" }
    if tur is "pompa" { return "Yakıt Pompası" }
    if tur is "kristal" { return "Kristal Toplayıcı" }
    if tur is "depo" { return "Depo" }
    if tur is "jenerator" { return "Enerji Jeneratörü" }
    return "Ağaç"
}

fn bina_aciklamasi(tur: text) -> text {
    if tur is "komuta" { return "Üssün kalbi. Yükseltince daha çok ve daha güçlü bina kurulur." }
    if tur is "maden" { return "Adanın taşından metal çıkarır." }
    if tur is "pompa" { return "Derinlerden yakıt pompalar." }
    if tur is "kristal" { return "Gökyüzü kristallerini toplar. Yavaş ama değerli." }
    if tur is "depo" { return "Metal, yakıt ve kristal için yer açar." }
    if tur is "jenerator" { return "Binaların çalışması için enerji üretir." }
    return "Yer açmak için kaldırılabilir."
}

fn boyut(tur: text) -> int {
    if tur is "komuta" { return 3 }
    if tur is "agac" { return 1 }
    return 2
}

fn kaynagi(tur: text) -> text {
    if tur is "maden" { return "metal" }
    if tur is "pompa" { return "yakit" }
    if tur is "kristal" { return "kristal" }
    return ""
}

# saatte üretim
fn uretim(tur: text, sev: int) -> float {
    if tur is "maden" or tur is "pompa" { return [600.0, 1200.0, 2100.0][sev] }
    if tur is "kristal" { return [90.0, 180.0, 330.0][sev] }
    return 0.0
}

# binanın içinde birikebilecek en çok miktar
fn bina_kapasitesi(tur: text, sev: int) -> float {
    if tur is "maden" or tur is "pompa" { return [120.0, 300.0, 600.0][sev] }
    if tur is "kristal" { return [20.0, 50.0, 110.0][sev] }
    return 0.0
}

# [metal, yakıt, kristal]
fn maliyet(tur: text, sev: int) -> [int] {
    if tur is "maden" { return [[0, 60, 0], [250, 250, 0], [700, 700, 20]][sev] }
    if tur is "pompa" { return [[60, 0, 0], [250, 250, 0], [700, 700, 20]][sev] }
    if tur is "kristal" { return [[200, 200, 0], [600, 600, 40], [1500, 1500, 120]][sev] }
    if tur is "depo" { return [[150, 150, 0], [500, 500, 20], [1200, 1200, 60]][sev] }
    if tur is "jenerator" { return [[120, 40, 0], [400, 300, 20], [1000, 800, 60]][sev] }
    if tur is "komuta" { return [[0, 0, 0], [800, 800, 50], [2500, 2500, 200]][sev] }
    return [0, 0, 0]
}

# saniye
fn sure(tur: text, sev: int) -> float {
    if tur is "komuta" { return [0.0, 60.0, 150.0][sev] }
    if tur is "kristal" { return [20.0, 60.0, 120.0][sev] }
    if tur is "maden" or tur is "pompa" { return [10.0, 40.0, 90.0][sev] }
    return [15.0, 45.0, 100.0][sev]
}

fn enerji_ihtiyaci(tur: text) -> int {
    if tur is "maden" or tur is "pompa" { return 2 }
    if tur is "kristal" { return 3 }
    if tur is "depo" { return 1 }
    return 0
}

fn enerji_uretimi(tur: text, sev: int) -> int {
    if tur is "komuta" { return [5, 8, 12][sev] }
    if tur is "jenerator" { return [6, 10, 15][sev] }
    return 0
}

# komuta seviyesine göre en çok kaç tane
fn en_fazla(tur: text, komuta: int) -> int {
    if tur is "maden" or tur is "pompa" or tur is "jenerator" { return [1, 2, 3][komuta] }
    if tur is "kristal" { return [0, 1, 2][komuta] }
    if tur is "depo" { return [1, 1, 2][komuta] }
    return 1
}

fn depo_metal(tur: text, sev: int) -> float {
    if tur is "komuta" { return [1000.0, 2500.0, 5000.0][sev] }
    if tur is "depo" { return [1000.0, 2500.0, 5000.0][sev] }
    return 0.0
}

fn depo_kristal(tur: text, sev: int) -> float {
    if tur is "komuta" { return [150.0, 400.0, 900.0][sev] }
    if tur is "depo" { return [100.0, 250.0, 500.0][sev] }
    return 0.0
}

fn kaynak_adi(k: text) -> text {
    if k is "metal" { return "Metal" }
    if k is "yakit" { return "Yakıt" }
    if k is "kristal" { return "Kristal" }
    return "Enerji"
}

fn simge_sira(k: text) -> int {
    if k is "metal" { return 0 }
    if k is "yakit" { return 1 }
    if k is "kristal" { return 2 }
    return 3
}

# 12345 → "12.345"
fn sayi(n: float) -> text {
    var t = text(int(math.floor(n)))
    var eksi = ""
    if t.starts_with("-") {
        eksi = "-"
        t = t[2 to t.length]
    }
    var parcalar: [text] = []
    var i = t.length
    repeat while i > 0 {
        var bas = math.max_int(1, i - 2)
        parcalar.add(t[bas to i])
        i = bas - 1
    }
    var ters: [text] = []
    repeat j from parcalar.length to 1 step -1 {
        ters.add(parcalar[j])
    }
    return "{eksi}{ters.join(".")}"
}

fn sure_metni(sn: float) -> text {
    var s = int(math.ceil(sn))
    if s >= 60 {
        var dk = s // 60
        var kalan = s % 60
        if kalan < 10 {
            return "{dk}:0{kalan}"
        }
        return "{dk}:{kalan}"
    }
    return "{s} sn"
}

# Gerçek saat (saniye): oyun kapalıyken geçen süre için
fn simdi() -> float {
    use time
    var b = bytes(8)
    _GetSystemTimeAsFileTime(b)
    return float(b.get_int(1, 8)) / 10000000.0 - 11644473600.0
}

fn renk(h: text) -> graphics.Color {
    var s = h
    if s.starts_with("#") {
        s = s[2 to s.length]
    }
    var d = "0123456789abcdef"
    var r: [int] = []
    repeat i from 1 to 3 {
        var a = 0
        var b = 0
        repeat k from 1 to 16 {
            if d[k] is s[i * 2 - 1] {
                a = k - 1
            }
            if d[k] is s[i * 2] {
                b = k - 1
            }
        }
        r.add(a * 16 + b)
    }
    return graphics.rgb(r[1], r[2], r[3])
}

# ---------- oyun verisi ----------
type Bina {
    tur: text
    gx: int
    gy: int
    seviye: int = 1
    insa: bool = false            # ilk kez kuruluyor
    bitis: float = 0.0            # inşaat/yükseltme bitiş saati (0: boşta)
    son: float = 0.0              # üretimin en son hesaplandığı saat
    birikmis: float = 0.0
}

type Yazi {
    metin: text
    x: float
    y: float
    omur: float
    renk: graphics.Color
}

type Parca {
    x: float
    y: float
    vx: float
    vy: float
    omur: float
    renk: graphics.Color
}

type Capa {
    gen: float
    yuk: float
    x: float
    y: float
}

type Oyun {
    binalar: [Bina] = []
    metal: float = 400.0
    yakit: float = 400.0
    kristal: float = 30.0
    grid: iso.Grid = iso.Grid(origin_x: 228.0, origin_y: 6.0, tile_w: 32.0, tile_h: 16.0, size: 14)
    resimler: {text: graphics.Texture} = {}
    capalar: {text: Capa} = {}
    sesler: {text: graphics.Sound} = {}
    yazi_tipi: {text: graphics.Font} = {}
    kam_x: float = 228.0
    kam_y: float = 180.0
    zoom: float = 2.0
    secili: int = 0
    mod: text = ""                # "" | "koy" | "tasi"
    koyulan: text = ""
    tasinan: int = 0
    mesaj: text = ""
    mesaj_omur: float = 0.0
    yazilar: [Yazi] = []
    parcalar: [Parca] = []
    saat: float = 0.0
    surukle: bool = false
    surukle_x: float = 0.0
    surukle_y: float = 0.0
    kam_bas_x: float = 0.0
    kam_bas_y: float = 0.0
    surukledi: bool = false
    kayit_zamani: float = 0.0
    fare_ui: bool = false
    tik: bool = false

    # ---------- yükleme ----------
    fn change hazirla() {
        use screen
        use sound
        use files
        var adlar = ["ada", "komuta", "maden", "pompa", "kristal", "depo", "jenerator", "iskele2", "iskele3", "agaclar", "kaya", "simgeler", "bulutlar", "uzak_adalar"]
        repeat i from 1 to adlar.length {
            var r = graphics.load_texture("resimler/{adlar[i]}.png")
            graphics.set_smooth(r, false)
            resimler[adlar[i]] = r
        }
        var bilgi = json.parse(read_file("resimler/bilgi.json") else: "\{\}") else: json.null()
        var b = json.get(bilgi, "buildings")
        var turler = json.keys(b)
        repeat i from 1 to turler.length {
            var v = json.get(b, turler[i])
            capalar[turler[i]] = Capa(gen: json.as_number(json.get(v, "frame_width"), 70.0), yuk: json.as_number(json.get(v, "height"), 100.0), x: json.as_number(json.get(v, "anchor_x"), 35.0), y: json.as_number(json.get(v, "anchor_y"), 70.0))
        }
        var ses_adlari = ["yerlestir", "topla", "bitti", "tik", "hata"]
        repeat i from 1 to ses_adlari.length {
            sesler[ses_adlari[i]] = graphics.load_sound("sesler/{ses_adlari[i]}.wav")
        }
        yazi_tipi["k"] = graphics.load_font("C:/Windows/Fonts/seguisb.ttf", 18)
        yazi_tipi["b"] = graphics.load_font("C:/Windows/Fonts/seguisb.ttf", 26)
        yazi_tipi["n"] = graphics.load_font("C:/Windows/Fonts/segoeui.ttf", 16)
    }

    fn change yeni_oyun() {
        use time
        var t = simdi()
        binalar = [Bina(tur: "komuta", gx: 5, gy: 5, son: t)]
        var agaclar = [[0, 0], [1, 0], [0, 2], [12, 1], [13, 3], [11, 12], [13, 11], [2, 12], [0, 9], [8, 0], [13, 7], [6, 13]]
        repeat i from 1 to agaclar.length {
            var tur = "agac"
            binalar.add(Bina(tur: tur, gx: agaclar[i][1], gy: agaclar[i][2], seviye: 1 + i % 2, son: t))
        }
    }

    # Gösterim için kurulmuş bir üs
    fn change demo() {
        use time
        var t = simdi()
        yeni_oyun()
        binalar[1].seviye = 2
        binalar.add(Bina(tur: "maden", gx: 2, gy: 3, seviye: 2, son: t, birikmis: 140.0))
        binalar.add(Bina(tur: "pompa", gx: 9, gy: 3, seviye: 2, son: t, birikmis: 60.0))
        binalar.add(Bina(tur: "kristal", gx: 9, gy: 8, seviye: 1, son: t, birikmis: 12.0))
        binalar.add(Bina(tur: "jenerator", gx: 3, gy: 9, seviye: 2, son: t))
        binalar.add(Bina(tur: "depo", gx: 6, gy: 10, seviye: 1, son: t))
        binalar.add(Bina(tur: "maden", gx: 2, gy: 6, seviye: 1, insa: true, son: t, bitis: t + 7.0))
        binalar.add(Bina(tur: "jenerator", gx: 10, gy: 11, seviye: 1, son: t, bitis: t + 33.0))
        metal = 1840.0
        yakit = 1265.0
        kristal = 94.0
    }

    # ---------- kayıt ----------
    fn kayit_metni() -> text {
        var bs: [json.Json] = []
        repeat i from 1 to binalar.length {
            var b = binalar[i]
            bs.add(json.object({"tur": json.string(b.tur), "gx": json.number(float(b.gx)), "gy": json.number(float(b.gy)), "seviye": json.number(float(b.seviye)), "insa": json.boolean(b.insa), "bitis": json.number(b.bitis), "son": json.number(b.son), "birikmis": json.number(b.birikmis)}))
        }
        return json.pretty(json.object({"metal": json.number(metal), "yakit": json.number(yakit), "kristal": json.number(kristal), "binalar": json.array(bs)}))
    }

    fn change kaydet() {
        use files
        write_file("kayit.json", "{kayit_metni()}\n")
    }

    fn change yukle() -> bool {
        use files
        var icerik = read_file("kayit.json")
        if icerik is none {
            return false
        }
        var d = json.parse(icerik) else: json.null()
        if json.is_null(d) {
            return false
        }
        metal = json.as_number(json.get(d, "metal"), 0.0)
        yakit = json.as_number(json.get(d, "yakit"), 0.0)
        kristal = json.as_number(json.get(d, "kristal"), 0.0)
        binalar = []
        var l = json.as_list(json.get(d, "binalar"))
        repeat i from 1 to l.length {
            var v = l[i]
            binalar.add(Bina(tur: json.as_text(json.get(v, "tur"), "agac"), gx: json.as_int(json.get(v, "gx"), 0), gy: json.as_int(json.get(v, "gy"), 0), seviye: json.as_int(json.get(v, "seviye"), 1), insa: json.as_bool(json.get(v, "insa"), false), bitis: json.as_number(json.get(v, "bitis"), 0.0), son: json.as_number(json.get(v, "son"), 0.0), birikmis: json.as_number(json.get(v, "birikmis"), 0.0)))
        }
        return binalar.length > 0
    }

    # ---------- hesaplar ----------
    fn komuta_seviyesi() -> int {
        repeat i from 1 to binalar.length {
            if binalar[i].tur is "komuta" {
                return binalar[i].seviye
            }
        }
        return 1
    }

    fn sayisi(tur: text) -> int {
        var n = 0
        repeat i from 1 to binalar.length {
            if binalar[i].tur is tur {
                n = n + 1
            }
        }
        return n
    }

    fn calisan_insaat() -> int {
        var n = 0
        repeat i from 1 to binalar.length {
            if binalar[i].bitis > 0.0 {
                n = n + 1
            }
        }
        return n
    }

    fn enerji_toplam() -> int {
        var n = 0
        repeat i from 1 to binalar.length {
            var b = binalar[i]
            if not b.insa {
                n = n + enerji_uretimi(b.tur, b.seviye)
            }
        }
        return n
    }

    fn enerji_kullanilan() -> int {
        var n = 0
        repeat i from 1 to binalar.length {
            n = n + enerji_ihtiyaci(binalar[i].tur)
        }
        return n
    }

    fn depo_siniri(k: text) -> float {
        var n = 0.0
        repeat i from 1 to binalar.length {
            var b = binalar[i]
            if not b.insa {
                if k is "kristal" {
                    n = n + depo_kristal(b.tur, b.seviye)
                } else {
                    n = n + depo_metal(b.tur, b.seviye)
                }
            }
        }
        return n
    }

    fn miktar(k: text) -> float {
        if k is "metal" {
            return metal
        }
        if k is "yakit" {
            return yakit
        }
        return kristal
    }

    fn yetiyor_mu(m: [int]) -> bool {
        return metal >= float(m[1]) and yakit >= float(m[2]) and kristal >= float(m[3])
    }

    fn change harca(m: [int]) {
        metal = metal - float(m[1])
        yakit = yakit - float(m[2])
        kristal = kristal - float(m[3])
    }

    fn change ekle(k: text, n: float) -> float {
        var sinir = depo_siniri(k)
        var once = miktar(k)
        var sonra = math.min(sinir, once + n)
        if k is "metal" {
            metal = sonra
        } else if k is "yakit" {
            yakit = sonra
        } else {
            kristal = sonra
        }
        return sonra - once
    }

    # Bu bina bu karoya konabilir mi?
    fn yer_bos_mu(tur: text, gx: int, gy: int, haric: int) -> bool {
        var n = boyut(tur)
        if gx < 0 or gy < 0 or gx + n > grid.size or gy + n > grid.size {
            return false
        }
        repeat i from 1 to binalar.length {
            if i is not haric {
                var b = binalar[i]
                var m = boyut(b.tur)
                if gx < b.gx + m and gx + n > b.gx and gy < b.gy + m and gy + n > b.gy {
                    return false
                }
            }
        }
        return true
    }

    # Neden kurulamaz? ("" ise kurulabilir)
    fn kurma_engeli(tur: text) -> text {
        var k = komuta_seviyesi()
        if sayisi(tur) >= en_fazla(tur, k) {
            if k < 3 {
                return "Daha fazlası için Komuta Merkezi'ni yükselt"
            }
            return "En fazla sayıya ulaştın"
        }
        if enerji_kullanilan() + enerji_ihtiyaci(tur) > enerji_toplam() {
            return "Yeterli enerji yok: jeneratör kur"
        }
        if calisan_insaat() >= INSAATCI {
            return "İki inşaatçı da çalışıyor"
        }
        if not yetiyor_mu(maliyet(tur, 1)) {
            return "Kaynak yetmiyor"
        }
        return ""
    }

    fn yukseltme_engeli(i: int) -> text {
        var b = binalar[i]
        if b.tur is "agac" {
            return "Ağaç yükseltilmez"
        }
        if b.seviye >= 3 {
            return "En yüksek seviyede"
        }
        if b.bitis > 0.0 {
            return "Zaten inşaatta"
        }
        if b.tur is not "komuta" and b.seviye >= komuta_seviyesi() {
            return "Önce Komuta Merkezi'ni yükselt"
        }
        if calisan_insaat() >= INSAATCI {
            return "İki inşaatçı da çalışıyor"
        }
        if not yetiyor_mu(maliyet(b.tur, b.seviye + 1)) {
            return "Kaynak yetmiyor"
        }
        return ""
    }

    # ---------- zaman geçtikçe ----------
    fn change guncelle(dt: float) {
        use time
        use sound
        var t = simdi()
        saat = saat + dt
        repeat i from 1 to binalar.length {
            var b = binalar[i]
            if b.bitis > 0.0 and t >= b.bitis {
                if b.insa {
                    binalar[i].insa = false
                } else {
                    binalar[i].seviye = b.seviye + 1
                }
                binalar[i].bitis = 0.0
                binalar[i].son = t
                b = binalar[i]
                _cal("bitti")
                var m = _merkez(i)
                _patlat(m.x, m.y - 20.0, renk("#ffe26b"), 30)
                soyle("{bina_adi(b.tur)} hazır! (Seviye {b.seviye})")
            }
            if b.bitis is 0.0 and not b.insa and kaynagi(b.tur).length > 0 {
                var gecen = math.max(0.0, t - b.son)
                binalar[i].birikmis = math.min(bina_kapasitesi(b.tur, b.seviye), b.birikmis + uretim(b.tur, b.seviye) / 3600.0 * gecen)
                binalar[i].son = t
            } else {
                binalar[i].son = t
            }
        }
        if mesaj_omur > 0.0 {
            mesaj_omur = mesaj_omur - dt
        }
        var kalan: [Yazi] = []
        repeat i from 1 to yazilar.length {
            var y = yazilar[i]
            y.omur = y.omur - dt
            y.y = y.y - 30.0 * dt
            if y.omur > 0.0 {
                kalan.add(y)
            }
        }
        yazilar = kalan
        var kalan_p: [Parca] = []
        repeat i from 1 to parcalar.length {
            var p = parcalar[i]
            p.omur = p.omur - dt
            p.vy = p.vy + 260.0 * dt
            p.x = p.x + p.vx * dt
            p.y = p.y + p.vy * dt
            if p.omur > 0.0 {
                kalan_p.add(p)
            }
        }
        parcalar = kalan_p
    }

    fn change soyle(t: text) {
        mesaj = t
        mesaj_omur = 2.5
    }

    fn _cal(ad: text) {
        use sound
        if sesler.has(ad) {
            graphics.play_sound(sesler[ad])
        }
    }

    fn change _patlat(x: float, y: float, c: graphics.Color, n: int) {
        repeat k from 1 to n {
            var a = random(0.0 to math.TAU)
            var h = random(30.0 to 120.0)
            parcalar.add(Parca(x: x, y: y, vx: math.cos(a) * h, vy: math.sin(a) * h - 80.0, omur: random(0.5 to 1.1), renk: c))
        }
    }

    # ---------- işler ----------
    fn change topla(i: int) {
        use sound
        var b = binalar[i]
        var k = kaynagi(b.tur)
        if k.length is 0 or b.birikmis < 1.0 {
            return
        }
        var eklenen = ekle(k, math.floor(b.birikmis))
        if eklenen < 1.0 {
            _cal("hata")
            soyle("{kaynak_adi(k)} deposu dolu! Depo kur ya da yükselt.")
            return
        }
        binalar[i].birikmis = b.birikmis - eklenen
        _cal("topla")
        var m = _merkez(i)
        yazilar.add(Yazi(metin: "+{sayi(eklenen)} {kaynak_adi(k)}", x: m.x, y: m.y - 50.0, omur: 1.4, renk: graphics.WHITE))
    }

    fn change kur(tur: text, gx: int, gy: int) {
        use files
        use time
        use sound
        var engel = kurma_engeli(tur)
        if engel.length > 0 {
            _cal("hata")
            soyle(engel)
            return
        }
        harca(maliyet(tur, 1))
        var t = simdi()
        binalar.add(Bina(tur: tur, gx: gx, gy: gy, insa: true, bitis: t + sure(tur, 1), son: t))
        secili = binalar.length
        _cal("yerlestir")
        var m = _merkez(binalar.length)
        _patlat(m.x, m.y, renk("#a0663a"), 16)
        kaydet()
    }

    fn change yukselt(i: int) {
        use files
        use time
        use sound
        var engel = yukseltme_engeli(i)
        if engel.length > 0 {
            _cal("hata")
            soyle(engel)
            return
        }
        var b = binalar[i]
        harca(maliyet(b.tur, b.seviye + 1))
        binalar[i].bitis = simdi() + sure(b.tur, b.seviye + 1)
        _cal("yerlestir")
        soyle("{bina_adi(b.tur)} yükseltiliyor")
        kaydet()
    }

    fn change kaldir(i: int) {
        use files
        use sound
        if binalar[i].tur is not "agac" {
            return
        }
        if metal < 20.0 {
            _cal("hata")
            soyle("Ağacı kaldırmak 20 metal ister")
            return
        }
        metal = metal - 20.0
        var m = _merkez(i)
        _patlat(m.x, m.y - 10.0, renk("#38b764"), 20)
        binalar.remove(i)
        secili = 0
        _cal("yerlestir")
        kaydet()
    }

    # ---------- dünya / ekran ----------
    fn _sallanma() -> float {
        return math.sin(saat * 0.8) * 2.0
    }

    fn ekran_x(wx: float) -> float {
        use screen
        return float(graphics.screen_width()) / 2.0 + (wx - kam_x) * zoom
    }

    fn ekran_y(wy: float) -> float {
        use screen
        return float(graphics.screen_height()) / 2.0 + (wy + _sallanma() - kam_y) * zoom
    }

    fn dunya_x(sx: float) -> float {
        use screen
        return kam_x + (sx - float(graphics.screen_width()) / 2.0) / zoom
    }

    fn dunya_y(sy: float) -> float {
        use screen
        return kam_y + (sy - float(graphics.screen_height()) / 2.0) / zoom - _sallanma()
    }

    # binanın ayak izinin ortası (dünya)
    fn _merkez(i: int) -> graphics.Vector2 {
        var b = binalar[i]
        var n = boyut(b.tur)
        var ust = grid.tile_to_world(b.gx, b.gy)
        return graphics.Vector2(x: ust.x, y: ust.y + float(n) * grid.tile_h / 2.0)
    }

    # ekrandaki bir noktada hangi bina (resmine göre, öndeki önce)
    fn isabet(sx: float, sy: float) -> int {
        use screen
        var sira = cizim_sirasi()
        var wx = dunya_x(sx)
        var wy = dunya_y(sy)
        repeat k from sira.length to 1 step -1 {
            var i = sira[k]
            var b = binalar[i]
            var n = boyut(b.tur)
            var ust = grid.tile_to_world(b.gx, b.gy)
            var hx = float(n) * grid.tile_w / 2.0
            var yuk = 28.0 + float(n) * 10.0
            if b.tur is "agac" {
                yuk = 30.0
            }
            if wx >= ust.x - hx and wx <= ust.x + hx and wy >= ust.y - yuk and wy <= ust.y + float(n) * grid.tile_h {
                return i
            }
        }
        return 0
    }

    fn cizim_sirasi() -> [int] {
        var sira: [int] = []
        repeat i from 1 to binalar.length {
            sira.add(i)
        }
        var l = binalar
        sira.sort(by: fn(a, b) => l[a].gx + l[a].gy + boyut(l[a].tur) * 2 < l[b].gx + l[b].gy + boyut(l[b].tur) * 2)
        return sira
    }

    # ---------- çizim ----------
    fn ciz() {
        use screen
        use time
        var w = float(graphics.screen_width())
        var h = float(graphics.screen_height())
        graphics.draw_gradient(0.0, 0.0, w, h, renk("#3d7fd1"), renk("#bde6ff"))
        _katman("uzak_adalar", 0.15, 0.25, 220.0, 2.0, graphics.rgba(255, 255, 255, 200))
        _katman("bulutlar", 0.3, 4.0, 60.0, 2.0, graphics.rgba(255, 255, 255, 170))
        # ada
        var ada = resimler["ada"]
        graphics.draw_sprite(ada, 0.0, 0.0, float(ada.width), float(ada.height), ekran_x(0.0), ekran_y(0.0), float(ada.width) * zoom, float(ada.height) * zoom, 0.0, false, graphics.WHITE)
        _zemin_isaretleri()
        var sira = cizim_sirasi()
        repeat k from 1 to sira.length {
            if not (mod is "tasi" and sira[k] is tasinan) {
                _bina_ciz(sira[k])
            }
        }
        _hayalet()
        repeat k from 1 to sira.length {
            _ust_bilgi(sira[k])
        }
        repeat k from 1 to parcalar.length {
            var p = parcalar[k]
            var s = 2.0 * zoom
            graphics.draw_rectangle(ekran_x(p.x) - s / 2.0, ekran_y(p.y) - s / 2.0, s, s, graphics.fade(p.renk, math.min(1.0, p.omur * 2.0)))
        }
        repeat k from 1 to yazilar.length {
            var y = yazilar[k]
            var g = graphics.text_width_font(yazi_tipi["k"], y.metin, 18.0)
            var a = math.min(1.0, y.omur * 2.0)
            graphics.draw_text_font(yazi_tipi["k"], y.metin, ekran_x(y.x) - g / 2.0 + 1.0, ekran_y(y.y) + 1.0, 18.0, graphics.rgba(0, 0, 0, int(140.0 * a)))
            graphics.draw_text_font(yazi_tipi["k"], y.metin, ekran_x(y.x) - g / 2.0, ekran_y(y.y), 18.0, graphics.fade(y.renk, a))
        }
        _katman("bulutlar", 0.9, 9.0, 330.0, 3.0, graphics.rgba(255, 255, 255, 120))
    }

    fn _katman(ad: text, hiz: float, kayma: float, y: float, olcek: float, ton: graphics.Color) {
        use screen
        var r = resimler[ad]
        var gen = float(r.width) * olcek * zoom / 2.0
        var yuk = float(r.height) * olcek * zoom / 2.0
        var sw = float(graphics.screen_width())
        var bas = -(kam_x * hiz * zoom + saat * kayma * zoom)
        bas = bas - math.floor(bas / gen) * gen - gen
        var sy = float(graphics.screen_height()) / 2.0 + (y - kam_y * hiz) * zoom
        var x = bas
        repeat while x < sw {
            graphics.draw_sprite(r, 0.0, 0.0, float(r.width), float(r.height), x, sy, gen + 1.0, yuk, 0.0, false, ton)
            x = x + gen
        }
    }

    fn _zemin_isaretleri() {
        use screen
        if mod.length > 0 or fare_ui {
            return
        }
        var k = grid.world_to_tile(dunya_x(graphics.mouse_position().x), dunya_y(graphics.mouse_position().y))
        if k.x >= 0 {
            var p = grid.tile_to_world(k.x, k.y)
            iso.draw_tile(ekran_x(p.x), ekran_y(p.y), grid.tile_w * zoom, grid.tile_h * zoom, graphics.rgba(255, 255, 255, 50))
        }
        if secili > 0 {
            var b = binalar[secili]
            var p = grid.tile_to_world(b.gx, b.gy)
            var n = boyut(b.tur)
            iso.draw_area(ekran_x(p.x), ekran_y(p.y), n, n, grid.tile_w * zoom, grid.tile_h * zoom, graphics.rgba(255, 226, 107, 60))
            iso.draw_area_outline(ekran_x(p.x), ekran_y(p.y), n, n, grid.tile_w * zoom, grid.tile_h * zoom, 2.0, renk("#ffe26b"))
        }
    }

    fn _bina_ciz(i: int) {
        use screen
        use time
        var b = binalar[i]
        var ust = grid.tile_to_world(b.gx, b.gy)
        if b.tur is "agac" {
            var r = resimler["agaclar"]
            var fw = float(r.width) / 2.0
            graphics.draw_sprite(r, float(b.seviye - 1) * fw, 0.0, fw, float(r.height), ekran_x(ust.x - fw / 2.0), ekran_y(ust.y + 15.0 - float(r.height)), fw * zoom, float(r.height) * zoom, 0.0, false, graphics.WHITE)
            return
        }
        var ad = b.tur
        var kare = b.seviye - 1
        if b.insa {
            ad = "iskele{boyut(b.tur)}"
            kare = 0
        }
        var c = capalar[ad]
        var r = resimler[ad]
        var ton = graphics.WHITE
        if secili is i {
            ton = graphics.rgb(255, 250, 225)
        }
        graphics.draw_sprite(r, float(kare) * c.gen, 0.0, c.gen, c.yuk, ekran_x(ust.x - c.x), ekran_y(ust.y - c.y), c.gen * zoom, c.yuk * zoom, 0.0, false, ton)
    }

    # inşaat çubuğu ve toplama baloncuğu
    fn _ust_bilgi(i: int) {
        use screen
        use time
        var b = binalar[i]
        if b.tur is "agac" {
            return
        }
        var m = _merkez(i)
        var n = float(boyut(b.tur))
        var tepe_y = ekran_y(m.y - 34.0 - n * 12.0)
        var x = ekran_x(m.x)
        if b.bitis > 0.0 {
            var toplam = sure(b.tur, b.seviye)
            if not b.insa {
                toplam = sure(b.tur, b.seviye + 1)
            }
            var kalan = math.max(0.0, b.bitis - simdi())
            var oran = math.clamp(1.0 - kalan / math.max(1.0, toplam), 0.0, 1.0)
            var g = 92.0
            graphics.draw_rounded(x - g / 2.0 - 4.0, tepe_y - 4.0, g + 8.0, 34.0, 8.0, graphics.rgba(20, 24, 40, 210))
            graphics.draw_rounded(x - g / 2.0, tepe_y + 18.0, g, 8.0, 4.0, graphics.rgba(255, 255, 255, 40))
            graphics.draw_rounded(x - g / 2.0, tepe_y + 18.0, g * oran, 8.0, 4.0, renk("#ffcd75"))
            var t = sure_metni(kalan)
            var tg = graphics.text_width_font(yazi_tipi["k"], t, 16.0)
            graphics.draw_text_font(yazi_tipi["k"], t, x - tg / 2.0, tepe_y - 2.0, 16.0, graphics.WHITE)
            return
        }
        var k = kaynagi(b.tur)
        if k.length > 0 and b.birikmis >= math.max(1.0, bina_kapasitesi(b.tur, b.seviye) * 0.1) {
            var zip = math.sin(saat * 3.0 + float(i)) * 3.0
            var by = tepe_y + zip
            var dolu = b.birikmis >= bina_kapasitesi(b.tur, b.seviye) - 0.5
            var zemin = graphics.rgba(255, 255, 255, 235)
            if dolu {
                zemin = renk("#ffe26b")
            }
            graphics.draw_circle(x, by + 14.0, 17.0, graphics.rgba(0, 0, 0, 60))
            graphics.draw_circle(x, by + 12.0, 17.0, zemin)
            graphics.draw_triangle(x - 6.0, by + 26.0, x + 6.0, by + 26.0, x, by + 34.0, zemin)
            _simge(k, x - 12.0, by, 24.0)
        }
    }

    fn _simge(k: text, x: float, y: float, s: float) {
        use screen
        var r = resimler["simgeler"]
        graphics.draw_sprite(r, float(simge_sira(k)) * 12.0, 0.0, 12.0, 12.0, x, y, s, s, 0.0, false, graphics.WHITE)
    }

    # yerleştirilen / taşınan binanın gölgesi
    fn _hayalet() {
        use screen
        if mod.length is 0 or fare_ui {
            return
        }
        var tur = koyulan
        var haric = 0
        var sev = 0
        if mod is "tasi" {
            tur = binalar[tasinan].tur
            haric = tasinan
            sev = binalar[tasinan].seviye - 1
        }
        var n = boyut(tur)
        var fare = graphics.mouse_position()
        var k = grid.world_to_tile(dunya_x(fare.x), dunya_y(fare.y))
        var gx = k.x - (n - 1) // 2
        var gy = k.y - (n - 1) // 2
        var p = grid.tile_to_world(gx, gy)
        var uygun = k.x >= 0 and yer_bos_mu(tur, gx, gy, haric)
        var alan = graphics.rgba(80, 220, 120, 110)
        var cizgi = graphics.rgb(120, 255, 160)
        if not uygun {
            alan = graphics.rgba(255, 80, 80, 110)
            cizgi = graphics.rgb(255, 120, 120)
        }
        iso.draw_area(ekran_x(p.x), ekran_y(p.y), n, n, grid.tile_w * zoom, grid.tile_h * zoom, alan)
        iso.draw_area_outline(ekran_x(p.x), ekran_y(p.y), n, n, grid.tile_w * zoom, grid.tile_h * zoom, 2.0, cizgi)
        var c = capalar[tur]
        var r = resimler[tur]
        graphics.draw_sprite(r, float(sev) * c.gen, 0.0, c.gen, c.yuk, ekran_x(p.x - c.x), ekran_y(p.y - c.y), c.gen * zoom, c.yuk * zoom, 0.0, false, graphics.rgba(255, 255, 255, 170))
    }

    # ---------- arayüz ----------
    fn change arayuz() {
        use screen
        use sound
        use time
        use files
        var w = float(graphics.screen_width())
        var h = float(graphics.screen_height())
        # kaynaklar
        var x = 16.0
        repeat i from 1 to 3 {
            var k = KAYNAKLAR[i]
            _kaynak_hapi(k, sayi(miktar(k)), miktar(k) / math.max(1.0, depo_siniri(k)), "/ {sayi(depo_siniri(k))}", x, 16.0)
            x = x + 214.0
        }
        var ek = enerji_kullanilan()
        var et = enerji_toplam()
        _kaynak_hapi("enerji", "{ek}", float(ek) / math.max(1.0, float(et)), "/ {et}", x, 16.0)
        # inşaatçı
        var ins = "İnşaatçı {INSAATCI - calisan_insaat()}/{INSAATCI}"
        var ig = graphics.text_width_font(yazi_tipi["k"], ins, 18.0) + 36.0
        graphics.draw_rounded(w - ig - 16.0, 16.0, ig, 44.0, 12.0, graphics.rgba(18, 22, 38, 200))
        graphics.draw_text_font(yazi_tipi["k"], ins, w - ig + 2.0, 26.0, 18.0, graphics.WHITE)
        # mesaj
        if mesaj_omur > 0.0 {
            var mg = graphics.text_width_font(yazi_tipi["k"], mesaj, 18.0) + 40.0
            var a = math.min(1.0, mesaj_omur * 2.0)
            graphics.draw_rounded((w - mg) / 2.0, 76.0, mg, 40.0, 12.0, graphics.rgba(18, 22, 38, int(220.0 * a)))
            graphics.draw_text_font(yazi_tipi["k"], mesaj, (w - mg) / 2.0 + 20.0, 85.0, 18.0, graphics.fade(graphics.WHITE, a))
        }
        _insa_cubugu(w, h)
        if secili > 0 and mod.length is 0 {
            _bilgi_paneli(w, h)
        }
        if mod.length > 0 {
            var ipucu = "Sol tık: yerleştir   ·   Sağ tık / Esc: vazgeç"
            var g = graphics.text_width_font(yazi_tipi["n"], ipucu, 16.0) + 32.0
            graphics.draw_rounded((w - g) / 2.0, h - 176.0, g, 34.0, 10.0, graphics.rgba(18, 22, 38, 210))
            graphics.draw_text_font(yazi_tipi["n"], ipucu, (w - g) / 2.0 + 16.0, h - 168.0, 16.0, graphics.WHITE)
        }
    }

    fn change _kaynak_hapi(k: text, deger: text, oran: float, sinir: text, x: float, y: float) {
        use screen
        var g = 200.0
        graphics.draw_rounded(x, y, g, 44.0, 12.0, graphics.rgba(18, 22, 38, 200))
        graphics.draw_rounded(x + 44.0, y + 34.0, g - 56.0, 4.0, 2.0, graphics.rgba(255, 255, 255, 30))
        var dolu = renk("#73eff7")
        if oran >= 0.999 {
            dolu = renk("#ff7a5c")
        }
        graphics.draw_rounded(x + 44.0, y + 34.0, (g - 56.0) * math.clamp(oran, 0.0, 1.0), 4.0, 2.0, dolu)
        _simge(k, x + 10.0, y + 10.0, 24.0)
        graphics.draw_text_font(yazi_tipi["k"], deger, x + 44.0, y + 5.0, 18.0, graphics.WHITE)
        var dg = graphics.text_width_font(yazi_tipi["k"], deger, 18.0)
        graphics.draw_text_font(yazi_tipi["n"], sinir, x + 50.0 + dg, y + 7.0, 16.0, graphics.rgb(160, 175, 205))
        if _icinde(x, y, g, 44.0) {
            fare_ui = true
        }
    }

    fn _icinde(x: float, y: float, w: float, h: float) -> bool {
        use screen
        var f = graphics.mouse_position()
        return f.x >= x and f.x <= x + w and f.y >= y and f.y <= y + h
    }

    fn change _insa_cubugu(w: float, h: float) {
        use screen
        use sound
        use time
        use files
        var kart_g = 132.0
        var kart_h = 140.0
        var bosluk = 10.0
        var top_g = float(INSA_EDILEBILIR.length) * (kart_g + bosluk) - bosluk + 24.0
        var px = (w - top_g) / 2.0
        var py = h - kart_h - 30.0
        graphics.draw_rounded(px, py, top_g, kart_h + 20.0, 16.0, graphics.rgba(18, 22, 38, 215))
        if _icinde(px, py, top_g, kart_h + 20.0) {
            fare_ui = true
        }
        repeat i from 1 to INSA_EDILEBILIR.length {
            var tur = INSA_EDILEBILIR[i]
            var kx = px + 12.0 + float(i - 1) * (kart_g + bosluk)
            var ky = py + 10.0
            var engel = kurma_engeli(tur)
            var ustte = _icinde(kx, ky, kart_g, kart_h)
            var secik = mod is "koy" and koyulan is tur
            var zemin = graphics.rgba(255, 255, 255, 14)
            if secik {
                zemin = graphics.rgba(115, 239, 247, 60)
            } else if ustte {
                zemin = graphics.rgba(255, 255, 255, 30)
            }
            graphics.draw_rounded(kx, ky, kart_g, kart_h, 12.0, zemin)
            if secik {
                graphics.draw_rounded_outline(kx, ky, kart_g, kart_h, 12.0, 2.0, renk("#73eff7"))
            }
            # küçük resim
            var c = capalar[tur]
            var r = resimler[tur]
            var olcek = (kart_g - 34.0) / c.gen
            var ton = graphics.WHITE
            if engel.length > 0 {
                ton = graphics.rgba(255, 255, 255, 120)
            }
            # resmin altı (binanın tabanı) kartta 74. piksele otursun; üstü kırpılır
            var taban = (c.y + c.gen / 2.0) * olcek
            graphics.clip_begin(kx, ky + 2.0, kart_g, 74.0)
            graphics.draw_sprite(r, 0.0, 0.0, c.gen, c.yuk, kx + (kart_g - c.gen * olcek) / 2.0, ky + 74.0 - taban, c.gen * olcek, c.yuk * olcek, 0.0, false, ton)
            graphics.clip_end()
            var ad = bina_adi(tur)
            var ag = graphics.text_width_font(yazi_tipi["n"], ad, 15.0)
            graphics.draw_text_font(yazi_tipi["n"], ad, kx + (kart_g - ag) / 2.0, ky + 78.0, 15.0, graphics.WHITE)
            # maliyet
            var m = maliyet(tur, 1)
            var mx = kx + 10.0
            repeat j from 1 to 3 {
                if m[j] > 0 {
                    var yeter = miktar(KAYNAKLAR[j]) >= float(m[j])
                    _simge(KAYNAKLAR[j], mx, ky + 104.0, 16.0)
                    var yr = graphics.rgb(220, 228, 245)
                    if not yeter {
                        yr = renk("#ff7a5c")
                    }
                    graphics.draw_text_font(yazi_tipi["n"], sayi(float(m[j])), mx + 18.0, ky + 102.0, 15.0, yr)
                    mx = mx + 26.0 + graphics.text_width_font(yazi_tipi["n"], sayi(float(m[j])), 15.0)
                }
            }
            var sayac = "{sayisi(tur)}/{en_fazla(tur, komuta_seviyesi())}"
            graphics.draw_text_font(yazi_tipi["n"], sayac, kx + kart_g - 34.0, ky + 6.0, 14.0, graphics.rgb(160, 175, 205))
            if ustte {
                graphics.set_cursor(graphics.CURSOR_HAND)
                if engel.length > 0 {
                    _ipucu(engel, kx + kart_g / 2.0, ky - 12.0)
                }
                if tik {
                    if engel.length > 0 {
                        _cal("hata")
                        soyle(engel)
                    } else {
                        _cal("tik")
                        mod = "koy"
                        koyulan = tur
                        secili = 0
                    }
                }
            }
        }
    }

    fn _ipucu(t: text, x: float, y: float) {
        use screen
        var g = graphics.text_width_font(yazi_tipi["n"], t, 15.0) + 24.0
        graphics.draw_rounded(x - g / 2.0, y - 30.0, g, 30.0, 8.0, graphics.rgba(10, 12, 22, 235))
        graphics.draw_text_font(yazi_tipi["n"], t, x - g / 2.0 + 12.0, y - 24.0, 15.0, renk("#ffcd75"))
    }

    fn change _bilgi_paneli(w: float, h: float) {
        use screen
        use sound
        use time
        use files
        var b = binalar[secili]
        var pg = 320.0
        var px = w - pg - 16.0
        var py = 76.0
        var ph = 300.0
        if b.tur is "agac" {
            ph = 170.0
        }
        graphics.draw_rounded(px, py, pg, ph, 16.0, graphics.rgba(18, 22, 38, 225))
        if _icinde(px, py, pg, ph) {
            fare_ui = true
        }
        var y = py + 16.0
        graphics.draw_text_font(yazi_tipi["b"], bina_adi(b.tur), px + 18.0, y, 26.0, graphics.WHITE)
        y = y + 34.0
        if b.tur is not "agac" {
            var sev = "Seviye {b.seviye}"
            if b.insa {
                sev = "İnşa ediliyor"
            }
            graphics.draw_rounded(px + 18.0, y, graphics.text_width_font(yazi_tipi["n"], sev, 15.0) + 20.0, 24.0, 8.0, graphics.rgba(115, 239, 247, 40))
            graphics.draw_text_font(yazi_tipi["n"], sev, px + 28.0, y + 3.0, 15.0, renk("#73eff7"))
            y = y + 34.0
        }
        graphics.draw_text_font(yazi_tipi["n"], bina_aciklamasi(b.tur), px + 18.0, y, 15.0, graphics.rgb(190, 200, 222))
        y = y + 30.0
        var k = kaynagi(b.tur)
        if k.length > 0 and not b.insa {
            _satir("Üretim", "{sayi(uretim(b.tur, b.seviye) / 60.0)} / dk", px, y, pg)
            y = y + 26.0
            _satir("Birikmiş", "{sayi(b.birikmis)} / {sayi(bina_kapasitesi(b.tur, b.seviye))}", px, y, pg)
            y = y + 26.0
        }
        if enerji_uretimi(b.tur, b.seviye) > 0 {
            _satir("Enerji üretir", "+{enerji_uretimi(b.tur, b.seviye)}", px, y, pg)
            y = y + 26.0
        }
        if enerji_ihtiyaci(b.tur) > 0 {
            _satir("Enerji ister", "{enerji_ihtiyaci(b.tur)}", px, y, pg)
            y = y + 26.0
        }
        if depo_metal(b.tur, b.seviye) > 0.0 {
            _satir("Depolar", "{sayi(depo_metal(b.tur, b.seviye))} metal/yakıt", px, y, pg)
            y = y + 26.0
        }
        # düğmeler
        var by = py + ph - 64.0
        if b.tur is "agac" {
            if _dugme("Kaldır  ·  20 metal", px + 18.0, by, pg - 36.0, 46.0, true) {
                kaldir(secili)
            }
            return
        }
        if b.bitis > 0.0 {
            var kalan = math.max(0.0, b.bitis - simdi())
            graphics.draw_text_font(yazi_tipi["k"], "Bitmesine {sure_metni(kalan)}", px + 18.0, by + 12.0, 18.0, renk("#ffcd75"))
            return
        }
        var yarim = (pg - 46.0) / 2.0
        if k.length > 0 {
            if _dugme("Topla", px + 18.0, by, yarim, 46.0, b.birikmis >= 1.0) {
                topla(secili)
            }
        } else if _dugme("Taşı", px + 18.0, by, yarim, 46.0, b.tur is not "komuta") {
            mod = "tasi"
            tasinan = secili
        }
        var engel = yukseltme_engeli(secili)
        var etiket = "Yükselt"
        if b.seviye < 3 {
            var m = maliyet(b.tur, b.seviye + 1)
            etiket = "Yükselt  ·  {sure_metni(sure(b.tur, b.seviye + 1))}"
            var mx = px + 28.0 + yarim
            var my = by - 26.0
            repeat j from 1 to 3 {
                if m[j] > 0 {
                    _simge(KAYNAKLAR[j], mx, my + 2.0, 16.0)
                    var yr = graphics.rgb(220, 228, 245)
                    if miktar(KAYNAKLAR[j]) < float(m[j]) {
                        yr = renk("#ff7a5c")
                    }
                    graphics.draw_text_font(yazi_tipi["n"], sayi(float(m[j])), mx + 18.0, my, 15.0, yr)
                    mx = mx + 24.0 + graphics.text_width_font(yazi_tipi["n"], sayi(float(m[j])), 15.0)
                }
            }
        }
        if _dugme(etiket, px + 28.0 + yarim, by, yarim, 46.0, engel.length is 0) {
            yukselt(secili)
        }
        if engel.length > 0 and _icinde(px + 28.0 + yarim, by, yarim, 46.0) {
            _ipucu(engel, px + 28.0 + yarim * 1.5, by - 30.0)
        }
    }

    fn _satir(ad: text, deger: text, px: float, y: float, pg: float) {
        use screen
        graphics.draw_text_font(yazi_tipi["n"], ad, px + 18.0, y, 16.0, graphics.rgb(160, 175, 205))
        var g = graphics.text_width_font(yazi_tipi["k"], deger, 17.0)
        graphics.draw_text_font(yazi_tipi["k"], deger, px + pg - 18.0 - g, y - 1.0, 17.0, graphics.WHITE)
    }

    fn _dugme(t: text, x: float, y: float, w: float, h: float, acik_mi: bool) -> bool {
        use screen
        var ustte = _icinde(x, y, w, h)
        var zemin = renk("#3b8fd9")
        if not acik_mi {
            zemin = graphics.rgba(255, 255, 255, 30)
        } else if ustte {
            zemin = renk("#5fa5ee")
        }
        graphics.draw_rounded(x, y + 3.0, w, h, 12.0, graphics.rgba(0, 0, 0, 70))
        graphics.draw_rounded(x, y, w, h, 12.0, zemin)
        var g = graphics.text_width_font(yazi_tipi["k"], t, 17.0)
        var yr = graphics.WHITE
        if not acik_mi {
            yr = graphics.rgb(150, 160, 185)
        }
        graphics.draw_text_font(yazi_tipi["k"], t, x + (w - g) / 2.0, y + (h - 24.0) / 2.0, 17.0, yr)
        if ustte {
            graphics.set_cursor(graphics.CURSOR_HAND)
        }
        return ustte and tik
    }

    # ---------- fare ve klavye (dünya) ----------
    fn change dunya_girdisi() {
        use screen
        use sound
        use time
        use files
        var f = graphics.mouse_position()
        var teker = graphics.mouse_wheel()
        if teker is not 0.0 and not fare_ui {
            var wx = dunya_x(f.x)
            var wy = dunya_y(f.y)
            zoom = math.clamp(zoom * math.pow(1.15, teker), 1.0, 4.0)
            kam_x = wx - (f.x - float(graphics.screen_width()) / 2.0) / zoom
            kam_y = wy - (f.y - float(graphics.screen_height()) / 2.0) / zoom - _sallanma()
        }
        if graphics.key_pressed(graphics.KEY_ESCAPE) or graphics.mouse_pressed(graphics.MOUSE_RIGHT) {
            if mod.length > 0 {
                mod = ""
            } else {
                secili = 0
            }
        }
        # kaydırma
        if graphics.mouse_pressed(graphics.MOUSE_LEFT) and not fare_ui {
            surukle = true
            surukledi = false
            surukle_x = f.x
            surukle_y = f.y
            kam_bas_x = kam_x
            kam_bas_y = kam_y
        }
        if surukle and graphics.mouse_button_down(graphics.MOUSE_LEFT) {
            if math.abs(f.x - surukle_x) + math.abs(f.y - surukle_y) > 6.0 {
                surukledi = true
            }
            if surukledi and mod.length is 0 {
                kam_x = kam_bas_x - (f.x - surukle_x) / zoom
                kam_y = kam_bas_y - (f.y - surukle_y) / zoom
            }
        }
        if graphics.mouse_released(graphics.MOUSE_LEFT) and surukle {
            surukle = false
            if not surukledi and not fare_ui {
                _tikla(f.x, f.y)
            }
        }
        kam_x = math.clamp(kam_x, 0.0, 460.0)
        kam_y = math.clamp(kam_y, -100.0, 400.0)
    }

    fn change _tikla(sx: float, sy: float) {
        use screen
        use sound
        use time
        use files
        if mod.length > 0 {
            var tur = koyulan
            var haric = 0
            if mod is "tasi" {
                tur = binalar[tasinan].tur
                haric = tasinan
            }
            var n = boyut(tur)
            var k = grid.world_to_tile(dunya_x(sx), dunya_y(sy))
            var gx = k.x - (n - 1) // 2
            var gy = k.y - (n - 1) // 2
            if k.x < 0 or not yer_bos_mu(tur, gx, gy, haric) {
                _cal("hata")
                soyle("Buraya sığmıyor")
                return
            }
            if mod is "koy" {
                kur(tur, gx, gy)
            } else {
                binalar[tasinan].gx = gx
                binalar[tasinan].gy = gy
                secili = tasinan
                _cal("yerlestir")
                kaydet()
            }
            mod = ""
            return
        }
        var i = isabet(sx, sy)
        if i > 0 {
            var b = binalar[i]
            if kaynagi(b.tur).length > 0 and b.birikmis >= 1.0 and b.bitis is 0.0 and not b.insa {
                topla(i)
            }
            secili = i
            _cal("tik")
        } else {
            secili = 0
        }
    }

    # ---------- her kare ----------
    fn change kare() {
        use screen
        use sound
        use time
        use files
        tik = graphics.mouse_released(graphics.MOUSE_LEFT) and not surukledi
        fare_ui = false
        guncelle(graphics.frame_time())
        graphics.set_cursor(graphics.CURSOR_DEFAULT)
        graphics.begin_drawing(renk("#3d7fd1"))
        ciz()
        arayuz()
        dunya_girdisi()
        graphics.end_drawing()
        kayit_zamani = kayit_zamani + graphics.frame_time()
        if kayit_zamani > 5.0 {
            kaydet()
            kayit_zamani = 0.0
        }
    }
}

# ---------- başlat ----------
var girdiler = args()
var ekran = ""
var demo = false
var dene = false
var sec = 0
var i = 1
repeat while i <= girdiler.length {
    if girdiler[i] is "--ekran" and i < girdiler.length {
        ekran = girdiler[i + 1]
        i = i + 1
    } else if girdiler[i] is "--dene" {
        dene = true
    } else if girdiler[i] is "--demo" {
        demo = true
    } else if girdiler[i] is "--sec" and i < girdiler.length {
        sec = int(girdiler[i + 1], else: 0)
        i = i + 1
    }
    i = i + 1
}

graphics.open_resizable_window(1440, 860, "Sky Forts Mini")
graphics.set_min_size(1000, 640)
graphics.set_exit_key(0)
graphics.open_audio()
var oyun = Oyun()
oyun.hazirla()
if demo {
    oyun.demo()
} else if not oyun.yukle() {
    oyun.yeni_oyun()
    oyun.soyle("Hoş geldin, komutan! Aşağıdan ilk binanı seç.")
}
oyun.secili = sec
if dene {
    # otomatik deneme: kur, bitir, üret, topla, yükselt, kaydet, yükle
    oyun.yeni_oyun()
    print("başlangıç:", oyun.metal, oyun.yakit, oyun.kristal, "bina:", oyun.binalar.length)
    print("maden engeli:", oyun.kurma_engeli("maden"), "| yer (2,2):", oyun.yer_bos_mu("maden", 2, 2, 0), "| yer (5,5):", oyun.yer_bos_mu("maden", 5, 5, 0))
    oyun.kur("maden", 2, 2)
    var m = oyun.binalar.length
    print("kuruldu:", oyun.binalar[m].insa, "yakıt:", oyun.yakit, "inşaatçı:", oyun.calisan_insaat())
    oyun.binalar[m].bitis = simdi() - 1.0
    oyun.guncelle(0.016)
    print("bitti mi:", not oyun.binalar[m].insa, "seviye:", oyun.binalar[m].seviye)
    oyun.binalar[m].son = simdi() - 60.0
    oyun.guncelle(0.016)
    print("1 dk sonra birikmiş:", int(oyun.binalar[m].birikmis))
    var once = oyun.metal
    oyun.topla(m)
    print("toplandı:", int(oyun.metal - once), "kalan:", int(oyun.binalar[m].birikmis))
    print("yükseltme engeli:", oyun.yukseltme_engeli(m))
    oyun.yakit = 2000.0
    oyun.metal = 2000.0
    print("komuta yükseltme engeli:", oyun.yukseltme_engeli(1))
    oyun.yukselt(1)
    oyun.binalar[1].bitis = simdi() - 1.0
    oyun.guncelle(0.016)
    print("komuta seviye:", oyun.komuta_seviyesi(), "maden yükseltme engeli:", oyun.yukseltme_engeli(m))
    oyun.binalar[m].son = simdi() - 3600.0
    oyun.kaydet()
    var ikinci = Oyun()
    print("yüklendi:", ikinci.yukle(), "bina:", ikinci.binalar.length)
    ikinci.guncelle(0.016)
    print("kapalıyken 1 saat: birikmiş", int(ikinci.binalar[m].birikmis), "(sınır", int(bina_kapasitesi("maden", 1)), ")")
    print("sayı biçimi:", sayi(1234567.0), sayi(12.0), sure_metni(95.0))
}
var kare = 0
repeat while graphics.is_open() and not dene {
    oyun.kare()
    kare = kare + 1
    if ekran.length > 0 and kare is 60 {
        graphics.screenshot(ekran)
        stop
    }
}
if not demo and not dene {
    oyun.kaydet()
}
graphics.close_window()
