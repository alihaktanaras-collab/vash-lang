# =====================================================================
#  VASH DERLEYİCİSİ — VASH İLE YAZILMIŞ HÂLİ
#  1. İSTASYON: KELİMELERE AYIRICI (lexer)
# =====================================================================
#
#  Kodu harf harf okuyup "kelimelere" (token) ayırır:
#
#      var x: int = 5      →   [var] [İSİM x] [:] [İSİM int] [=] [SAYI 5] [YENİ_SATIR]
#
#  Bu dosya, derleyici/lexer.py'nin Vash'a çevrilmiş hâlidir ve birebir
#  aynı sonucu vermelidir (vashc/karsilastir.py ile kontrol ediliyor).
#
#  Python'dan farkları:
#    - Python'da sıralar 0'dan, Vash'ta 1'den başlar.
#    - Python hatayı "fırlatır"; burada sonuç bir enum: Tamam(tokenlar) ya da Hata(mesaj).
# =====================================================================

import dil

type Token {
    tur: text           # ne tür bir kelime? "SAYI", "İSİM", "+", "var" ...
    deger: text         # kelimenin kendisi (yoksa "")
    satir: int
    sutun: int
}

enum Sonuc {
    Tamam(tokenlar: [Token])
    Hata(mesaj: text)
}

# Anahtar kelimeler: kodda yazılan → token türü  (function → fn)
global var ANAHTAR_KELIMELER = {
    "fn": "fn", "function": "fn",
    "var": "var", "variable": "var",
    "return": "return",
    "is": "is", "not": "not",
    "true": "true", "false": "false",
    "use": "use", "global": "global",
    "if": "if", "else": "else",
    "repeat": "repeat", "while": "while", "stop": "stop", "skip": "skip",
    "when": "when", "type": "type", "enum": "enum", "match": "match",
    "none": "none", "extern": "extern", "import": "import",
    "measure": "measure", "and": "and", "or": "or"
}

global var TEK_KARAKTERLI = "+-*/%=<>()\{\}[]:,;.?&|^"

fn _token(tur: text, deger: text, satir: int, sutun: int) -> Token {
    return Token(tur: tur, deger: deger, satir: satir, sutun: sutun)
}

# Metin içindeki özel yazımlar: \n → yeni satır, \t → sekme, \" → tırnak, \\ → ters bölü.
# \{ ve \} gerçek süslü parantez yazar; ayırt edilebilsinler diye görünmez özel harflerle saklanır.
fn _kacis(h: text) -> text? {
    if h is "n" { return "\n" }
    if h is "t" { return "\t" }
    if h is "\"" { return "\"" }
    if h is "\\" { return "\\" }
    if h is "\{" { return char(57344) }
    if h is "\}" { return char(57345) }
    return none
}

type MetinSonucu {
    metin: text
    konum: int          # kapanış tırnağından sonraki yer
    hata: text          # "" ise hata yok
}

# Açılış tırnağından sonrasını oku. { } içi ham bırakılır, çünkü orası küçük bir program parçasıdır:
# "{liste.join(", ")}" yazınca içteki tırnaklar metni kapatmaz.
fn _metin_oku(satir: text, bas: int, satir_no: int) -> MetinSonucu {
    var parcalar: [text] = []
    var derinlik = 0                         # kaç tane açık { içindeyiz?
    var n = satir.length
    var i = bas
    repeat while i <= n {
        var h = satir[i]
        if derinlik is 0 {
            if h is "\"" {
                return MetinSonucu(metin: parcalar.join(""), konum: i + 1, hata: "")
            }
            if h is "\\" {
                var k: text? = none
                if i + 1 <= n {
                    k = _kacis(satir[i + 1])
                }
                if k is none {
                    var son = i + 1
                    if son > n {
                        son = n
                    }
                    var gorulen = satir[i to son]
                    return MetinSonucu(metin: "", konum: i, hata: dil.sec("Satır {satir_no}: Metinde '{gorulen}' diye bir özel yazım yok. Kullanılabilenler: \\n (yeni satır), \\t (sekme), \\\" (tırnak), \\\\ (ters bölü), \\\{ ve \\\} (süslü parantez).", "Line {satir_no}: There is no special sequence '{gorulen}' in text. You can use: \\n (new line), \\t (tab), \\\" (quote), \\\\ (backslash), \\\{ and \\\} (curly braces)."))
                }
                parcalar.add(k)
                i = i + 2
                skip
            }
            if h is "\{" {
                derinlik = 1
            }
            parcalar.add(h)
            i = i + 1
        } else {
            # { } içi: ham kopyala, içteki metinleri olduğu gibi atla
            if h is "\"" {
                var j = i + 1
                repeat while j <= n and satir[j] is not "\"" {
                    if satir[j] is "\\" {
                        j = j + 2
                    } else {
                        j = j + 1
                    }
                }
                var son = j
                if son > n {
                    son = n
                }
                parcalar.add(satir[i to son])
                i = j + 1
                skip
            }
            if h is "\{" {
                derinlik = derinlik + 1
            } else if h is "\}" {
                derinlik = derinlik - 1
            }
            parcalar.add(h)
            i = i + 1
        }
    }
    return MetinSonucu(metin: "", konum: i, hata: dil.sec("Satır {satir_no}: Metin kapatılmamış, '\"' eksik.", "Line {satir_no}: Text is not closed, '\"' is missing."))
}

# ANA FONKSİYON: kodu alır, token listesi (ya da hata) döndürür
fn kelimelere_ayir(kod: text) -> Sonuc {
    var tokenlar: [Token] = []
    var satirlar = kod.split("\n")

    repeat satir_no from 1 to satirlar.length {
        var satir = satirlar[satir_no]
        var n = satir.length
        var i = 1
        repeat while i <= n {
            var h = satir[i]
            var sutun = i

            if h is " " or h is "\t" {
                i = i + 1                                    # boşluk: atla
            } else if h is "#" {
                stop                                         # yorum: satırın geri kalanını atla
            } else if h.is_digit() {
                # SAYI (42) ya da ONDALIK (3.14)
                var bas = i
                repeat while i <= n and satir[i].is_digit() {
                    i = i + 1
                }
                if i + 1 <= n and satir[i] is "." and satir[i + 1].is_digit() {
                    i = i + 1
                    repeat while i <= n and satir[i].is_digit() {
                        i = i + 1
                    }
                    tokenlar.add(_token("ONDALIK", satir[bas to i - 1], satir_no, sutun))
                } else {
                    tokenlar.add(_token("SAYI", satir[bas to i - 1], satir_no, sutun))
                }
            } else if h.is_letter() or h is "_" {
                # İSİM ya da ANAHTAR KELİME
                var bas = i
                repeat while i <= n and (satir[i].is_letter() or satir[i].is_digit() or satir[i] is "_") {
                    i = i + 1
                }
                var kelime = satir[bas to i - 1]
                if ANAHTAR_KELIMELER.has(kelime) {
                    tokenlar.add(_token(ANAHTAR_KELIMELER[kelime], "", satir_no, sutun))
                } else {
                    tokenlar.add(_token("İSİM", kelime, satir_no, sutun))
                }
            } else if h is "\"" {
                # METİN
                var m = _metin_oku(satir, i + 1, satir_no)
                if m.hata.length > 0 {
                    return Sonuc.Hata(mesaj: m.hata)
                }
                tokenlar.add(_token("METİN", m.metin, satir_no, sutun))
                i = m.konum
            } else {
                var iki = ""
                if i + 1 <= n {
                    iki = satir[i to i + 1]
                }
                if iki is "==" {
                    return Sonuc.Hata(mesaj: dil.sec("Satır {satir_no}, sütun {sutun}: Bu dilde '==' yok.\n   Eşitlik için 'is' kullan:   x is 5", "Line {satir_no}, column {sutun}: This language has no '=='.\n   Use 'is' for equality:   x is 5"))
                }
                if iki is "!=" {
                    return Sonuc.Hata(mesaj: dil.sec("Satır {satir_no}, sütun {sutun}: Bu dilde '!=' yok.\n   Eşit değil için 'is not' kullan:   x is not 5", "Line {satir_no}, column {sutun}: This language has no '!='.\n   Use 'is not' for not equal:   x is not 5"))
                }
                if iki is "<=" or iki is ">=" or iki is "->" or iki is "//" or iki is "=>" or iki is "<<" or iki is ">>" {
                    tokenlar.add(_token(iki, "", satir_no, sutun))
                    i = i + 2
                } else if TEK_KARAKTERLI.contains(h) {
                    tokenlar.add(_token(h, "", satir_no, sutun))
                    i = i + 1
                } else {
                    return Sonuc.Hata(mesaj: dil.sec("Satır {satir_no}, sütun {sutun}: '{h}' karakterini tanımıyorum.", "Line {satir_no}, column {sutun}: I don't recognize the character '{h}'."))
                }
            }
        }
        # Boş olmayan bir satırsa "satır sonu" işareti koy
        if tokenlar.length > 0 and tokenlar[tokenlar.length].tur is not "YENİ_SATIR" {
            tokenlar.add(_token("YENİ_SATIR", "", satir_no, n + 1))
        }
    }
    tokenlar.add(_token("SON", "", satirlar.length, 1))
    return Sonuc.Tamam(tokenlar: tokenlar)
}
