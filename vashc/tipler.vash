# =====================================================================
#  VASH DERLEYİCİSİ — VASH İLE YAZILMIŞ HÂLİ
#  3. İSTASYON: TİP KONTROLÜ
# =====================================================================
#
#  Program çalışmadan önce anlam hatalarını bulur ve her değerin türünü ağaca yazar:
#      var yas = 25
#      yas = "yirmi"        → HATA: 'yas' bir int (tam sayı), ona text (metin) verilemez.
#      print(toplm)         → HATA: 'toplm' diye bir değişken yok. Bunu mu demek istedin: 'toplam'?
#
#  derleyici/tipler.py'nin Vash'a çevrilmiş hâlidir (vashc/karsilastir_tipler.py ile karşılaştırılır).
#
#  Kapsadıkları: değişkenler, hesaplar, if, döngüler, fonksiyonlar, listeler, sözlükler, metinler,
#  none kontrolleri, hazır fonksiyonlar, izinler, type, enum/match, when, window, extern.
#  HENÜZ YOK: import (birden çok dosya ayrı bir istasyonda birleştirilecek) → "DESTEKLENMIYOR: ..."
#
#  Python'dan farklar:
#    - Python düğümlerin üzerine not alır (e.tip = ...). Vash'ta her değer ayrı (kopyala-yaz) olduğu
#      için kontrol, türleri yazılmış YENİ bir ağaç kurar ve onu döndürür.
#    - Python hatayı fırlatır; burada ilk hata not edilir, iş hızla biter, sonuç Hata(mesaj) olur.
# =====================================================================

import lexer
import parser
import oneri
import moduller
import dil

type Degisken {
    ad: text
    tip: text
    tur: text           # "ana", "yerel", "parametre", "global", "dis-okur", "dis-degistirir", "sayac"
    satir: int
    asil: text = ""     # 'if x is not none' ile daraltıldıysa: asıl tipi (T?)
    derinlik: int = 0   # daraltıldığı döngü seviyesi
}

type Fonksiyon {
    ad: text
    p_adlar: [text]
    p_tipler: [text]
    donus: text
    satir: int
    izinler: [text]
    degistirir: bool = false    # metotlarda: "fn change ..." mi?
    tip_adi: text = ""          # metotlarda: hangi tipin metodu?
    c_mi: bool = false          # C'de yazılmış hazır bir fonksiyon mu?
    hata_verir: bool = false    # "fails": hata verebilir mi?
}

# Tiplenmekte olan bir lambda: dışarıdan kullandığı değişkenler (kopyalanır)
type LambdaBilgisi {
    taban: int                  # lambda'nın kendi kapsamının YIGIN'daki yeri
    adlar: [text]               # yakalanan dış değişkenler
    tipler_: [text]
}

# Generic bir fonksiyonun bir tip için üretilecek kopyası: ilk[T] → ilk[int]
type Ornek {
    ad: text                    # "ilk[int]"
    tanim: parser.Dugum         # generic tanım (tipsiz)
    yerine: {text: text}        # {"T": "int"}
}

# Generic bir tipin bir tip için üretilen kopyası: Kutu[T] → Kutu[int]
type TipOrnegi {
    ad: text                    # "Kutu[int]"
    tipli: parser.Dugum         # alanları tiplenmiş tanım (metotların içi sonra)
    yerine: {text: text}
}

# parallel bölümlerinin kaydı (program bitince "aynı anda aynı değişkene dokunuluyor mu?" diye kontrol edilir)
type ParalelKaydi {
    tur: text                   # "blok" / "tekrar"
    dugum: parser.Dugum         # tipli düğüm
    adlar: [text]               # o noktada görünen değişkenler
    anahtarlar: [text]          # her birinin "ana:X" / "yerel:X" / "alan:X" karşılığı
    sayac: text                 # tekrar ise sayacın adı
    tip_icinde: text            # metodun içindeyse tipin adı
}

# Bir işin etkisi
type Etki {
    okur: [text]
    yazar: [text]
    cagirir: [text]             # "fn:ad" / "metot:Tip.ad"
}

type TipBilgisi {
    ad: text
    satir: int
    alan_adlari: [text]
    alan_tipleri: [text]
    alan_varsayilanli: [bool]
    alan_satirlari: [int]
    metotlar: {text: Fonksiyon}
}

type EnumBilgisi {
    ad: text
    cesitler: [text]
    alan_adlari: [[text]]       # her çeşidin alanlarının adları
    alan_tipleri: [[text]]
}

type Kontroller {
    var_olanlar: [text]     # şart doğruysa kesin var olanlar  (x is not none)
    yok_olanlar: [text]     # şart YANLIŞSA kesin var olanlar  (x is none)
}

enum Sonuc {
    Tamam(agac: parser.Dugum)
    Hata(mesaj: text)
}

# --- Durum ---
global var HATA = ""
global var DESTEK = ""                               # desteklenmeyen bir şey görüldüyse adı
global var FONKSIYONLAR: {text: Fonksiyon} = {}
global var ANA: {text: Degisken} = {}                 # ana programın en dışındaki değişkenler
global var YIGIN: [{text: Degisken}] = []             # iç içe bloklar (fonksiyondaysak en altta fonksiyonun kendisi)
global var FN = ""                                   # "" = ana program; yoksa içinde olduğumuz fonksiyon
global var UST_TANIMLAR: {text: int} = {}
global var KAPANAN: {text: int} = {}                  # bloğu bitmiş değişkenler (iyi hata mesajı için)
global var DONGU = 0
global var WHEN = 0
global var PARALEL = 0                               # kaç parallel bölümünün içindeyiz
global var PARALEL_KAYITLARI: [ParalelKaydi] = []
global var WHEN_IZLENEN: [text] = []                 # when'lerin izlediği değişkenlerin anahtarları
global var BASLATMALAR: [parser.Dugum] = []           # start f(...) yerleri (program bitince güvenlik kontrolü)
global var LAMBDALAR: [LambdaBilgisi] = []             # iç içe tiplenmekte olan lambda'lar
global var GENERIKLER: {text: parser.Dugum} = {}       # generic fonksiyonların tanımları (ad → tanım)
global var TIP_YERINE: {text: text} = {}               # şu an üretilen kopyada tip parametrelerinin karşılığı
global var ORNEKLER: [Ornek] = []                      # üretilecek generic kopyalar
global var GENERIK_TIPLER: {text: parser.Dugum} = {}   # generic tiplerin tanımları
global var TIP_ORNEKLERI: [TipOrnegi] = []             # üretilen generic tip kopyaları
global var HATA_YIGINI: [text] = []                  # try/fail için bağlam: "fn", "do", "parallel", "arena", "when"
global var HATA_IZNI = ""                             # sıradaki ifadenin hatası ele alınıyor mu? ("try" / "else")
global var SON_IZIN = ""                              # _ifade şu an işlediği ifadeye düşen izin
global var HATA_ELE_ALINDI = false                    # hata verebilen bir çağrı izni kullandı mı?
global var C_YAPILARI: {text: [text]} = {}           # extern içindeki C yapıları: alanların C'deki tipleri (i64, i32, i8, double, float)
global var ARENA = 0                                 # kaç arena { } bloğunun içindeyiz
global var OLCUM = 0
global var TIPLER: {text: TipBilgisi} = {}
global var ENUMLAR: {text: EnumBilgisi} = {}
global var AKTIF = Fonksiyon(ad: "", p_adlar: [], p_tipler: [], donus: "void", satir: 0, izinler: [])
global var TIP_ICINDE = ""                           # şu an hangi tipin metodundayız?
global var PENCERE_SATIR = 0
global var EXTERN_TIPLERI = {"int": "i64", "i32": "i32", "float": "double", "bool": "i32", "text": "ptr", "ptr": "ptr", "bytes": "ptr"}

global var TIP_ADLARI = {"int": "int", "integer": "int", "float": "float", "text": "text", "bool": "bool", "ptr": "ptr", "bytes": "bytes"}
global var YERLESIK = ["print", "write", "input", "random", "time", "int", "float", "text", "read_file", "read_lines", "write_file", "append_file", "file_exists", "code", "char", "args", "read_bytes", "write_bytes", "bytes"]
global var IZINLER = {
    "files": "dosyalara dokunuyor",
    "net": "internete bağlanıyor",
    "system": "bilgisayarda program çalıştırıyor ya da sistem bilgisi okuyor",
    "screen": "ekrana pencere ya da grafik çiziyor",
    "sound": "ses çalıyor",
    "time": "saati okuyor ya da bekliyor"
}
# İzinlerin İngilizce açıklamaları (IZINLER ile aynı anahtarlar)
global var IZINLER_EN = {
    "files": "touches files",
    "net": "connects to the internet",
    "system": "runs programs on the computer or reads system information",
    "screen": "draws windows or graphics on the screen",
    "sound": "plays sound",
    "time": "reads the clock or waits"
}
global var METIN_METOTLARI: {text: [[text]]} = {
    "contains": [["text"]], "starts_with": [["text"]], "ends_with": [["text"]],
    "split": [["text"], []], "trim": [[]], "replace": [["text", "text"]],
    "upper": [[], ["text"]], "lower": [[], ["text"]],
    "is_digit": [[]], "is_letter": [[]], "is_space": [[]], "to_bytes": [[]]
}
global var METIN_DONUS = {
    "contains": "bool", "starts_with": "bool", "ends_with": "bool", "split": "[text]", "trim": "text",
    "replace": "text", "upper": "text", "lower": "text", "is_digit": "bool", "is_letter": "bool", "is_space": "bool", "to_bytes": "bytes"
}
global var SOZLUK_METOTLARI = ["get", "has", "remove", "keys", "values"]
global var DOSYA_ARGUMAN: {text: [text]} = {
    "read_file": ["text"], "read_lines": ["text"], "write_file": ["text", "text"],
    "append_file": ["text", "text"], "file_exists": ["text"],
    "read_bytes": ["text"], "write_bytes": ["text", "bytes"]
}
global var DOSYA_DONUS = {"read_file": "text?", "read_lines": "[text]?", "write_file": "bool", "append_file": "bool", "file_exists": "bool", "read_bytes": "bytes?", "write_bytes": "bool"}

# =====================================================================
#  Yardımcılar
# =====================================================================
fn _tamam() -> bool {
    return HATA.length is 0
}

fn _hata(d: parser.Dugum, mesaj: text) {
    use change HATA
    if HATA.length is 0 {
        var yer = ""
        if d.dosya.length > 0 {                     # başka bir dosyadaysa adı
            yer = "{d.dosya}, "
        }
        HATA = dil.sec("{yer}Satır {d.satir}, sütun {d.sutun}: {mesaj}", "{yer}Line {d.satir}, column {d.sutun}: {mesaj}")
    }
}

fn _hata_ham(mesaj: text) {
    use change HATA
    if HATA.length is 0 {
        HATA = mesaj
    }
}

fn _desteklenmiyor(ne: text) {
    use change DESTEK
    use change HATA
    if DESTEK.length is 0 {
        DESTEK = ne
    }
    if HATA.length is 0 {
        HATA = dil.sec("DESTEKLENMIYOR: {ne}", "NOT SUPPORTED: {ne}")
    }
}

# Düğümün türü yazılmış kopyası
fn _t(e: parser.Dugum, tip: text) -> parser.Dugum {
    return parser.Dugum(tur: e.tur, deger: e.deger, ek: e.ek, cocuklar: e.cocuklar, satir: e.satir, sutun: e.sutun, tip: tip, dosya: e.dosya)
}

# Çocukları değiştirilmiş kopyası
fn _c(e: parser.Dugum, cocuklar: [parser.Dugum], tip: text) -> parser.Dugum {
    return parser.Dugum(tur: e.tur, deger: e.deger, ek: e.ek, cocuklar: cocuklar, satir: e.satir, sutun: e.sutun, tip: tip, dosya: e.dosya)
}

fn _liste(cocuklar: [parser.Dugum]) -> parser.Dugum {
    return parser.Dugum(tur: "[]", deger: "", ek: "", cocuklar: cocuklar, satir: 0, sutun: 0)
}

fn _bos_mu(e: parser.Dugum) -> bool {
    return e.tur is "Bos"
}

# Bir modülün (başka dosyanın) içindeki kod, ana dosyanın adlarını göremez.
# Modüllerin kendi adları "modul.ad" diye yeniden adlandırıldığı için: modül kodunda noktasız bir ad
# ana dosyaya aittir ve görünmez. Ana dosya ise her şeyi (noktalı modül adları dahil) görür.
fn _gorunur_ad(ad: text, d: parser.Dugum) -> bool {
    return d.dosya.length is 0 or ad.split(".").length > 1
}

fn _fonksiyon_gorunur(ad: text, d: parser.Dugum) -> bool {
    return FONKSIYONLAR.has(ad) and _gorunur_ad(ad, d)
}

fn _yerlesik_mi(ad: text) -> bool {
    repeat i from 1 to YERLESIK.length {
        if YERLESIK[i] is ad {
            return true
        }
    }
    return false
}

fn _icinde_mi(ad: text, liste: [text]) -> bool {
    repeat i from 1 to liste.length {
        if liste[i] is ad {
            return true
        }
    }
    return false
}

fn _yazdirilabilir(t: text) -> bool {
    return t is "int" or t is "float" or t is "text" or t is "bool"
}

fn secmeli_mi(t: text) -> bool {
    return t.ends_with("?") and t is not "[?]" and t is not "\{?\}"
}

fn sozluk_mu(t: text) -> bool {
    return t.starts_with("\{")
}

fn liste_mi(t: text) -> bool {
    return t.starts_with("[")
}

fn sayisal_mi(t: text) -> bool {
    return t is "int" or t is "float"
}

fn _ic(t: text) -> text {                            # "[int]" → "int"
    if t.length < 2 {
        return "?"
    }
    return t[2 to t.length - 1]
}

fn _soru_siz(t: text) -> text {                      # "Ogrenci?" → "Ogrenci"
    if t.length < 1 {
        return "?"
    }
    return t[1 to t.length - 1]
}

fn _iki_nokta(t: text) -> int {
    repeat i from 1 to t.length {
        if t[i] is ":" {
            return i
        }
    }
    return 0
}

fn _sozluk_anahtar(t: text) -> text {                # "{text:[int]}" → "text"
    var i = _iki_nokta(t)
    if i < 3 {
        return "?"
    }
    return t[2 to i - 1]
}

fn _sozluk_deger(t: text) -> text {                  # "{text:[int]}" → "[int]"
    var i = _iki_nokta(t)
    if i is 0 or i >= t.length {
        return "?"
    }
    return t[i + 1 to t.length - 1]
}

fn tip_aciklama(tip: text) -> text {
    if tip is "int" { return dil.sec("int (tam sayı)", "int (integer)") }
    if tip is "float" { return dil.sec("float (ondalık sayı)", "float (decimal number)") }
    if tip is "text" { return dil.sec("text (metin)", "text") }
    if tip is "bool" { return dil.sec("bool (doğru/yanlış)", "bool (true/false)") }
    if tip is "bytes" { return dil.sec("bytes (bayt dizisi)", "bytes (byte array)") }
    if fn_mi(tip) { return dil.sec("{tip} (fonksiyon)", "{tip} (function)") }
    if tip is "task[void]" { return dil.sec("task[] (değer döndürmeyen arka plan işi)", "task[] (background task that returns no value)") }
    if tip.starts_with("task[") { return dil.sec("{tip} (arka plan işi; sonucu .wait() ile alınır)", "{tip} (background task; get its result with .wait())") }
    if tip.starts_with("channel[") { return dil.sec("{tip} (kanal: işler arasında mesajlaşma)", "{tip} (channel: passing messages between tasks)") }
    if tip is "void" { return dil.sec("hiçbir değer", "no value") }
    if tip is "[?]" { return dil.sec("boş liste", "empty list") }
    if tip is "\{?\}" { return dil.sec("boş sözlük", "empty dictionary") }
    if tip is "none" { return dil.sec("none (yok)", "none (no value)") }
    if secmeli_mi(tip) { return dil.sec("{tip} (yok olabilir; önce 'if x is not none' ile kontrol et)", "{tip} (may be none; check it first with 'if x is not none')") }
    if liste_mi(tip) { return dil.sec("{tip.replace("task[void]", "task[]")} (liste)", "{tip.replace("task[void]", "task[]")} (list)") }
    if sozluk_mu(tip) { return dil.sec("{tip.replace("task[void]", "task[]")} (sözlük)", "{tip.replace("task[void]", "task[]")} (dictionary)") }
    return tip
}

fn uyumlu_mu(beklenen: text, gelen: text) -> bool {
    if beklenen is gelen { return true }
    if beklenen is "ptr" and gelen is "none" { return true }
    if secmeli_mi(beklenen) {
        return gelen is "none" or uyumlu_mu(_soru_siz(beklenen), gelen)
    }
    if beklenen is "float" and gelen is "int" { return true }
    if gelen is "[?]" and liste_mi(beklenen) { return true }
    if gelen is "\{?\}" and sozluk_mu(beklenen) { return true }
    return false
}

# "9223372036854775808" bir int'e sığar mı? (rakamları karşılaştırarak)
fn _cok_buyuk_mu(s: text) -> bool {
    var r = s
    repeat while r.length > 1 and r[1] is "0" {
        r = r[2 to r.length]
    }
    var en_buyuk = "9223372036854775807"
    if r.length is not en_buyuk.length {
        return r.length > en_buyuk.length
    }
    repeat i from 1 to r.length {
        if r[i] is not en_buyuk[i] {
            return code(r[i]) > code(en_buyuk[i])
        }
    }
    return false
}

fn _sifirsiz(s: text) -> text {
    var r = s
    repeat while r.length > 1 and r[1] is "0" {
        r = r[2 to r.length]
    }
    return r
}

# Kum havuzu: sadece izin verilenler kullanılabilir, kullanıcının dosyalarında C kodu (extern) olamaz
global var KUM = false
global var IZIN_SINIRI: [text] = []
global var STD_DOSYALARI: [text] = []

fn kum_ayarla(izinler: [text], std_dosyalari: [text]) {
    use change KUM
    use change IZIN_SINIRI
    use change STD_DOSYALARI
    KUM = true
    IZIN_SINIRI = izinler
    STD_DOSYALARI = std_dosyalari
}

fn _kum_izin_listesi() -> text {
    use IZIN_SINIRI
    if IZIN_SINIRI.length is 0 {
        return dil.sec("hiçbiri", "none")
    }
    return IZIN_SINIRI.join(", ")
}

# Kum havuzunda bu izin kullanılamıyorsa hata ver
fn _kum_izin_denetle(e: parser.Dugum, izin: text) {
    use KUM
    use IZIN_SINIRI
    if not KUM or _icinde_mi(izin, IZIN_SINIRI) {
        return
    }
    _hata(e, dil.sec("Kum havuzu: bu program '{izin}' iznini istiyor ({IZINLER[izin]}), ama bu izin verilmedi.\n   Verilen izinler: {_kum_izin_listesi()}", "Sandbox: this program needs the '{izin}' permission ({IZINLER_EN[izin]}), but it was not granted.\n   Granted permissions: {_kum_izin_listesi()}"))
}

fn _std_dosyasi_mi(dosya: text) -> bool {
    use STD_DOSYALARI
    return dosya.length > 0 and _icinde_mi(dosya, STD_DOSYALARI)
}

# Bir fonksiyonun gövdesindeki 'use files' gibi izinleri topla (iç bloklar dahil)
fn _izinleri_topla(d: parser.Dugum, izinler: [text]) -> [text] {
    var sonuc = izinler
    if d.tur is "UseKomutu" and IZINLER.has(d.deger) and not _icinde_mi(d.deger, sonuc) {
        if not _std_dosyasi_mi(d.dosya) {
            _kum_izin_denetle(d, d.deger)
        }
        sonuc.add(d.deger)
    }
    repeat i from 1 to d.cocuklar.length {
        sonuc = _izinleri_topla(d.cocuklar[i], sonuc)
    }
    return sonuc
}

# Bu komutlar her yolda bir 'return'e ulaşıyor mu?
fn her_zaman_doner_mu(komutlar: [parser.Dugum]) -> bool {
    repeat i from 1 to komutlar.length {
        var k = komutlar[i]
        if k.tur is "Donus" or k.tur is "HataVer" {
            return true
        }
        if k.tur is "Yakala" and her_zaman_doner_mu(k.cocuklar[1].cocuklar) and her_zaman_doner_mu(k.cocuklar[2].cocuklar) {
            return true
        }
        if k.tur is "Eger" and k.cocuklar[3].tur is "[]" {
            if her_zaman_doner_mu(k.cocuklar[2].cocuklar) and her_zaman_doner_mu(k.cocuklar[3].cocuklar) {
                return true
            }
        }
        if k.tur is "MatchKomutu" {                     # bütün durumları dönüyorsa
            var hepsi = true
            var durumlar = k.cocuklar[2].cocuklar
            repeat j from 1 to durumlar.length {
                if not her_zaman_doner_mu(durumlar[j].cocuklar[1].cocuklar) {
                    hepsi = false
                }
            }
            var dg = k.cocuklar[3]
            if hepsi and (dg.tur is "Bos" or her_zaman_doner_mu(dg.cocuklar)) {
                return true
            }
        }
    }
    return false
}

# =====================================================================
#  KAPSAMLAR: hangi değişken nerede görülür?
# =====================================================================
fn _ara(ad: text) -> Degisken? {
    repeat i from YIGIN.length to 1 step -1 {
        var m = YIGIN[i]
        if m.has(ad) {
            return m[ad]
        }
    }
    if FN.length is 0 and ANA.has(ad) {
        return ANA[ad]
    }
    return none
}

# Şu anki kapsama koy (yoksa ekler, varsa değiştirir)
fn _koy(d: Degisken) {
    use change ANA
    use change YIGIN
    if YIGIN.length is 0 {
        ANA[d.ad] = d
    } else {
        var m = YIGIN[YIGIN.length]
        m[d.ad] = d
        YIGIN[YIGIN.length] = m
    }
}

# Değişkeni bulunduğu kapsamda güncelle
fn _guncelle(d: Degisken) {
    use change ANA
    use change YIGIN
    repeat i from YIGIN.length to 1 step -1 {
        var m = YIGIN[i]
        if m.has(d.ad) {
            m[d.ad] = d
            YIGIN[i] = m
            return
        }
    }
    if ANA.has(d.ad) {
        ANA[d.ad] = d
    }
}

fn _yok_degisken(ad: text) -> Degisken {
    return Degisken(ad: ad, tip: "?", tur: "yok", satir: 0)
}

fn bul(ad: text, dugum: parser.Dugum) -> Degisken {
    var d = _ara(ad)
    if d is not none {
        if LAMBDALAR.length > 0 and d.tur is not "global" {
            _yakala(ad, d.tip, _seviye(ad))
        }
        return d
    }
    if TIP_ICINDE.length > 0 {                       # metodun içinde: tipin alanları değişken gibi görünür
        var b = TIPLER[TIP_ICINDE]
        repeat i from 1 to b.alan_adlari.length {
            if b.alan_adlari[i] is ad {
                var tur = "alan-okur"
                if AKTIF.degistirir {
                    tur = "alan"
                }
                if LAMBDALAR.length > 0 {               # lambda bir alanı kullanıyor: değeri kopyalanır
                    _yakala(ad, b.alan_tipleri[i], -1)
                }
                return Degisken(ad: ad, tip: b.alan_tipleri[i], tur: tur, satir: b.alan_satirlari[i])
            }
        }
    }
    if KAPANAN.has(ad) {
        _hata(dugum, dil.sec("'{ad}' satır {KAPANAN[ad]}'deki bir bloğun içinde oluşturulmuştu; sadece o bloğun içinde geçerli.\n   Blok dışında da kullanmak istiyorsan, onu bloktan önce oluştur.", "'{ad}' was created inside a block on line {KAPANAN[ad]}; it only exists inside that block.\n   If you want to use it outside the block too, create it before the block."))
        return _yok_degisken(ad)
    }
    if FN.length > 0 {
        if ANA.has(ad) and ANA[ad].tur is "global" {
            return ANA[ad]
        }
        if ANA.has(ad) or UST_TANIMLAR.has(ad) {
            _hata(dugum, dil.sec("'{ad}' fonksiyonun dışında oluşturulmuş. Fonksiyonlar dışarıyı göremez.\n   Kullanmak için fonksiyonun içinde şunu yaz:   use {ad}", "'{ad}' was created outside the function. Functions can't see outside.\n   To use it, write this inside the function:   use {ad}"))
            return _yok_degisken(ad)
        }
    } else if UST_TANIMLAR.has(ad) {
        _hata(dugum, dil.sec("'{ad}' henüz oluşturulmadı. Satır {UST_TANIMLAR[ad]}'de oluşturuluyor;\n   kullanmadan önce oluşturmalısın.", "'{ad}' hasn't been created yet. It is created on line {UST_TANIMLAR[ad]};\n   you must create it before using it."))
        return _yok_degisken(ad)
    }
    if _fonksiyon_gorunur(ad, dugum) or _yerlesik_mi(ad) {
        _hata(dugum, dil.sec("'{ad}' bir fonksiyon. Çağırmak için parantez kullan:   {ad}(...)", "'{ad}' is a function. Use parentheses to call it:   {ad}(...)"))
        return _yok_degisken(ad)
    }
    var adaylar: [text] = []
    repeat i from YIGIN.length to 1 step -1 {
        var anahtarlar = YIGIN[i].keys()
        repeat j from 1 to anahtarlar.length {
            adaylar.add(anahtarlar[j])
        }
    }
    var ana_adlar = ANA.keys()
    repeat j from 1 to ana_adlar.length {
        if FN.length is 0 or ANA[ana_adlar[j]].tur is "global" {
            adaylar.add(ana_adlar[j])
        }
    }
    _hata(dugum, dil.sec("'{ad}' diye bir değişken yok.{oneri.oneri(ad, adaylar)}", "There is no variable called '{ad}'.{oneri.oneri(ad, adaylar)}"))
    return _yok_degisken(ad)
}

fn degistirilebilir_olmali(ad: text, dugum: parser.Dugum) -> Degisken {
    var d = bul(ad, dugum)
    if not _tamam() {
        return d
    }
    if LAMBDALAR.length > 0 and d.tur is not "global" and _seviye(ad) < LAMBDALAR[LAMBDALAR.length].taban {
        _hata(dugum, dil.sec("Lambda dışarıdaki '{ad}' değişkenini değiştiremez; lambda dışarıdaki değerlerin kopyasıyla çalışır.\n   Sonucu döndür ve dışarıda ata:   {ad} = f(...)", "A lambda can't change the outside variable '{ad}'; a lambda works with copies of outside values.\n   Return the result and assign it outside:   {ad} = f(...)"))
        return d
    }
    if FN.length > 0 and d.tur is "global" {
        _hata(dugum, dil.sec("'{ad}' bir global değişken; fonksiyonlar onu sadece okuyabilir.\n   Değiştirmek için fonksiyonun içinde şunu yaz:   use change {ad}", "'{ad}' is a global variable; functions can only read it.\n   To change it, write this inside the function:   use change {ad}"))
    } else if d.tur is "dis-okur" {
        _hata(dugum, dil.sec("'{ad}' 'use' ile çağrıldığı için sadece okunabilir.\n   Değiştirmek için şöyle çağır:   use change {ad}", "'{ad}' was brought in with 'use', so it can only be read.\n   To change it, bring it in like this:   use change {ad}"))
    } else if d.tur is "sayac" {
        _hata(dugum, dil.sec("'{ad}' bir döngü sayacı; döngünün içinde değiştirilemez, sadece okunabilir.\n   Farklı adımlarla saymak istiyorsan 'step' kullan:   repeat {ad} from 1 to 10 step 2", "'{ad}' is a loop counter; it can't be changed inside the loop, only read.\n   If you want to count in different steps, use 'step':   repeat {ad} from 1 to 10 step 2"))
    } else if d.tur is "eslesme" {
        _hata(dugum, dil.sec("'{ad}' match'te bir alana verilen ad; sadece okunabilir.\n   Değiştirilmiş bir değer istiyorsan yeni bir değişken oluştur:   var yeni_{ad} = {ad} ...", "'{ad}' is a name given to a field in match; it can only be read.\n   If you want a changed value, create a new variable:   var new_{ad} = {ad} ..."))
    } else if d.tur is "satir" {
        _hata(dugum, dil.sec("'{ad}' listenin bir satırını gösteriyor; buradan değiştirilemez, sadece okunabilir.\n   Listeyi değiştirmek için listenin kendisini kullan (ör: liste[i] = ..., liste.remove(i)).", "'{ad}' points to one row of the list; it can't be changed from here, only read.\n   To change the list, use the list itself (e.g. list[i] = ..., list.remove(i))."))
    } else if d.tur is "alan-okur" {
        _hata(dugum, dil.sec("'{AKTIF.ad}' metodu nesneyi değiştirmeyen bir metot; '{ad}' alanını değiştiremez.\n   Değiştirmesi gerekiyorsa şöyle işaretle:   fn change {AKTIF.ad}(...)", "'{AKTIF.ad}' is a method that doesn't change the object; it can't change the '{ad}' field.\n   If it needs to change it, mark it like this:   fn change {AKTIF.ad}(...)"))
    }
    return d
}

# Değiştirilecek yer: bir değişken ya da onun içindeki bir eleman/alan (a, a[i], a.b, a[i].b[j] ...)
# Kökteki değişken değiştirilebilir olmalı; dönen Degisken'in tipi yolun sonundaki değerin tipidir.
fn _yol_degiskeni(nesne: parser.Dugum, ne: text) -> Degisken {
    if nesne.tur is "Isim" {
        return degistirilebilir_olmali(nesne.deger, nesne)
    }
    var kok = nesne
    repeat while kok.tur is "Erisim" or kok.tur is "Ozellik" {
        if kok.tur is "Erisim" and kok.cocuklar[2].tur is "Aralik" {
            _hata(kok, dil.sec("{ne}: parça (a to b) yeni bir değer üretir; onun içi değiştirilemez.\n   Önce bir değişkene al:   var parca = ...", "{ne}: a slice (a to b) makes a new value; its contents can't be changed.\n   Put it in a variable first:   var part = ..."))
            return _yok_degisken("")
        }
        kok = kok.cocuklar[1]
    }
    if kok.tur is not "Isim" {
        _hata(nesne, dil.sec("{ne} bir değişkenin ya da onun içindeki bir elemanın/alanın üzerinde yapılabilir; burada geçici bir değer var.\n   Önce bir değişkene al:   var x = ...", "{ne} can only be done on a variable or on an element/field inside it; here there is a temporary value.\n   Put it in a variable first:   var x = ..."))
        return _yok_degisken("")
    }
    var d = degistirilebilir_olmali(kok.deger, kok)
    if not _tamam() {
        return d
    }
    var t = _ifade(nesne, "")
    if not _tamam() {
        return d
    }
    var y = d
    y.tip = t.tip
    y.asil = ""
    return y
}

fn liste_degiskeni_olmali(nesne: parser.Dugum, ne: text) -> Degisken {
    var d = _yol_degiskeni(nesne, ne)
    if not _tamam() {
        return d
    }
    if d.tip is "text" {
        _hata(nesne, dil.sec("Metinler değiştirilemez; harfini değiştirmek yerine yeni bir metin oluştur.\n   Örneğin:   {nesne.deger} = {nesne.deger}.replace(\"eski\", \"yeni\")", "Text can't be changed; instead of changing a letter, create a new text.\n   For example:   {nesne.deger} = {nesne.deger}.replace(\"old\", \"new\")"))
    } else if not liste_mi(d.tip) and d.tip is not "bytes" {
        _hata(nesne, dil.sec("'{nesne.deger}' bir liste değil, {tip_aciklama(d.tip)}.", "'{nesne.deger}' is not a list, it is {tip_aciklama(d.tip)}."))
    }
    return d
}

fn sozluk_degiskeni_olmali(nesne: parser.Dugum, ne: text) -> Degisken {
    return _yol_degiskeni(nesne, ne)
}

# x'in kontrolden sonraki hâli: aynı değişken, ama tipi 'T?' yerine 'T'
fn _daraltilmis(ad: text, dugum: parser.Dugum) -> Degisken {
    var d = bul(ad, dugum)
    var asil_tip = d.tip
    if d.asil.length > 0 {
        asil_tip = d.asil
    }
    var tip = asil_tip
    if secmeli_mi(asil_tip) {
        tip = _soru_siz(asil_tip)
    }
    return Degisken(ad: ad, tip: tip, tur: d.tur, satir: d.satir, asil: asil_tip, derinlik: DONGU)
}

# Yeni bir iç kapsam aç, komutları kontrol et, kapsamı kapat
fn _blok(komutlar: [parser.Dugum], ilk: Degisken?, daralt: [text]) -> [parser.Dugum] {
    use change YIGIN
    use change KAPANAN
    var golgeler: [Degisken] = []
    repeat i from 1 to daralt.length {
        var yer = parser.Dugum(tur: "Bos", deger: "", ek: "", cocuklar: [], satir: 0, sutun: 0)
        if komutlar.length > 0 {
            yer = komutlar[1]
        }
        golgeler.add(_daraltilmis(daralt[i], yer))
    }
    YIGIN.add({})
    if ilk is not none {
        _koy(ilk)
    }
    repeat i from 1 to golgeler.length {
        _koy(golgeler[i])
    }
    var sonuc: [parser.Dugum] = []
    repeat i from 1 to komutlar.length {
        sonuc.add(_komut(komutlar[i]))
        if not _tamam() {
            stop
        }
    }
    var son = YIGIN[YIGIN.length]
    var adlar = son.keys()
    repeat i from 1 to adlar.length {
        if not _icinde_mi(adlar[i], daralt) {
            KAPANAN[adlar[i]] = son[adlar[i]].satir
        }
    }
    YIGIN.remove(YIGIN.length)
    return sonuc
}

fn _dongu(komutlar: [parser.Dugum], ilk: Degisken?, daralt: [text]) -> [parser.Dugum] {
    use change DONGU
    DONGU = DONGU + 1
    var sonuc = _blok(komutlar, ilk, daralt)
    DONGU = DONGU - 1
    return sonuc
}

# Şarttan 'x is not none' / 'x is none' kontrollerini çıkar
fn _none_kontrolleri(kosul: parser.Dugum) -> Kontroller {
    var bos: [text] = []
    if kosul.tur is "IkiliIslem" and kosul.deger is "and" {
        var a = _none_kontrolleri(kosul.cocuklar[1])
        var b = _none_kontrolleri(kosul.cocuklar[2])
        var hepsi = a.var_olanlar
        repeat i from 1 to b.var_olanlar.length {
            hepsi.add(b.var_olanlar[i])
        }
        return Kontroller(var_olanlar: hepsi, yok_olanlar: bos)
    }
    if kosul.tur is "IkiliIslem" and (kosul.deger is "is" or kosul.deger is "is not") {
        var sol = kosul.cocuklar[1]
        var sag = kosul.cocuklar[2]
        if sol.tur is "Yok" or sag.tur is "Yok" {
            var isim = sag
            var var_mi = false
            if sol.tur is "Isim" {
                isim = sol
                var_mi = true
            } else if sag.tur is "Isim" {
                var_mi = true
            }
            if var_mi and secmeli_mi(isim.tip) {
                if kosul.deger is "is not" {
                    return Kontroller(var_olanlar: [isim.deger], yok_olanlar: bos)
                }
                return Kontroller(var_olanlar: bos, yok_olanlar: [isim.deger])
            }
        }
    }
    return Kontroller(var_olanlar: bos, yok_olanlar: bos)
}

fn _sart_olmali(kosul: parser.Dugum, kelime: text) -> parser.Dugum {
    var e = _ifade(kosul, "")
    if _tamam() and e.tip is not "bool" {
        var ornek = "x is not \"\""
        if sayisal_mi(e.tip) {
            ornek = "x is not 0"
        }
        _hata(kosul, dil.sec("'{kelime}' bir doğru/yanlış (bool) sorusu bekler, burada {tip_aciklama(e.tip)} var.\n   Ne sorduğunu açıkça yaz, örneğin:   {kelime} {ornek} \{ \}", "'{kelime}' expects a true/false (bool) question, but here there is {tip_aciklama(e.tip)}.\n   Write clearly what you are asking, for example:   {kelime} {ornek} \{ \}"))
    }
    return e
}

# =====================================================================
#  TİPLER: ağaçtaki tip düğümünü tip adına çevir
# =====================================================================
fn tip_coz(t: parser.Dugum) -> text {
    if t.tur is "ListeTipi" {
        return "[{tip_coz(t.cocuklar[1])}]"
    }
    if t.tur is "FnTipi" {                           # fn(int, int) -> bool
        var ps: [text] = []
        var pt = t.cocuklar[1].cocuklar
        repeat i from 1 to pt.length {
            ps.add(tip_coz(pt[i]))
        }
        var dt = "void"
        if not _bos_mu(t.cocuklar[2]) {
            dt = tip_coz(t.cocuklar[2])
        }
        return "fn({ps.join(",")})->{dt}"
    }
    if t.tur is "IsTipi" {
        if t.cocuklar.length is 0 {
            return "task[void]"                      # task[]: değer döndürmeyen iş
        }
        return "task[{tip_coz(t.cocuklar[1])}]"
    }
    if t.tur is "KanalTipi" {
        return "channel[{tip_coz(t.cocuklar[1])}]"
    }
    if t.tur is "SecmeliTip" {
        var ic = tip_coz(t.cocuklar[1])
        if ic is "int" or ic is "float" or ic is "bool" {
            _hata(t, dil.sec("'{ic}?' henüz yok: yok olabilen değer şimdilik metin, liste, sözlük, kendi tipler ve enum'lar için var.\n   Sayılar için bir enum ya da özel bir değer (ör: -1) kullan.", "'{ic}?' doesn't exist yet: values that may be none are currently only for text, lists, dictionaries, your own types and enums.\n   For numbers, use an enum or a special value (e.g. -1)."))
            return "?"
        }
        if secmeli_mi(ic) {
            _hata(t, dil.sec("'{ic}?' iki kere '?' olamaz.", "'{ic}?' can't have '?' twice."))
            return "?"
        }
        return "{ic}?"
    }
    if t.tur is "SozlukTipi" {
        var anahtar = tip_coz(t.cocuklar[1])
        if anahtar is not "text" and anahtar is not "int" {
            _hata(t, dil.sec("Sözlüğün anahtarı şimdilik text ya da int olabilir, {tip_aciklama(anahtar)} olamaz.", "A dictionary key can currently be text or int, not {tip_aciklama(anahtar)}."))
            return "?"
        }
        return "\{{anahtar}:{tip_coz(t.cocuklar[2])}\}"
    }
    if TIP_YERINE.has(t.deger) {                     # generic kopyada T → int
        return TIP_YERINE[t.deger]
    }
    if t.tur is "GenerikTip" {                       # Kutu[int]
        if not GENERIK_TIPLER.has(t.deger) {
            _hata(t, dil.sec("'{t.deger}' generic bir tip değil; köşeli parantezle içi yazılmaz.", "'{t.deger}' is not a generic type; it isn't written with square brackets."))
            return "?"
        }
        var argumanlar: [text] = []
        repeat i from 1 to t.cocuklar.length {
            argumanlar.add(tip_coz(t.cocuklar[i]))
            if not _tamam() {
                return "?"
            }
        }
        var tp = GENERIK_TIPLER[t.deger].cocuklar[3].cocuklar
        if argumanlar.length is not tp.length {
            _hata(t, dil.sec("'{t.deger}' {tp.length} tip bekliyor, {argumanlar.length} verildi.", "'{t.deger}' expects {tp.length} types, but {argumanlar.length} were given."))
            return "?"
        }
        return _generik_tip_ornegi(t.deger, argumanlar)
    }
    if GENERIK_TIPLER.has(t.deger) {
        var tp2 = GENERIK_TIPLER[t.deger].cocuklar[3].cocuklar
        var ornek: [text] = []
        repeat i from 1 to tp2.length {
            ornek.add("int")
        }
        _hata(t, dil.sec("'{t.deger}' generic bir tip; içindekinin tipini de yaz:   {t.deger}[{ornek.join(", ")}]", "'{t.deger}' is a generic type; also write the type of what it holds:   {t.deger}[{ornek.join(", ")}]"))
        return "?"
    }
    if TIPLER.has(t.deger) or ENUMLAR.has(t.deger) {
        return t.deger                               # kendi tipin: Ogrenci / enum: Odeme
    }
    if not TIP_ADLARI.has(t.deger) {
        var adaylar = TIP_ADLARI.keys()
        var tip_adlari = TIPLER.keys()
        repeat i from 1 to tip_adlari.length {
            adaylar.add(tip_adlari[i])
        }
        _hata(t, dil.sec("'{t.deger}' diye bir tip yok.{oneri.oneri(t.deger, adaylar)}", "There is no type called '{t.deger}'.{oneri.oneri(t.deger, adaylar)}"))
        return "?"
    }
    return TIP_ADLARI[t.deger]
}

# =====================================================================
#  KOMUTLAR
# =====================================================================
fn _komut(k: parser.Dugum) -> parser.Dugum {
    if not _tamam() {
        return k
    }
    var tur = k.tur
    if tur is "DegiskenTanimi" { return _degisken_tanimi(k) }
    if tur is "Atama" { return _atama(k) }
    if tur is "UseKomutu" { return _use_komutu(k) }
    if tur is "FonksiyonTanimi" {
        _hata(k, dil.sec("Fonksiyon içinde fonksiyon tanımlanamaz. Onu en dışarıya taşı.", "A function can't be defined inside a function. Move it to the outermost level."))
        return k
    }
    if tur is "TipTanimi" {
        _hata(k, dil.sec("'type' sadece en dışarıda (fonksiyonların ve blokların dışında) yazılabilir.", "'type' can only be written at the outermost level (outside functions and blocks)."))
        return k
    }
    if tur is "ExternBlok" {
        _hata(k, dil.sec("'extern' sadece en dışarıda (fonksiyonların ve blokların dışında) yazılabilir.", "'extern' can only be written at the outermost level (outside functions and blocks)."))
        return k
    }
    if tur is "EnumTanimi" {
        _hata(k, dil.sec("'enum' sadece en dışarıda (fonksiyonların ve blokların dışında) yazılabilir.", "'enum' can only be written at the outermost level (outside functions and blocks)."))
        return k
    }
    if tur is "ImportKomutu" {
        _desteklenmiyor(tur)
        return k
    }
    if tur is "MatchKomutu" { return _match_komutu(k) }
    if tur is "AlanAtama" { return _alan_atama(k) }
    if tur is "WhenKomutu" { return _when_komutu(k) }
    if tur is "ArenaBlok" { return _arena_blok(k) }
    if tur is "ParalelBlok" { return _paralel_blok(k) }
    if tur is "ParalelTekrar" { return _paralel_tekrar(k) }
    if tur is "Pencere" { return _pencere(k) }
    if tur is "Donus" { return _donus(k) }
    if tur is "HataVer" { return _hata_ver_komutu(k) }
    if tur is "Yakala" { return _yakala_komutu(k) }
    if tur is "ElemanAtama" { return _eleman_atama(k) }
    if tur is "IfadeKomutu" {
        var e = _ifade(k.cocuklar[1], "")
        if _tamam() and e.tur is not "Cagri" and e.tur is not "MetotCagrisi" and e.tur is not "Dene" and e.tur is not "DegerCagrisi" {
            _hata(k, dil.sec("Bu satır bir şey yapmıyor: hesaplanan değer hiçbir yere konmuyor.\n   Saklamak istiyorsan:   var sonuc = ...      Yazdırmak istiyorsan:   print(...)", "This line doesn't do anything: the computed value isn't stored anywhere.\n   To keep it:   var result = ...      To print it:   print(...)"))
        }
        return _c(k, [e], "")
    }
    if tur is "Eger" { return _eger(k) }
    if tur is "TekrarSayi" {
        var sayi = _ifade(k.cocuklar[1], "")
        if _tamam() and sayi.tip is not "int" {
            _hata(k.cocuklar[1], dil.sec("'repeat' kaç kere tekrar edeceğini bir tam sayı (int) olarak ister, burada {tip_aciklama(sayi.tip)} var.", "'repeat' needs the number of times to repeat as an integer (int), but here there is {tip_aciklama(sayi.tip)}."))
            return k
        }
        var govde = _dongu(k.cocuklar[2].cocuklar, none, [])
        return _c(k, [sayi, _liste(govde)], "")
    }
    if tur is "TekrarSurece" {
        var kosul = _sart_olmali(k.cocuklar[1], "repeat while")
        var kontrol = _none_kontrolleri(kosul)
        var govde = _dongu(k.cocuklar[2].cocuklar, none, kontrol.var_olanlar)
        return _c(k, [kosul, _liste(govde)], "")
    }
    if tur is "TekrarSayac" { return _tekrar_sayac(k) }
    if tur is "Dur" or tur is "Atla" {
        var kelime = "stop"
        if tur is "Atla" {
            kelime = "skip"
        }
        if DONGU is 0 and PARALEL > 0 {
            _hata(k, dil.sec("'{kelime}' bir parallel bölümünün içinden dışarıdaki döngüyü etkileyemez (işler aynı anda çalışıyor).", "'{kelime}' inside a parallel section can't affect the loop outside it (the tasks run at the same time)."))
        } else if DONGU is 0 and ARENA > 0 {
            _hata(k, dil.sec("'{kelime}' bir arena bloğunun içinden dışarıdaki döngüyü etkileyemez.\n   (arena bloğu bitince içindeki geçici her şey silinir; önce bloğun bitmesi gerekir.)", "'{kelime}' inside an arena block can't affect the loop outside it.\n   (When the arena block ends, every temporary thing in it is deleted; the block has to finish first.)"))
        } else if DONGU is 0 and WHEN > 0 {
            _hata(k, dil.sec("'{kelime}' bir when bloğunun içinden dışarıdaki döngüyü etkileyemez.\n   (when, değişkenin değiştiği her yerde çalışabilir; o anda bir döngüde olmayabilir.)", "'{kelime}' inside a when block can't affect the loop outside it.\n   (when can run anywhere the variable changes; at that moment it may not be inside a loop.)"))
        } else if DONGU is 0 {
            _hata(k, dil.sec("'{kelime}' sadece bir 'repeat' döngüsünün içinde kullanılabilir.", "'{kelime}' can only be used inside a 'repeat' loop."))
        }
        return k
    }
    return k
}

fn _degisken_tanimi(k: parser.Dugum) -> parser.Dugum {
    var global_mi = k.ek is "global"
    var ad = k.deger
    if global_mi and FN.length > 0 {
        _hata(k, dil.sec("'global var' sadece fonksiyonların dışında yazılabilir.", "'global var' can only be written outside functions."))
        return k
    }
    var onceki = _ara(ad)
    if onceki is not none {
        _hata(k, dil.sec("'{ad}' zaten oluşturulmuş (satır {onceki.satir}).\n   Değerini değiştirmek istiyorsan 'var' yazmadan:   {ad} = ...", "'{ad}' has already been created (line {onceki.satir}).\n   If you want to change its value, leave out 'var':   {ad} = ..."))
        return k
    }
    if _fonksiyon_gorunur(ad, k) or _yerlesik_mi(ad) {
        _hata(k, dil.sec("'{ad}' bir fonksiyonun adı, değişkene aynı ad verilemez.", "'{ad}' is the name of a function; a variable can't have the same name."))
        return k
    }
    if TIPLER.has(ad) and _gorunur_ad(ad, k) {
        _hata(k, dil.sec("'{ad}' bir tipin adı, değişkene aynı ad verilemez.", "'{ad}' is the name of a type; a variable can't have the same name."))
        return k
    }
    if TIP_ICINDE.length > 0 and _icinde_mi(ad, TIPLER[TIP_ICINDE].alan_adlari) {
        _hata(k, dil.sec("'{ad}' bu tipin bir alanı; metodun içinde aynı adla değişken oluşturulamaz.", "'{ad}' is a field of this type; a variable with the same name can't be created inside the method."))
        return k
    }
    var beklenen = ""
    if not _bos_mu(k.cocuklar[1]) {
        beklenen = tip_coz(k.cocuklar[1])
        if not _tamam() {
            return k
        }
    }
    var deger = _ifade(k.cocuklar[2], beklenen)
    if not _tamam() {
        return k
    }
    var gelen = deger.tip
    if gelen is "void" {
        _hata(k.cocuklar[2], dil.sec("Bu fonksiyon bir değer döndürmüyor, değişkene konacak bir şey yok.", "This function doesn't return a value, so there is nothing to put in the variable."))
        return k
    }
    var tip = gelen
    if beklenen.length > 0 {
        if not uyumlu_mu(beklenen, gelen) {
            _hata(k.cocuklar[2], dil.sec("'{ad}' bir {tip_aciklama(beklenen)} olarak tanımlandı, ama değeri {tip_aciklama(gelen)}.", "'{ad}' was declared as {tip_aciklama(beklenen)}, but its value is {tip_aciklama(gelen)}."))
            return k
        }
        tip = beklenen
    } else {
        if gelen is "none" {
            _hata(k, dil.sec("'none' ile başlayan değişkenin tipi tahmin edilemez. Tipini yaz:\n   var {ad}: Ogrenci? = none", "The type of a variable that starts as 'none' can't be guessed. Write its type:\n   var {ad}: Student? = none"))
            return k
        }
        if gelen is "\{?\}" {
            _hata(k, dil.sec("Boş sözlüğün içine ne konacağı tahmin edilemez. Tipini yaz:\n   var {ad}: \{text: int\} = \{\}", "It can't be guessed what goes into an empty dictionary. Write its type:\n   var {ad}: \{text: int\} = \{\}"))
            return k
        }
        if gelen is "[?]" {
            _hata(k, dil.sec("Boş listenin içine ne konacağı tahmin edilemez. Tipini yaz:\n   var {ad}: [int] = []", "It can't be guessed what goes into an empty list. Write its type:\n   var {ad}: [int] = []"))
            return k
        }
    }
    var tur = "ana"
    if global_mi {
        tur = "global"
    } else if FN.length > 0 {
        tur = "yerel"
    }
    if global_mi and YIGIN.length > 0 {
        _hata(k, dil.sec("'global var' bir bloğun içinde yazılamaz, en dışarıda olmalı.", "'global var' can't be written inside a block; it must be at the outermost level."))
        return k
    }
    _koy(Degisken(ad: ad, tip: tip, tur: tur, satir: k.satir))
    return _c(k, [k.cocuklar[1], deger], tip)
}

fn _atama(k: parser.Dugum) -> parser.Dugum {
    var ad = k.deger
    var d = degistirilebilir_olmali(ad, k)
    if not _tamam() {
        return k
    }
    var asil_tip = d.tip
    if d.asil.length > 0 {
        asil_tip = d.asil
    }
    var deger = _ifade(k.cocuklar[1], asil_tip)
    if not _tamam() {
        return k
    }
    var gelen = deger.tip
    var hedef = d.tip
    if d.asil.length > 0 and not uyumlu_mu(d.tip, gelen) {
        # x kontrol edilmişti ama yeniden none olabilecek bir değer alıyor
        if DONGU > d.derinlik {
            _hata(k, dil.sec("'{ad}' bu döngünün dışında kontrol edildi; döngünün içinde yeniden none olabilir.\n   Kontrolü döngünün içine al:   repeat while {ad} is not none \{ ... \}", "'{ad}' was checked outside this loop; inside the loop it may become none again.\n   Move the check inside the loop:   repeat while {ad} is not none \{ ... \}"))
            return k
        }
        var g = d
        g.tip = d.asil                       # bundan sonra yine kontrol gerekir
        _guncelle(g)
        hedef = d.asil
    }
    if not uyumlu_mu(hedef, gelen) {
        _hata(k.cocuklar[1], dil.sec("'{ad}' bir {tip_aciklama(hedef)}, ona {tip_aciklama(gelen)} verilemez.\n   (Bir değişkenin tipi bir kere belirlenir, sonra değişmez.)", "'{ad}' is {tip_aciklama(hedef)}; it can't be given {tip_aciklama(gelen)}.\n   (A variable's type is set once and never changes.)"))
        return k
    }
    return _c(k, [deger], hedef)
}

fn _use_komutu(k: parser.Dugum) -> parser.Dugum {
    var ad = k.deger
    if LAMBDALAR.length > 0 {
        _hata(k, dil.sec("Lambda içinde 'use' yazılmaz: lambda, oluşturulduğu yerin değişkenlerini (kopyalarını) ve izinlerini zaten görür.", "'use' isn't written inside a lambda: a lambda already sees (copies of) the variables and the permissions of the place where it's created."))
        return k
    }
    if IZINLER.has(ad) {
        if FN.length is 0 {
            _hata(k, dil.sec("'use {ad}' sadece fonksiyonların içinde yazılır; ana program zaten her şeye izinli.", "'use {ad}' is only written inside functions; the main program already has every permission."))
        } else if k.ek is "change" {
            _hata(k, dil.sec("İzinler 'use change' ile değil, sadece 'use' ile yazılır:   use {ad}", "Permissions are written with just 'use', not 'use change':   use {ad}"))
        }
        return k
    }
    if FN.length is 0 {
        _hata(k, dil.sec("'use' sadece fonksiyonların içinde yazılır. Burada zaten her şeyi görebilirsin.", "'use' is only written inside functions. Here you can already see everything."))
        return k
    }
    if _ara(ad) is not none {
        _hata(k, dil.sec("'{ad}' bu fonksiyonda zaten var.", "'{ad}' is already in this function."))
        return k
    }
    if not ANA.has(ad) {
        var adaylar = ANA.keys()
        var izin_adlari = IZINLER.keys()
        repeat i from 1 to izin_adlari.length {
            adaylar.add(izin_adlari[i])
        }
        _hata(k, dil.sec("Dışarıda '{ad}' diye bir değişken (ya da izin) yok.{oneri.oneri(ad, adaylar)}", "There is no variable (or permission) called '{ad}' outside.{oneri.oneri(ad, adaylar)}"))
        return k
    }
    var disarida = ANA[ad]
    var tur = "dis-okur"
    if k.ek is "change" {
        tur = "dis-degistirir"
    }
    _koy(Degisken(ad: ad, tip: disarida.tip, tur: tur, satir: k.satir))
    return _t(k, disarida.tip)
}

fn _donus(k: parser.Dugum) -> parser.Dugum {
    if LAMBDALAR.length > 0 {                        # lambda'nın kendi return'ü
        return _donus_kontrolu(k, AKTIF)
    }
    if PARALEL > 0 {
        _hata(k, dil.sec("'return' bir parallel bölümünün içinde kullanılamaz (işler aynı anda farklı çekirdeklerde çalışıyor).\n   Sonucu bölümün dışındaki bir değişkene koy, return'ü bölümden sonra yaz.", "'return' can't be used inside a parallel section (the tasks run at the same time on different cores).\n   Put the result in a variable outside the section, and write return after the section."))
        return k
    }
    if ARENA > 0 {
        _hata(k, dil.sec("'return' bir arena bloğunun içinde kullanılamaz (blok bitmeden fonksiyondan çıkılırdı).\n   Sonucu bloğun dışındaki bir değişkene koy, return'ü bloktan sonra yaz.", "'return' can't be used inside an arena block (it would leave the function before the block ends).\n   Put the result in a variable outside the block, and write return after the block."))
        return k
    }
    if WHEN > 0 {
        _hata(k, dil.sec("'return' bir when bloğunun içinde kullanılamaz.", "'return' can't be used inside a when block."))
        return k
    }
    if OLCUM > 0 {
        _hata(k, dil.sec("'return' bir measure bloğunun içinde kullanılamaz (ölçüm yarıda kalırdı).", "'return' can't be used inside a measure block (the measurement would be cut short)."))
        return k
    }
    if FN.length is 0 {
        _hata(k, dil.sec("'return' sadece fonksiyonların içinde kullanılabilir.", "'return' can only be used inside functions."))
        return k
    }
    var f = AKTIF
    if _bos_mu(k.cocuklar[1]) {
        if f.donus is not "void" {
            _hata(k, dil.sec("'{f.ad}' bir {tip_aciklama(f.donus)} döndürmeli:   return ...", "'{f.ad}' must return {tip_aciklama(f.donus)}:   return ..."))
        }
        return k
    }
    if f.donus is "void" {
        _hata(k, dil.sec("'{f.ad}' fonksiyonunun dönüş tipi yazılmamış, bu yüzden değer döndüremez.\n   Değer döndürmesi için tanımına tip ekle:   fn {f.ad}(...) -> int", "The return type of the '{f.ad}' function isn't written, so it can't return a value.\n   To make it return a value, add a type to its definition:   fn {f.ad}(...) -> int"))
        return k
    }
    var deger = _ifade(k.cocuklar[1], f.donus)
    if _tamam() and not uyumlu_mu(f.donus, deger.tip) {
        _hata(k.cocuklar[1], dil.sec("'{f.ad}' bir {tip_aciklama(f.donus)} döndürmeli, ama burada {tip_aciklama(deger.tip)} döndürülüyor.", "'{f.ad}' must return {tip_aciklama(f.donus)}, but here {tip_aciklama(deger.tip)} is returned."))
    }
    return _c(k, [deger], "")
}

fn _eleman_atama(k: parser.Dugum) -> parser.Dugum {
    var liste = _ifade(k.cocuklar[1], "")
    if not _tamam() {
        return k
    }
    if sozluk_mu(liste.tip) {                                        # sozluk["Ali"] = 90
        var d = sozluk_degiskeni_olmali(liste, dil.sec("'sozluk[anahtar] = ...'", "'dict[key] = ...'"))
        if not _tamam() {
            return k
        }
        var anahtar = _sozluk_anahtari(d.tip, k.cocuklar[2])
        if not _tamam() {
            return k
        }
        var deger_tipi = _sozluk_deger(d.tip)
        var deger = _ifade(k.cocuklar[3], deger_tipi)
        if _tamam() and not uyumlu_mu(deger_tipi, deger.tip) {
            _hata(k.cocuklar[3], dil.sec("'{liste.deger}' sözlüğünün değerleri {tip_aciklama(deger_tipi)}, buraya {tip_aciklama(deger.tip)} konamaz.", "The values of the '{liste.deger}' dictionary are {tip_aciklama(deger_tipi)}; {tip_aciklama(deger.tip)} can't be put here."))
        }
        return parser.Dugum(tur: k.tur, deger: k.deger, ek: "sozluk", cocuklar: [liste, anahtar, deger], satir: k.satir, sutun: k.sutun, dosya: k.dosya)
    }
    var d = liste_degiskeni_olmali(liste, dil.sec("'liste[i] = ...'", "'list[i] = ...'"))
    if not _tamam() {
        return k
    }
    var eleman_tipi = _ic(d.tip)
    if d.tip is "bytes" {
        eleman_tipi = "int"
    }
    var sira = _ifade(k.cocuklar[2], "")
    if _tamam() and sira.tip is not "int" {
        _hata(k.cocuklar[2], dil.sec("Elemanın sırası bir tam sayı (int) olmalı, burada {tip_aciklama(sira.tip)} var.", "An element's position must be an integer (int), but here there is {tip_aciklama(sira.tip)}."))
        return k
    }
    var deger = _ifade(k.cocuklar[3], eleman_tipi)
    if _tamam() and d.tip is "bytes" and deger.tip is not "int" {
        _hata(k.cocuklar[3], dil.sec("'{liste.deger}' bir bayt dizisi; içine 0–255 arası tam sayı (int) konur, {tip_aciklama(deger.tip)} konamaz.", "'{liste.deger}' is a byte array; it holds integers (int) from 0 to 255, {tip_aciklama(deger.tip)} can't be put in it."))
        return k
    }
    if _tamam() and not uyumlu_mu(eleman_tipi, deger.tip) {
        _hata(k.cocuklar[3], dil.sec("'{liste.deger}' listesinin elemanları {tip_aciklama(eleman_tipi)}, buraya {tip_aciklama(deger.tip)} konamaz.", "The elements of the '{liste.deger}' list are {tip_aciklama(eleman_tipi)}; {tip_aciklama(deger.tip)} can't be put here."))
    }
    return _c(k, [liste, sira, deger], "")
}

fn _eger(k: parser.Dugum) -> parser.Dugum {
    var kosul = _sart_olmali(k.cocuklar[1], "if")
    if not _tamam() {
        return k
    }
    var kontrol = _none_kontrolleri(kosul)
    var govde = _blok(k.cocuklar[2].cocuklar, none, kontrol.var_olanlar)
    var degilse = k.cocuklar[3]
    if degilse.tur is "[]" and degilse.cocuklar.length > 0 {
        degilse = _liste(_blok(degilse.cocuklar, none, kontrol.yok_olanlar))
    }
    # if x is none { return }  → bu satırdan sonra x kesin var
    var ham_govde = k.cocuklar[2].cocuklar
    var cikiyor = her_zaman_doner_mu(ham_govde)
    if ham_govde.length > 0 {
        var son = ham_govde[ham_govde.length]
        if son.tur is "Dur" or son.tur is "Atla" {
            cikiyor = true
        }
    }
    if _tamam() and kontrol.yok_olanlar.length > 0 and cikiyor {
        repeat i from 1 to kontrol.yok_olanlar.length {
            _koy(_daraltilmis(kontrol.yok_olanlar[i], k))
        }
    }
    return _c(k, [kosul, _liste(govde), degilse], "")
}

fn _tekrar_sayac(k: parser.Dugum) -> parser.Dugum {
    var parcalar: [parser.Dugum] = []
    var adlar = ["from", "to", "step"]
    repeat i from 1 to 3 {
        var p = k.cocuklar[i]
        if _bos_mu(p) {
            parcalar.add(p)
        } else {
            var t = _ifade(p, "")
            if not _tamam() {
                return k
            }
            if t.tip is not "int" {
                _hata(p, dil.sec("'{adlar[i]}' bir tam sayı (int) olmalı, burada {tip_aciklama(t.tip)} var.", "'{adlar[i]}' must be an integer (int), but here there is {tip_aciklama(t.tip)}."))
                return k
            }
            parcalar.add(t)
        }
    }
    var adim = k.cocuklar[3]
    if adim.tur is "Sayi" and _sifirsiz(adim.deger) is "0" {
        _hata(adim, dil.sec("'step 0' olamaz: sayaç hiç ilerlemez, döngü sonsuza kadar sürer.", "'step 0' is not allowed: the counter would never move and the loop would run forever."))
        return k
    }
    if _ara(k.deger) is not none {
        _hata(k, dil.sec("'{k.deger}' adında bir değişken zaten var; sayaca başka bir ad ver.", "There is already a variable named '{k.deger}'; give the loop counter a different name."))
        return k
    }
    var sayac = Degisken(ad: k.deger, tip: "int", tur: "sayac", satir: k.satir)
    var govde = _dongu(k.cocuklar[4].cocuklar, sayac, [])
    parcalar.add(_liste(govde))
    return _c(k, parcalar, "")
}

# =====================================================================
#  İFADELER: her ifadenin tipini bul (türü yazılmış yeni düğümü döndür)
# =====================================================================
fn _ifade(e: parser.Dugum, beklenen: text) -> parser.Dugum {
    if not _tamam() {
        return e
    }
    use change HATA_IZNI
    use change SON_IZIN
    SON_IZIN = HATA_IZNI                             # izin (try / else:) sadece bu ifadenin kendisine
    HATA_IZNI = ""
    var tur = e.tur
    if tur is "Sayi" {
        if _cok_buyuk_mu(e.deger) {
            _hata(e, dil.sec("{_sifirsiz(e.deger)} bir int'e sığmayacak kadar büyük (en fazla 9223372036854775807 olabilir).", "{_sifirsiz(e.deger)} is too big to fit in an int (it can be at most 9223372036854775807)."))
            return e
        }
        return _t(e, "int")
    }
    if tur is "Ondalik" { return _t(e, "float") }
    if tur is "Mantiksal" { return _t(e, "bool") }
    if tur is "Metin" { return _metin_parcala(e) }
    if tur is "Isim" {
        if e.ek.length > 0 and _ara(e.ek) is not none {     # modülde fonksiyonla aynı adlı yerel değişken
            var yerel = e
            yerel.deger = e.ek
            yerel.ek = ""
            var yd = bul(yerel.deger, yerel)
            return _t(yerel, yd.tip)
        }
        if _ara(e.deger) is none and not _alan_mi(e.deger) and FONKSIYONLAR.has(e.deger) and _gorunur_ad(e.deger, e) {
            return _fonksiyon_degeri(e)              # fn kare(x) ...  →  kare (değer olarak)
        }
        var d = bul(e.deger, e)
        return _t(e, d.tip)
    }
    if tur is "Liste" { return _liste_degeri(e, beklenen) }
    if tur is "SozlukDegeri" { return _sozluk_degeri(e, beklenen) }
    if tur is "Yok" { return _t(e, "none") }
    if tur is "YedekliDeger" {
        use change HATA_ELE_ALINDI
        HATA_IZNI = "else"
        HATA_ELE_ALINDI = false
        var d = _ifade(e.cocuklar[1], "")
        HATA_IZNI = ""
        if not _tamam() {
            return e
        }
        if HATA_ELE_ALINDI {                             # bol(1, 0) else: -1 → hata olursa yedek
            HATA_ELE_ALINDI = false
            if d.tip is "void" {
                _hata(e, dil.sec("'else:' bir değer döndüren çağrıdan sonra yazılır; değer döndürmeyen hata verebilen bir çağrıyı do \{ \} catch hata \{ \} ile yakala.", "'else:' is written after a call that returns a value; catch a failing call that returns nothing with do \{ \} catch error \{ \}."))
                return e
            }
            var yh = _ifade(e.cocuklar[2], d.tip)
            if _tamam() and not uyumlu_mu(d.tip, yh.tip) {
                _hata(e.cocuklar[2], dil.sec("Yedek değer {tip_aciklama(d.tip)} olmalı, burada {tip_aciklama(yh.tip)} var.", "The fallback value must be {tip_aciklama(d.tip)}, but here there is {tip_aciklama(yh.tip)}."))
                return e
            }
            var sh = _c(e, [d, yh], d.tip)
            sh.ek = "hata"
            return sh
        }
        if not secmeli_mi(d.tip) {
            _hata(e, dil.sec("'else:' yok olabilen (T?) bir değerden sonra yazılır; soldaki değer {tip_aciklama(d.tip)}, zaten hiç none olamaz.", "'else:' is written after a value that may be none (T?); the value on the left is {tip_aciklama(d.tip)}, which can never be none."))
            return e
        }
        var ic = _soru_siz(d.tip)
        var y = _ifade(e.cocuklar[2], ic)
        if _tamam() and not uyumlu_mu(ic, y.tip) {
            _hata(e.cocuklar[2], dil.sec("Yedek değer {tip_aciklama(ic)} olmalı, burada {tip_aciklama(y.tip)} var.", "The fallback value must be {tip_aciklama(ic)}, but here there is {tip_aciklama(y.tip)}."))
        }
        return _c(e, [d, y], ic)
    }
    if tur is "TekliIslem" {
        var x = _ifade(e.cocuklar[1], "")
        if not _tamam() {
            return e
        }
        if e.deger is "not" {
            if x.tip is not "bool" {
                _hata(e, dil.sec("'not' sadece doğru/yanlış (bool) değerlerle kullanılır, burada {tip_aciklama(x.tip)} var.", "'not' is only used with true/false (bool) values, but here there is {tip_aciklama(x.tip)}."))
            }
            return _c(e, [x], "bool")
        }
        if not sayisal_mi(x.tip) {
            _hata(e, dil.sec("'-' sadece sayılarla kullanılır, burada {tip_aciklama(x.tip)} var.", "'-' is only used with numbers, but here there is {tip_aciklama(x.tip)}."))
        }
        return _c(e, [x], x.tip)
    }
    if tur is "IkiliIslem" { return _ikili_islem(e) }
    if tur is "Cagri" { return _cagri(e, beklenen) }
    if tur is "Aralik" {
        _hata(e, dil.sec("'a to b' aralığı burada kullanılamaz; sadece repeat'te ve random(1 to 6) içinde yazılır.", "An 'a to b' range can't be used here; it is only written in repeat and inside random(1 to 6)."))
        return e
    }
    if tur is "Baslat" { return _baslat(e) }
    if tur is "Dene" { return _dene(e, beklenen) }
    if tur is "Lambda" { return _lambda(e, beklenen) }
    if tur is "KanalYeni" {                              # channel[text]()
        var mt = tip_coz(e.cocuklar[1])
        if not _tamam() {
            return e
        }
        return _c(e, [e.cocuklar[1]], "channel[{mt}]")
    }
    if tur is "Olcum" {
        use change DONGU
        use change OLCUM
        var onceki = DONGU
        DONGU = 0
        OLCUM = OLCUM + 1
        var govde = _blok(e.cocuklar[1].cocuklar, none, [])
        OLCUM = OLCUM - 1
        DONGU = onceki
        return _c(e, [_liste(govde)], "float")
    }
    if tur is "Erisim" { return _erisim(e) }
    if (tur is "Ozellik" or tur is "MetotCagrisi") and _enum_adi_mi(e.cocuklar[1]) {
        return _enum_olusturma(e)                    # Odeme.Nakit / Odeme.Kart(no: "1234")
    }
    if tur is "Ozellik" { return _ozellik(e) }
    if tur is "MetotCagrisi" { return _metot_cagrisi(e) }
    _hata(e, dil.sec("Bunu anlayamadım.", "I couldn't understand this."))
    return e
}

fn _secmeli_kullanilamaz(dugum: parser.Dugum, t: text) {
    if secmeli_mi(t) {
        var ad = dil.sec("değer", "value")
        var ornek = dil.sec("önce bir değişkene koy, sonra: if x is not none \{ ... \}", "first put it in a variable, then: if x is not none \{ ... \}")
        if dugum.tur is "Isim" {
            ad = dugum.deger
            ornek = "if {ad} is not none \{ ... \}"
        }
        _hata(dugum, dil.sec("'{ad}' yok (none) olabilir ({t}); kullanmadan önce kontrol et:\n   {ornek}\n   ya da yedekle oku:   ({ad} else: yedek)", "'{ad}' may be none ({t}); check it before using it:\n   {ornek}\n   or read it with a fallback:   ({ad} else: fallback)"))
    } else if t is "none" {
        _hata(dugum, dil.sec("none'ın hiçbir alanı ya da işi yok.", "none has no fields or methods."))
    }
}

fn _erisim(e: parser.Dugum) -> parser.Dugum {
    var l = _ifade(e.cocuklar[1], "")
    if not _tamam() {
        return e
    }
    var t = l.tip
    _secmeli_kullanilamaz(e.cocuklar[1], t)
    if not _tamam() {
        return e
    }
    if sozluk_mu(t) {                                       # sozluk["Ali"]
        var anahtar = _sozluk_anahtari(t, e.cocuklar[2])
        return _c(e, [l, anahtar], _sozluk_deger(t))
    }
    if t is not "text" and t is not "bytes" and not liste_mi(t) {
        _hata(e, dil.sec("[ ] ile sadece listelerden, metinlerden ve baytlardan eleman alınabilir, burada {tip_aciklama(t)} var.", "Elements can only be taken with [ ] from lists, text and bytes, but here there is {tip_aciklama(t)}."))
        return e
    }
    var sira = e.cocuklar[2]
    if sira.tur is "Aralik" {
        if t is not "text" and t is not "bytes" {
            _hata(sira, dil.sec("Parça alma (a to b) şimdilik sadece metinlerde ve baytlarda var:   metin[2 to 4]", "Taking a slice (a to b) currently only works on text and bytes:   name[2 to 4]"))
            return e
        }
        var a = _ifade(sira.cocuklar[1], "")
        if _tamam() and a.tip is not "int" {
            _hata(sira.cocuklar[1], dil.sec("Sıra bir tam sayı (int) olmalı, burada {tip_aciklama(a.tip)} var.", "The position must be an integer (int), but here there is {tip_aciklama(a.tip)}."))
            return e
        }
        var b = _ifade(sira.cocuklar[2], "")
        if _tamam() and b.tip is not "int" {
            _hata(sira.cocuklar[2], dil.sec("Sıra bir tam sayı (int) olmalı, burada {tip_aciklama(b.tip)} var.", "The position must be an integer (int), but here there is {tip_aciklama(b.tip)}."))
            return e
        }
        return _c(e, [l, _c(sira, [a, b], "")], t)
    }
    var s = _ifade(sira, "")
    if _tamam() and s.tip is not "int" {
        _hata(sira, dil.sec("Sıra bir tam sayı (int) olmalı, burada {tip_aciklama(s.tip)} var.", "The position must be an integer (int), but here there is {tip_aciklama(s.tip)}."))
        return e
    }
    if t is "text" {
        return _c(e, [l, s], "text")                       # metin[1] → tek harflik metin
    }
    if t is "bytes" {
        return _c(e, [l, s], "int")                        # bayt[1] → 0–255 arası sayı
    }
    return _c(e, [l, s], _ic(t))
}

fn _ozellik(e: parser.Dugum) -> parser.Dugum {
    var n = _ifade(e.cocuklar[1], "")
    if not _tamam() {
        return e
    }
    var t = n.tip
    _secmeli_kullanilamaz(e.cocuklar[1], t)
    if not _tamam() {
        return e
    }
    if (liste_mi(t) or t is "text" or t is "bytes" or sozluk_mu(t)) and e.deger is "length" {
        return _c(e, [n], "int")
    }
    if t is "text" {
        if METIN_METOTLARI.has(e.deger) {
            _hata(e, dil.sec("'{e.deger}' bir iş; çağırmak için parantez kullan:   .{e.deger}(...)", "'{e.deger}' is a method; use parentheses to call it:   .{e.deger}(...)"))
        } else {
            _hata(e, dil.sec("Metinlerin '{e.deger}' diye bir özelliği yok.{oneri.oneri(e.deger, ["length"])}", "Text has no property called '{e.deger}'.{oneri.oneri(e.deger, ["length"])}"))
        }
        return e
    }
    if t is "bytes" {
        _hata(e, dil.sec("Baytların '{e.deger}' diye bir özelliği yok.{oneri.oneri(e.deger, ["length"])}", "Bytes have no property called '{e.deger}'.{oneri.oneri(e.deger, ["length"])}"))
        return e
    }
    if liste_mi(t) {
        _hata(e, dil.sec("Listelerin '{e.deger}' diye bir özelliği yok.{oneri.oneri(e.deger, ["length"])}", "Lists have no property called '{e.deger}'.{oneri.oneri(e.deger, ["length"])}"))
        return e
    }
    if sozluk_mu(t) {
        if _icinde_mi(e.deger, SOZLUK_METOTLARI) {
            _hata(e, dil.sec("'{e.deger}' bir iş; çağırmak için parantez kullan:   .{e.deger}(...)", "'{e.deger}' is a method; use parentheses to call it:   .{e.deger}(...)"))
        } else {
            _hata(e, dil.sec("Sözlüklerin '{e.deger}' diye bir özelliği yok.{oneri.oneri(e.deger, ["length"])}", "Dictionaries have no property called '{e.deger}'.{oneri.oneri(e.deger, ["length"])}"))
        }
        return e
    }
    if ENUMLAR.has(t) {
        _hata(e, dil.sec("Bir enum değerinin alanları 'match' ile okunur:\n   match deger \{ Cesit({e.deger}) \{ print({e.deger}) \} ... \}", "The fields of an enum value are read with 'match':\n   match value \{ Variant({e.deger}) \{ print({e.deger}) \} ... \}"))
        return e
    }
    if TIPLER.has(t) {                                   # nesne.alan
        var b = TIPLER[t]
        repeat i from 1 to b.alan_adlari.length {
            if b.alan_adlari[i] is e.deger {
                return _c(e, [n], b.alan_tipleri[i])
            }
        }
        if b.metotlar.has(e.deger) {
            _hata(e, dil.sec("'{e.deger}' bir metot; çağırmak için parantez kullan:   .{e.deger}(...)", "'{e.deger}' is a method; use parentheses to call it:   .{e.deger}(...)"))
        } else {
            _hata(e, dil.sec("'{t}' tipinin '{e.deger}' diye bir alanı yok.{oneri.oneri(e.deger, b.alan_adlari)}", "The '{t}' type has no field called '{e.deger}'.{oneri.oneri(e.deger, b.alan_adlari)}"))
        }
        return e
    }
    _hata(e, dil.sec("{tip_aciklama(t)} değerlerinin '{e.deger}' diye bir özelliği yok (henüz).", "{tip_aciklama(t)} values have no property called '{e.deger}' (yet)."))
    return e
}

fn _arguman_sayisi_yazi(n: int) -> text {
    return "{n}"
}

# ---------- Düzenli ifadeler: metin.matches / find / find_all / replace_pattern ----------
fn _regex_isi_mi(ad: text) -> bool {
    return ad is "matches" or ad is "find" or ad is "find_all" or ad is "replace_pattern"
}

fn _regex_isaretini_at(e: parser.Dugum) -> parser.Dugum {
    var kalan: [parser.Dugum] = []
    var isimli = e.cocuklar[4].cocuklar
    repeat i from 1 to isimli.length {
        if isimli[i].deger is not "__regex" {
            kalan.add(isimli[i])
        }
    }
    return parser.Dugum(tur: e.tur, deger: e.deger, ek: e.ek, cocuklar: [e.cocuklar[1], e.cocuklar[2], e.cocuklar[3], _liste(kalan)], satir: e.satir, sutun: e.sutun, dosya: e.dosya)
}

# metin.find(desen) → regex.find(metin, desen); desen düz yazıysa önceden çözülmüşü: regex._find_p(metin, _regex_N)
fn _regex_cagrisi(e: parser.Dugum) -> parser.Dugum {
    var ad = e.deger
    var argumanlar = e.cocuklar[2].cocuklar
    var isimli = e.cocuklar[4].cocuklar
    var ornek = dil.sec("metin.{ad}(\"desen\")", "line.{ad}(\"pattern\")")
    var beklenen = 1
    if ad is "replace_pattern" {
        ornek = dil.sec("metin.replace_pattern(\"desen\", \"yeni\")", "line.replace_pattern(\"pattern\", \"new\")")
        beklenen = 2
    }
    if argumanlar.length is not beklenen {
        _hata(e, dil.sec("'.{ad}' {beklenen} değer bekliyor:   {ornek}", "'.{ad}' expects {beklenen} value(s):   {ornek}"))
        return e
    }
    repeat i from 1 to argumanlar.length {
        var a = _ifade(argumanlar[i], "text")
        if _tamam() and a.tip is not "text" {
            _hata(argumanlar[i], dil.sec("'.{ad}' metin bekliyor, burada {tip_aciklama(a.tip)} var:   {ornek}", "'.{ad}' expects text, but here there is {tip_aciklama(a.tip)}:   {ornek}"))
            return e
        }
    }
    if not _tamam() {
        return e
    }
    var hazir_no = 0
    repeat i from 1 to isimli.length {
        if isimli[i].deger is "__regex" {
            hazir_no = i
        } else {
            _hata(isimli[i], dil.sec("'.{ad}' değerleri adlarıyla (ad: değer) almaz:   {ornek}", "'.{ad}' doesn't take values by name (name: value):   {ornek}"))
            return e
        }
    }
    var yeni: [parser.Dugum] = [e.cocuklar[1]]
    var fonk = "regex.{ad}"
    if hazir_no > 0 {
        var kisa = {"matches": "_matches_p", "find": "_find_p", "find_all": "_find_all_p", "replace_pattern": "_replace_p"}
        fonk = "regex.{kisa[ad]}"
        yeni.add(isimli[hazir_no].cocuklar[1])
        if argumanlar.length > 1 {
            yeni.add(argumanlar[2])
        }
    } else {
        repeat i from 1 to argumanlar.length {
            yeni.add(argumanlar[i])
        }
    }
    var bos: [parser.Dugum] = []
    var cagri = parser.Dugum(tur: "Cagri", deger: fonk, ek: "", cocuklar: [_liste(yeni), _liste(bos)], satir: e.satir, sutun: e.sutun, dosya: e.dosya)
    return _ifade(cagri, "")
}

fn _metot_cagrisi(e: parser.Dugum) -> parser.Dugum {
    var izin = SON_IZIN                              # try / else: bu çağrının hatasını ele alıyor mu?
    var n = _ifade(e.cocuklar[1], "")
    if not _tamam() {
        return e
    }
    var t = n.tip
    _secmeli_kullanilamaz(e.cocuklar[1], t)
    if not _tamam() {
        return e
    }
    var ad = e.deger
    var argumanlar = e.cocuklar[2].cocuklar
    if _regex_isi_mi(ad) {
        if t is "text" {                                    # desen işleri: std/regex.vash
            return _regex_cagrisi(e)
        }
        var isimli0 = e.cocuklar[4].cocuklar
        repeat i from 1 to isimli0.length {
            if isimli0[i].deger is "__regex" {             # kendi tipinin aynı adlı metodu: derleyicinin eki karışmasın
                return _metot_cagrisi(_regex_isaretini_at(e))
            }
        }
    }
    if t is "text" {                                        # metin işleri
        if not METIN_METOTLARI.has(ad) {
            if ad is "length" {
                _hata(e, dil.sec("'length' bir özellik; parantez olmadan yaz:   metin.length", "'length' is a property; write it without parentheses:   name.length"))
            } else {
                _hata(e, dil.sec("Metinlerin '{ad}' diye bir işi yok.{oneri.oneri(ad, METIN_METOTLARI.keys())}", "Text has no method called '{ad}'.{oneri.oneri(ad, METIN_METOTLARI.keys())}"))
            }
            return e
        }
        var secenekler = METIN_METOTLARI[ad]
        var uygun_no = 0
        repeat i from 1 to secenekler.length {
            if uygun_no is 0 and secenekler[i].length is argumanlar.length {
                uygun_no = i
            }
        }
        if uygun_no is 0 {
            var sayilar: [text] = []
            repeat i from 1 to secenekler.length {
                sayilar.add("{secenekler[i].length}")
            }
            _hata(e, dil.sec("'.{ad}' {sayilar.join(" ya da ")} değer bekliyor, {argumanlar.length} değer verildi.", "'.{ad}' expects {sayilar.join(" or ")} value(s), but {argumanlar.length} values were given."))
            return e
        }
        var beklenenler = secenekler[uygun_no]
        var tipli: [parser.Dugum] = []
        repeat i from 1 to argumanlar.length {
            var a = _ifade(argumanlar[i], "")
            if not _tamam() {
                return e
            }
            if a.tip is not beklenenler[i] {
                _hata(argumanlar[i], dil.sec("'.{ad}' bir {tip_aciklama(beklenenler[i])} bekliyor, burada {tip_aciklama(a.tip)} var.", "'.{ad}' expects {tip_aciklama(beklenenler[i])}, but here there is {tip_aciklama(a.tip)}."))
                return e
            }
            tipli.add(a)
        }
        return _c(e, [n, _liste(tipli), e.cocuklar[3], e.cocuklar[4]], METIN_DONUS[ad])
    }
    if t is "bytes" {
        return _bayt_metodu(e, n)
    }
    if t.starts_with("task[") {
        return _is_metodu(e, n, t)
    }
    if t.starts_with("channel[") {
        return _kanal_metodu(e, n, t)
    }
    if TIPLER.has(t) {                                   # kendi tipin metodu
        var b = TIPLER[t]
        if not b.metotlar.has(ad) {
            if _icinde_mi(ad, b.alan_adlari) {
                _hata(e, dil.sec("'{ad}' bir alan, metot değil; parantez olmadan yaz:   .{ad}", "'{ad}' is a field, not a method; write it without parentheses:   .{ad}"))
            } else {
                _hata(e, dil.sec("'{t}' tipinin '{ad}' diye bir metodu yok.{oneri.oneri(ad, b.metotlar.keys())}", "The '{t}' type has no method called '{ad}'.{oneri.oneri(ad, b.metotlar.keys())}"))
            }
            return e
        }
        var m = b.metotlar[ad]
        if m.degistirir {                                # nesneyi değiştirecek: değişken değiştirilebilir olmalı
            _nesne_degiskeni_olmali(e.cocuklar[1], dil.sec("'.{ad}(...)' (change metot)", "'.{ad}(...)' (change method)"))
            if not _tamam() {
                return e
            }
        }
        var tipli_a = _argumanlar(e, argumanlar, m, dil.sec("metodunun", "method"))
        if not _tamam() {
            return e
        }
        _izin_kontrol(e, m)
        _hata_cagrisi(e, m, izin)
        return _c(e, [n, _liste(tipli_a), e.cocuklar[3], e.cocuklar[4]], m.donus)
    }
    if sozluk_mu(t) {
        return _sozluk_metodu(e, n, t)
    }
    if liste_mi(t) and ad is "join" {                         # liste.join(", ") → metin
        var eleman = _ic(t)
        if not _yazdirilabilir(eleman) {
            _hata(e, dil.sec("'.join' metin, sayı ya da bool listelerini birleştirir; bu liste {tip_aciklama(t)}.", "'.join' joins lists of text, numbers or bools; this list is {tip_aciklama(t)}."))
            return e
        }
        if argumanlar.length is not 1 {
            _hata(e, dil.sec("'.join' araya konacak bir metin bekler:   liste.join(\", \")", "'.join' expects a text to put between the items:   list.join(\", \")"))
            return e
        }
        var a = _ifade(argumanlar[1], "")
        if _tamam() and a.tip is not "text" {
            _hata(e, dil.sec("'.join' araya konacak bir metin bekler:   liste.join(\", \")", "'.join' expects a text to put between the items:   list.join(\", \")"))
            return e
        }
        return _c(e, [n, _liste([a]), e.cocuklar[3], e.cocuklar[4]], "text")
    }
    if liste_mi(t) and ad is "sort" {
        return _liste_sirala(e, n, t)
    }
    if liste_mi(t) and _icinde_mi(ad, ["map", "filter", "any", "all", "count", "find"]) {
        return _liste_lambda_metodu(e, n, t)
    }
    if ad is not "add" and ad is not "remove" {
        if liste_mi(t) {
            _hata(e, dil.sec("Listelerin '{ad}' diye bir işi yok.{oneri.oneri(ad, ["add", "remove", "join", "sort", "map", "filter", "any", "all", "count", "find"])}", "Lists have no method called '{ad}'.{oneri.oneri(ad, ["add", "remove", "join", "sort"])}"))
        } else {
            _hata(e, dil.sec("{tip_aciklama(t)} değerlerinin '{ad}' diye bir işi yok (henüz).", "{tip_aciklama(t)} values have no method called '{ad}' (yet)."))
        }
        return e
    }
    var d = liste_degiskeni_olmali(n, "'.{ad}(...)'")
    if not _tamam() {
        return e
    }
    var eleman_tipi = _ic(d.tip)
    if argumanlar.length is not 1 {
        _hata(e, dil.sec("'.{ad}' tek bir değer bekliyor, {argumanlar.length} değer verildi.", "'.{ad}' expects a single value, but {argumanlar.length} values were given."))
        return e
    }
    if ad is "add" {
        var a = _ifade(argumanlar[1], eleman_tipi)
        if _tamam() and not uyumlu_mu(eleman_tipi, a.tip) {
            _hata(argumanlar[1], dil.sec("'{n.deger}' listesinin elemanları {tip_aciklama(eleman_tipi)}, buna {tip_aciklama(a.tip)} eklenemez.", "The elements of the '{n.deger}' list are {tip_aciklama(eleman_tipi)}; {tip_aciklama(a.tip)} can't be added to it."))
            return e
        }
        return _c(e, [n, _liste([a]), e.cocuklar[3], e.cocuklar[4]], "void")
    }
    var a = _ifade(argumanlar[1], "")
    if _tamam() and a.tip is not "int" {
        _hata(argumanlar[1], dil.sec("'.remove' silinecek elemanın sırasını (int) bekliyor, burada {tip_aciklama(a.tip)} var.", "'.remove' expects the position (int) of the element to delete, but here there is {tip_aciklama(a.tip)}."))
        return e
    }
    return _c(e, [n, _liste([a]), e.cocuklar[3], e.cocuklar[4]], "void")
}

# start f(a, b): f arka planda (ayrı bir iş parçacığında) başlar; sonuç task[T] (T: f'nin döndürdüğü)
fn _baslat(e: parser.Dugum) -> parser.Dugum {
    use change BASLATMALAR
    var c = e.cocuklar[1]
    if c.tur is not "Cagri" {
        _hata(e, dil.sec("'start' bir fonksiyon çağrısıyla yazılır:   var gorev = start indir(adres)\n   (Metotlar ve hazır işler arka planda başlatılamaz; bir fonksiyonun içine al.)", "'start' is written with a function call:   var job = start download(address)\n   (Methods and built-in functions can't be started in the background; put it inside a function.)"))
        return e
    }
    if _icinde_mi(c.deger, YERLESIK) or TIPLER.has(c.deger) or not FONKSIYONLAR.has(c.deger) {
        if not FONKSIYONLAR.has(c.deger) and not _icinde_mi(c.deger, YERLESIK) and not TIPLER.has(c.deger) {
            var t0 = _ifade(c, "")                   # olmayan fonksiyon: her zamanki hata mesajı
            if not _tamam() {
                return e
            }
        }
        _hata(e, dil.sec("'{c.deger}' arka planda başlatılamaz; sadece kendi yazdığın (ya da modüldeki) fonksiyonlar başlatılabilir.\n   Bir fonksiyonun içine al:   fn hesapla() -> ... \{ ... \}   var gorev = start hesapla()", "'{c.deger}' can't be started in the background; only functions you wrote yourself (or ones in a module) can be started.\n   Put it inside a function:   fn compute() -> ... \{ ... \}   var job = start compute()"))
        return e
    }
    if FONKSIYONLAR[c.deger].hata_verir {
        _hata(e, dil.sec("'{c.deger}' hata verebilir (fails); şimdilik start ile başlatılamaz.\n   Hatayı içeride yakalayan bir fonksiyona sar:   do \{ ... \} catch hata \{ ... \}", "'{c.deger}' can fail (fails); it can't be started with start yet.\n   Wrap it in a function that catches the error inside:   do \{ ... \} catch error \{ ... \}"))
        return e
    }
    if FONKSIYONLAR[c.deger].c_mi {
        _hata(e, dil.sec("'{c.deger}' bir C fonksiyonu; arka planda başlatmak için onu çağıran bir Vash fonksiyonu yaz.", "'{c.deger}' is a C function; to start it in the background, write a Vash function that calls it."))
        return e
    }
    if ARENA > 0 {
        _hata(e, dil.sec("'start' bir arena \{ \} bloğunun içinde yazılamaz (blok bitince bellek silinir, iş ise sürüyor olabilir).\n   İşi bloğun dışında başlat.", "'start' can't be written inside an arena \{ \} block (the memory is deleted when the block ends, but the task may still be running).\n   Start the task outside the block."))
        return e
    }
    var tipli = _ifade(c, "")
    if not _tamam() {
        return e
    }
    var sonuc = _c(e, [tipli], "task[{tipli.tip}]")
    BASLATMALAR.add(sonuc)
    return sonuc
}

# kanal.send(x) · kanal.receive() / receive(else: v) · kanal.try_receive() / try_receive(else: v) · kanal.close()
fn _kanal_metodu(e: parser.Dugum, n: parser.Dugum, t: text) -> parser.Dugum {
    var ad = e.deger
    var mesaj = t[9 to t.length - 1]
    var argumanlar = e.cocuklar[2].cocuklar
    var yedek = e.cocuklar[3]
    var adlar = ["send", "receive", "try_receive", "close"]
    if not _icinde_mi(ad, adlar) {
        _hata(e, dil.sec("Kanalların '{ad}' diye bir işi yok.{oneri.oneri(ad, adlar)}\n   kanal.send(x) → gönder · kanal.receive() → sıradakini al (gelene kadar bekler) · kanal.close() → kapat", "Channels have no method called '{ad}'.{oneri.oneri(ad, adlar)}\n   channel.send(x) → send · channel.receive() → take the next one (waits until one arrives) · channel.close() → close"))
        return e
    }
    if e.cocuklar[4].cocuklar.length > 0 {
        _hata(e, dil.sec("'.{ad}' değerleri adlarıyla (ad: değer) almaz.", "'.{ad}' doesn't take values by name (name: value)."))
        return e
    }
    if ad is "send" {
        if argumanlar.length is not 1 or not _bos_mu(yedek) {
            _hata(e, dil.sec("'.send' gönderilecek tek bir değer bekler:   kanal.send(x)", "'.send' expects a single value to send:   channel.send(x)"))
            return e
        }
        var a = _ifade(argumanlar[1], mesaj)
        if _tamam() and not uyumlu_mu(mesaj, a.tip) {
            _hata(argumanlar[1], dil.sec("Bu kanal {tip_aciklama(mesaj)} taşıyor, ona {tip_aciklama(a.tip)} gönderilemez.", "This channel carries {tip_aciklama(mesaj)}; {tip_aciklama(a.tip)} can't be sent on it."))
            return e
        }
        return _c(e, [n, _liste([a]), yedek, e.cocuklar[4]], "void")
    }
    if argumanlar.length > 0 {
        _hata(e, dil.sec("'.{ad}' değer almaz:   kanal.{ad}()", "'.{ad}' takes no values:   channel.{ad}()"))
        return e
    }
    if ad is "close" {
        if not _bos_mu(yedek) {
            _hata(yedek, dil.sec("'else:' sadece receive ve try_receive ile kullanılır.", "'else:' is only used with receive and try_receive."))
            return e
        }
        return _c(e, [n, e.cocuklar[2], yedek, e.cocuklar[4]], "void")
    }
    # receive / try_receive: mesaj yoksa (kanal kapanıp boşalmışsa) none ya da else: değeri
    if _bos_mu(yedek) {
        if mesaj is "int" or mesaj is "float" or mesaj is "bool" or mesaj.starts_with("task[") or mesaj.starts_with("channel[") or secmeli_mi(mesaj) {
            _hata(e, dil.sec("'.{ad}()' kanal kapanıp boşalınca none döner, ama {tip_aciklama(mesaj)} none olamaz.\n   O durum için bir yedek değer ver:   kanal.{ad}(else: -1)", "'.{ad}()' returns none when the channel is closed and empty, but {tip_aciklama(mesaj)} can't be none.\n   Give a fallback value for that case:   channel.{ad}(else: -1)"))
            return e
        }
        return _c(e, [n, e.cocuklar[2], yedek, e.cocuklar[4]], "{mesaj}?")
    }
    var y = _ifade(yedek, mesaj)
    if _tamam() and not uyumlu_mu(mesaj, y.tip) {
        _hata(yedek, dil.sec("Yedek değer kanalın mesajlarıyla aynı tipte olmalı ({tip_aciklama(mesaj)}), burada {tip_aciklama(y.tip)} var.", "The fallback value must have the same type as the channel's messages ({tip_aciklama(mesaj)}), but here there is {tip_aciklama(y.tip)}."))
        return e
    }
    return _c(e, [n, e.cocuklar[2], y, e.cocuklar[4]], mesaj)
}

# gorev.wait(): bitmesini bekle, sonucu al · gorev.done(): bitti mi?
fn _is_metodu(e: parser.Dugum, n: parser.Dugum, t: text) -> parser.Dugum {
    var ad = e.deger
    if ad is not "wait" and ad is not "done" {
        _hata(e, dil.sec("Arka plan işlerinin '{ad}' diye bir işi yok.{oneri.oneri(ad, ["wait", "done"])}\n   gorev.wait() → bitmesini bekler, sonucu verir · gorev.done() → bitti mi?", "Background tasks have no method called '{ad}'.{oneri.oneri(ad, ["wait", "done"])}\n   job.wait() → waits for it to finish and gives the result · job.done() → is it finished?"))
        return e
    }
    if e.cocuklar[2].cocuklar.length > 0 or e.cocuklar[4].cocuklar.length > 0 {
        _hata(e, dil.sec("'.{ad}' değer almaz:   is.{ad}()", "'.{ad}' takes no values:   job.{ad}()"))
        return e
    }
    var donus = "bool"
    if ad is "wait" {
        donus = t[6 to t.length - 1]
    }
    return _c(e, [n, e.cocuklar[2], e.cocuklar[3], e.cocuklar[4]], donus)
}

# =====================================================================
#  LAMBDA ve FONKSİYON DEĞERLERİ:  fn(a, b) => a + b  ·  fn(int, int) -> int  ·  kare (değer olarak)
#  Tip yazımı: "fn(int,int)->int"; değer döndürmeyen: "fn(text)->void".
# =====================================================================
fn fn_mi(t: text) -> bool {
    return t.starts_with("fn(")
}

# "fn(int,[text])->bool" → parametre listesinin bittiği ')' nin yeri
fn _fn_kapanis(t: text) -> int {
    var derinlik = 0
    repeat i from 3 to t.length {
        var h = t[i]
        if h is "(" or h is "[" or h is "\{" {
            derinlik = derinlik + 1
        } else if h is ")" or h is "]" or h is "\}" {
            derinlik = derinlik - 1
            if derinlik is 0 {
                return i
            }
        }
    }
    return t.length
}

fn fn_parametreleri(t: text) -> [text] {
    var k = _fn_kapanis(t)
    if k <= 4 {
        var bos: [text] = []
        return bos
    }
    return _tip_argumanlarini_ayir(t[4 to k - 1])
}

fn fn_donusu(t: text) -> text {
    var k = _fn_kapanis(t)
    return t[k + 3 to t.length]
}

fn _alan_mi(ad: text) -> bool {
    if TIP_ICINDE.length is 0 or not TIPLER.has(TIP_ICINDE) {
        return false
    }
    return _icinde_mi(ad, TIPLER[TIP_ICINDE].alan_adlari)
}

# Değişkenin bulunduğu kapsamın YIGIN'daki yeri (0: ana programın değişkenleri)
fn _seviye(ad: text) -> int {
    repeat i from YIGIN.length to 1 step -1 {
        if YIGIN[i].has(ad) {
            return i
        }
    }
    return 0
}

# Lambda dışından kullanılan bir değişkeni, o değişkenin dışında kalan bütün lambda'lara yakalat
fn _yakala(ad: text, tip: text, seviye: int) {
    use change LAMBDALAR
    repeat i from LAMBDALAR.length to 1 step -1 {
        var l = LAMBDALAR[i]
        if seviye >= l.taban {
            return                                   # bu (ve dıştaki) lambda için iç değişken
        }
        if not _icinde_mi(ad, l.adlar) {
            var adlar = l.adlar                      # (derleyici eski derleyiciyle de derlenir: iç içe değiştirme yok)
            var tipler_ = l.tipler_
            adlar.add(ad)
            tipler_.add(tip)
            l.adlar = adlar
            l.tipler_ = tipler_
            LAMBDALAR[i] = l
        }
    }
}

fn _fonksiyon_degeri(e: parser.Dugum) -> parser.Dugum {
    var f = FONKSIYONLAR[e.deger]
    if f.c_mi {
        _hata(e, dil.sec("'{e.deger}' bir C fonksiyonu; değer olarak verilemez. Onu çağıran bir Vash fonksiyonu yaz.", "'{e.deger}' is a C function; it can't be passed as a value. Write a Vash function that calls it."))
        return e
    }
    if f.hata_verir {
        _hata(e, dil.sec("'{e.deger}' hata verebilir (fails); şimdilik değer olarak verilemez.", "'{e.deger}' can fail (fails); it can't be passed as a value yet."))
        return e
    }
    var c2 = e
    c2.tur = "FonksiyonDegeri"
    return _t(c2, "fn({f.p_tipler.join(",")})->{f.donus}")
}

# f(x): f fonksiyon tipli bir değişken
fn _deger_cagrisi(e: parser.Dugum, ad: text, beklenen: text) -> parser.Dugum {
    var d = bul(ad, e)
    var ps = fn_parametreleri(d.tip)
    var argumanlar = e.cocuklar[1].cocuklar
    if e.cocuklar[2].cocuklar.length > 0 {
        _hata(e, dil.sec("'{ad}(...)' bir fonksiyon değeri; değerler adlarıyla verilemez, sırayla yazılır.", "'{ad}(...)' is a function value; values can't be given by name, they are written in order."))
        return e
    }
    if argumanlar.length is not ps.length {
        _hata(e, dil.sec("'{ad}' {ps.length} değer bekliyor ({tip_aciklama(d.tip)}), {argumanlar.length} değer verildi.", "'{ad}' expects {ps.length} values ({tip_aciklama(d.tip)}), but {argumanlar.length} were given."))
        return e
    }
    var tipli: [parser.Dugum] = []
    repeat i from 1 to argumanlar.length {
        var a = _ifade(argumanlar[i], ps[i])
        if not _tamam() {
            return e
        }
        if not uyumlu_mu(ps[i], a.tip) {
            _hata(argumanlar[i], dil.sec("'{ad}' {i}. değer olarak {tip_aciklama(ps[i])} bekliyor, {tip_aciklama(a.tip)} verildi.", "'{ad}' expects {tip_aciklama(ps[i])} as value {i}, but {tip_aciklama(a.tip)} was given."))
            return e
        }
        tipli.add(a)
    }
    var isim = parser.Dugum(tur: "Isim", deger: ad, ek: "", cocuklar: [], satir: e.satir, sutun: e.sutun, dosya: e.dosya)
    var c2 = e
    c2.tur = "DegerCagrisi"
    return _c(c2, [_t(isim, d.tip), _liste(tipli)], fn_donusu(d.tip))
}

# return'ün tip kontrolü (fonksiyon ya da lambda)
fn _donus_kontrolu(k: parser.Dugum, f: Fonksiyon) -> parser.Dugum {
    if _bos_mu(k.cocuklar[1]) {
        if f.donus is not "void" {
            _hata(k, dil.sec("Bu lambda bir {tip_aciklama(f.donus)} döndürmeli:   return ...", "This lambda must return {tip_aciklama(f.donus)}:   return ..."))
        }
        return k
    }
    if f.donus is "void" {
        _hata(k, dil.sec("Bu lambda'nın dönüş tipi yazılmamış, bu yüzden değer döndüremez.\n   Dönüş tipini yaz:   fn(x: int) -> int \{ ... \}", "This lambda's return type isn't written, so it can't return a value.\n   Write the return type:   fn(x: int) -> int \{ ... \}"))
        return k
    }
    var deger = _ifade(k.cocuklar[1], f.donus)
    if _tamam() and not uyumlu_mu(f.donus, deger.tip) {
        _hata(k.cocuklar[1], dil.sec("Bu lambda {tip_aciklama(f.donus)} döndürmeli, burada {tip_aciklama(deger.tip)} var.", "This lambda must return {tip_aciklama(f.donus)}, but here there is {tip_aciklama(deger.tip)}."))
        return k
    }
    return _c(k, [deger], "")
}

# fn(a, b) => ifade   /   fn(a: int) -> int { ... }
fn _lambda(e: parser.Dugum, beklenen: text) -> parser.Dugum {
    use change LAMBDALAR
    use change YIGIN
    use change AKTIF
    use change PARALEL
    use change ARENA
    use change WHEN
    use change OLCUM
    use change DONGU
    use change HATA_YIGINI
    var parametreler = e.cocuklar[1].cocuklar
    var bek_p: [text] = []
    var bek_d = ""
    if fn_mi(beklenen) {
        bek_p = fn_parametreleri(beklenen)
        bek_d = fn_donusu(beklenen)
        if bek_p.length is not parametreler.length {
            _hata(e, dil.sec("Burada {bek_p.length} değer alan bir fonksiyon bekleniyor ({tip_aciklama(beklenen)}), bu lambda {parametreler.length} değer alıyor.", "A function taking {bek_p.length} values is expected here ({tip_aciklama(beklenen)}), but this lambda takes {parametreler.length}."))
            return e
        }
    }
    var p_adlar: [text] = []
    var p_tipler: [text] = []
    repeat i from 1 to parametreler.length {
        var p = parametreler[i]
        var pt = ""
        if not _bos_mu(p.cocuklar[1]) {
            pt = tip_coz(p.cocuklar[1])
        } else if bek_p.length > 0 and bek_p[i] is not "?" {
            pt = bek_p[i]
        } else {
            _hata(p, dil.sec("Lambda'nın '{p.deger}' parametresinin tipi anlaşılamadı; yaz:   fn({p.deger}: int) => ...", "The type of the lambda's '{p.deger}' parameter couldn't be worked out; write it:   fn({p.deger}: int) => ..."))
            return e
        }
        if not _tamam() {
            return e
        }
        if _icinde_mi(p.deger, p_adlar) {
            _hata(p, dil.sec("'{p.deger}' parametresi iki kere yazılmış.", "The '{p.deger}' parameter is written twice."))
            return e
        }
        if _ara(p.deger) is not none {
            _hata(p, dil.sec("'{p.deger}' adında bir değişken zaten var; lambda parametresine başka bir ad ver.", "There is already a variable named '{p.deger}'; give the lambda parameter a different name."))
            return e
        }
        p_adlar.add(p.deger)
        p_tipler.add(pt)
    }
    var donus = ""
    if not _bos_mu(e.cocuklar[2]) {
        donus = tip_coz(e.cocuklar[2])
        if not _tamam() {
            return e
        }
    } else if e.ek is "blok" {
        donus = "void"
        if bek_d.length > 0 and bek_d is not "?" {
            donus = bek_d
        }
    }
    # lambda'nın kendi bağlamı: içeride return lambda'nın, paralel/arena/when sınırları yok
    var izinler: [text] = AKTIF.izinler
    if FN.length is 0 {
        izinler = IZINLER.keys()                     # ana programda oluşturulan lambda her şeye izinli
        if KUM {
            izinler = IZIN_SINIRI                    # kum havuzunda: sadece verilenler
        }
    }
    var onceki_aktif = AKTIF
    var onceki_sayaclar = [PARALEL, ARENA, WHEN, OLCUM, DONGU]
    var onceki_hata_yigini = HATA_YIGINI
    PARALEL = 0
    ARENA = 0
    WHEN = 0
    OLCUM = 0
    DONGU = 0
    HATA_YIGINI = ["lambda"]
    var bos_adlar: [text] = []
    var bos_tipler: [text] = []
    YIGIN.add({})
    LAMBDALAR.add(LambdaBilgisi(taban: YIGIN.length, adlar: bos_adlar, tipler_: bos_tipler))
    repeat i from 1 to p_adlar.length {
        _koy(Degisken(ad: p_adlar[i], tip: p_tipler[i], tur: "parametre", satir: parametreler[i].satir))
    }
    var govde: [parser.Dugum] = []
    if e.ek is "ifade" {
        var gb = ""
        if donus.length > 0 {
            gb = donus
        } else if bek_d.length > 0 and bek_d is not "?" and bek_d is not "void" {
            gb = bek_d
        }
        var x = _ifade(e.cocuklar[3], gb)
        if _tamam() {
            if donus.length is 0 {
                donus = x.tip
                if bek_d.length > 0 and bek_d is not "?" and bek_d is not "void" and uyumlu_mu(bek_d, x.tip) {
                    donus = bek_d
                }
                if bek_d is "void" {
                    donus = "void"
                }
            }
            if donus is "void" {
                if x.tur is not "Cagri" and x.tur is not "MetotCagrisi" and x.tur is not "DegerCagrisi" and x.tur is not "Dene" and x.tip is not "void" {
                    _hata(e.cocuklar[3], dil.sec("Bu lambda değer döndürmemeli, ama '=>' sonrası bir değer hesaplıyor.", "This lambda shouldn't return a value, but the part after '=>' computes one."))
                }
                govde.add(parser.Dugum(tur: "IfadeKomutu", deger: "", ek: "", cocuklar: [x], satir: x.satir, sutun: x.sutun, dosya: x.dosya))
            } else {
                if not uyumlu_mu(donus, x.tip) {
                    _hata(e.cocuklar[3], dil.sec("Bu lambda {tip_aciklama(donus)} döndürmeli, burada {tip_aciklama(x.tip)} var.", "This lambda must return {tip_aciklama(donus)}, but here there is {tip_aciklama(x.tip)}."))
                }
                govde.add(parser.Dugum(tur: "Donus", deger: "", ek: "", cocuklar: [x], satir: x.satir, sutun: x.sutun, dosya: x.dosya))
            }
        }
    } else {
        AKTIF = Fonksiyon(ad: "lambda", p_adlar: p_adlar, p_tipler: p_tipler, donus: donus, satir: e.satir, izinler: izinler)
        var komutlar = e.cocuklar[3].cocuklar
        repeat i from 1 to komutlar.length {
            govde.add(_komut(komutlar[i]))
            if not _tamam() {
                stop
            }
        }
        if _tamam() and donus is not "void" and not her_zaman_doner_mu(komutlar) {
            _hata(e, dil.sec("Bu lambda bir {tip_aciklama(donus)} döndürmeli, ama her durumda 'return' ile bitmiyor.", "This lambda must return {tip_aciklama(donus)}, but it doesn't always end with 'return'."))
        }
    }
    var bilgi = LAMBDALAR[LAMBDALAR.length]
    LAMBDALAR.remove(LAMBDALAR.length)
    YIGIN.remove(YIGIN.length)
    AKTIF = onceki_aktif
    PARALEL = onceki_sayaclar[1]
    ARENA = onceki_sayaclar[2]
    WHEN = onceki_sayaclar[3]
    OLCUM = onceki_sayaclar[4]
    DONGU = onceki_sayaclar[5]
    HATA_YIGINI = onceki_hata_yigini
    if not _tamam() {
        return e
    }
    var tipli_p: [parser.Dugum] = []
    repeat i from 1 to parametreler.length {
        tipli_p.add(_t(parametreler[i], p_tipler[i]))
    }
    var yakalananlar: [parser.Dugum] = []
    repeat i from 1 to bilgi.adlar.length {
        yakalananlar.add(_t(parser.Dugum(tur: "Isim", deger: bilgi.adlar[i], ek: "", cocuklar: [], satir: e.satir, sutun: e.sutun, dosya: e.dosya), bilgi.tipler_[i]))
    }
    return _c(e, [_liste(tipli_p), _liste(govde), _liste(yakalananlar)], "fn({p_tipler.join(",")})->{donus}")
}

# =====================================================================
#  GENERIC: fn ilk[T](l: [T]) -> T  — kullanılan her tip için ayrı bir kopya (ilk[int], ilk[text] ...)
# =====================================================================
fn _generik_kaydet(f: parser.Dugum) {
    use change GENERIKLER
    var ad = f.deger
    if FONKSIYONLAR.has(ad) or GENERIKLER.has(ad) {
        _hata(f, dil.sec("'{ad}' adında bir fonksiyon zaten var.", "There is already a function named '{ad}'."))
        return
    }
    if TIPLER.has(ad) {
        _hata(f, dil.sec("'{ad}' bir tipin adı; fonksiyona aynı ad verilemez.", "'{ad}' is the name of a type; a function can't have the same name."))
        return
    }
    var tp = f.cocuklar[4].cocuklar
    var adlar: [text] = []
    repeat i from 1 to tp.length {
        if _icinde_mi(tp[i].deger, adlar) {
            _hata(tp[i], dil.sec("'{tp[i].deger}' tip parametresi iki kere yazılmış.", "The type parameter '{tp[i].deger}' is written twice."))
            return
        }
        if TIP_ADLARI.has(tp[i].deger) or TIPLER.has(tp[i].deger) or ENUMLAR.has(tp[i].deger) {
            _hata(tp[i], dil.sec("'{tp[i].deger}' zaten bir tipin adı; tip parametresine başka bir ad ver (ör: T).", "'{tp[i].deger}' is already the name of a type; give the type parameter a different name (e.g. T)."))
            return
        }
        adlar.add(tp[i].deger)
    }
    GENERIKLER[ad] = f
}

# Generic tipin bu tipler için kopyası (yoksa üret): Kutu + [int] → "Kutu[int]"
fn _generik_tip_ornegi(ad: text, argumanlar: [text]) -> text {
    use change TIPLER
    use change TIP_YERINE
    use change TIP_ORNEKLERI
    var ornek = "{ad}[{argumanlar.join(", ")}]"
    if TIPLER.has(ornek) {
        return ornek
    }
    var tanim = GENERIK_TIPLER[ad]
    var tp = tanim.cocuklar[3].cocuklar
    var yerine: {text: text} = {}
    repeat i from 1 to tp.length {
        yerine[tp[i].deger] = argumanlar[i]
    }
    TIPLER[ornek] = TipBilgisi(ad: ornek, satir: tanim.satir, alan_adlari: [], alan_tipleri: [], alan_varsayilanli: [], alan_satirlari: [], metotlar: {})
    var onceki = TIP_YERINE
    TIP_YERINE = yerine
    var kopya = parser.Dugum(tur: "TipTanimi", deger: ornek, ek: "", cocuklar: [tanim.cocuklar[1], tanim.cocuklar[2]], satir: tanim.satir, sutun: tanim.sutun, dosya: tanim.dosya)
    var tipli = _tip_ayrintilari(kopya)
    TIP_YERINE = onceki
    TIP_ORNEKLERI.add(TipOrnegi(ad: ornek, tipli: tipli, yerine: yerine))
    return ornek
}

# Kutu(deger: 5): içindekinin tipi verilen değerlerden (ya da beklenen tipten) anlaşılır
fn _generik_olusturma(e: parser.Dugum, beklenen: text) -> parser.Dugum {
    var ad = e.deger
    var c2 = e
    if beklenen.starts_with("{ad}[") and TIPLER.has(_soru_siz_ise(beklenen)) {
        c2.deger = _soru_siz_ise(beklenen)
        return _olusturma(c2)
    }
    var tanim = GENERIK_TIPLER[ad]
    var tparams: [text] = []
    var tp = tanim.cocuklar[3].cocuklar
    repeat i from 1 to tp.length {
        tparams.add(tp[i].deger)
    }
    var alanlar = tanim.cocuklar[1].cocuklar
    var isimli = e.cocuklar[2].cocuklar
    var baglar: {text: text} = {}
    repeat i from 1 to isimli.length {
        repeat j from 1 to alanlar.length {
            if alanlar[j].deger is isimli[i].deger {
                var g = _ifade(isimli[i].cocuklar[1], "")
                if not _tamam() {
                    return e
                }
                baglar = _esle(alanlar[j].cocuklar[1], g.tip, tparams, baglar)
            }
        }
    }
    var tipler_: [text] = []
    repeat i from 1 to tparams.length {
        if not baglar.has(tparams[i]) {
            _hata(e, dil.sec("'{ad}' oluşturulurken '{tparams[i]}' tipinin ne olduğu anlaşılamadı; tipi yaz:\n   var x: {ad}[int] = {ad}(...)", "When creating '{ad}', the type '{tparams[i]}' couldn't be worked out; write the type:\n   var x: {ad}[int] = {ad}(...)"))
            return e
        }
        tipler_.add(baglar[tparams[i]])
    }
    c2.deger = _generik_tip_ornegi(ad, tipler_)
    if not _tamam() {
        return e
    }
    return _olusturma(c2)
}

fn _soru_siz_ise(t: text) -> text {
    if secmeli_mi(t) {
        return _soru_siz(t)
    }
    return t
}

# Parametre tipi (tipsiz ağaç) ile gelen değerin tipini eşleştirip T'lerin karşılığını bul
fn _esle(t: parser.Dugum, gelen: text, tparams: [text], baglar: {text: text}) -> {text: text} {
    var b = baglar
    if gelen is "[?]" or gelen is "\{?\}" or gelen is "none" or gelen is "?" {
        return b                                     # boş liste / none: bir şey söylemiyor
    }
    if t.tur is "TipAdi" and _icinde_mi(t.deger, tparams) {
        if b.has(t.deger) {
            if b[t.deger] is "int" and gelen is "float" {
                b[t.deger] = "float"                 # 1 ve 2.5 birlikte: float
            }
            return b
        }
        b[t.deger] = gelen
        return b
    }
    if t.tur is "ListeTipi" and liste_mi(gelen) {
        return _esle(t.cocuklar[1], _ic(gelen), tparams, b)
    }
    if t.tur is "SozlukTipi" and sozluk_mu(gelen) {
        b = _esle(t.cocuklar[1], _sozluk_anahtar(gelen), tparams, b)
        return _esle(t.cocuklar[2], _sozluk_deger(gelen), tparams, b)
    }
    if t.tur is "SecmeliTip" {
        if secmeli_mi(gelen) {
            return _esle(t.cocuklar[1], _soru_siz(gelen), tparams, b)
        }
        return _esle(t.cocuklar[1], gelen, tparams, b)
    }
    if t.tur is "IsTipi" and gelen.starts_with("task[") and t.cocuklar.length > 0 {
        return _esle(t.cocuklar[1], gelen[6 to gelen.length - 1], tparams, b)
    }
    if t.tur is "KanalTipi" and gelen.starts_with("channel[") {
        return _esle(t.cocuklar[1], gelen[9 to gelen.length - 1], tparams, b)
    }
    if t.tur is "GenerikTip" and gelen.starts_with("{t.deger}[") {
        var icler = _tip_argumanlarini_ayir(gelen[t.deger.length + 2 to gelen.length - 1])
        repeat i from 1 to t.cocuklar.length {
            if i <= icler.length {
                b = _esle(t.cocuklar[i], icler[i], tparams, b)
            }
        }
    }
    return b
}

# "int, [text], Kutu[int, bool]" → ["int", "[text]", "Kutu[int, bool]"] (iç içe parantezlere dikkat ederek)
fn _tip_argumanlarini_ayir(t: text) -> [text] {
    var sonuc: [text] = []
    var derinlik = 0
    var bas = 1
    repeat i from 1 to t.length {
        var h = t[i]
        if h is "[" or h is "\{" or h is "(" {
            derinlik = derinlik + 1
        } else if h is "]" or h is "\}" or h is ")" {
            derinlik = derinlik - 1
        } else if h is "," and derinlik is 0 {
            sonuc.add(t[bas to i - 1].trim())
            bas = i + 1
        }
    }
    if bas <= t.length {
        sonuc.add(t[bas to t.length].trim())
    }
    return sonuc
}

fn _generik_cagri(e: parser.Dugum, beklenen: text, izin: text) -> parser.Dugum {
    use change FONKSIYONLAR
    use change ORNEKLER
    use change TIP_YERINE
    use change SON_IZIN
    var ad = e.deger
    var tanim = GENERIKLER[ad]
    var tparams: [text] = []
    var tp = tanim.cocuklar[4].cocuklar
    repeat i from 1 to tp.length {
        tparams.add(tp[i].deger)
    }
    var parametreler = tanim.cocuklar[1].cocuklar
    var argumanlar = e.cocuklar[1].cocuklar
    if e.cocuklar[2].cocuklar.length > 0 {
        _hata(e, dil.sec("'{ad}(...)' bir fonksiyon; değerler adlarıyla (ad: değer) verilemez, sırayla yazılır.", "'{ad}(...)' is a function; values can't be given by name (name: value), they are written in order."))
        return e
    }
    if argumanlar.length is not parametreler.length {
        _hata(e, dil.sec("'{ad}' {parametreler.length} değer bekliyor, {argumanlar.length} değer verildi.", "'{ad}' expects {parametreler.length} values, but {argumanlar.length} were given."))
        return e
    }
    var baglar: {text: text} = {}
    repeat i from 1 to argumanlar.length {
        var a = _ifade(argumanlar[i], "")
        if not _tamam() {
            return e
        }
        baglar = _esle(parametreler[i].cocuklar[1], a.tip, tparams, baglar)
    }
    var tipler_: [text] = []
    repeat i from 1 to tparams.length {
        if not baglar.has(tparams[i]) {
            _hata(e, dil.sec("'{ad}' çağrısında '{tparams[i]}' tipinin ne olduğu değerlerden anlaşılamadı.\n   (Boş liste [] ya da none tek başına bir şey söylemez; tipi belli bir değişken ver.)", "In the call to '{ad}', the type '{tparams[i]}' couldn't be worked out from the values.\n   (An empty list [] or none alone says nothing; pass a variable with a known type.)"))
            return e
        }
        tipler_.add(baglar[tparams[i]])
    }
    var kopya_adi = "{ad}[{tipler_.join(", ")}]"
    if not FONKSIYONLAR.has(kopya_adi) {
        var onceki = TIP_YERINE
        TIP_YERINE = baglar
        var f = _imza_olustur(tanim)
        TIP_YERINE = onceki
        if not _tamam() {
            return e
        }
        f.ad = kopya_adi
        FONKSIYONLAR[kopya_adi] = f
        ORNEKLER.add(Ornek(ad: kopya_adi, tanim: tanim, yerine: baglar))
    }
    var c2 = e
    c2.deger = kopya_adi
    SON_IZIN = izin
    return _cagri(c2, beklenen)
}

# =====================================================================
#  HATALAR: fails · fail · try · do/catch · else:
# =====================================================================
fn _baglam_ac(tur: text) {
    use change HATA_YIGINI
    HATA_YIGINI.add(tur)
}

fn _baglam_kapat() {
    use change HATA_YIGINI
    if HATA_YIGINI.length > 0 {
        HATA_YIGINI.remove(HATA_YIGINI.length)
    }
}

# Hata verebilen bir çağrı: ya try ya da else: ile ele alınmalı
fn _hata_cagrisi(e: parser.Dugum, f: Fonksiyon, izin: text) {
    use change HATA_ELE_ALINDI
    if not f.hata_verir {
        return
    }
    if izin.length is 0 {
        _hata(e, dil.sec("'{f.ad}' hata verebilir (fails); hatayı ele al:\n   var x = try {f.ad}(...)          (hata olursa yukarı iletir ya da catch'e atar)\n   var x = {f.ad}(...) else: yedek  (hata olursa yedek değer)", "'{f.ad}' can fail (fails); handle the error:\n   var x = try {f.ad}(...)             (on error, passes it up or jumps to catch)\n   var x = {f.ad}(...) else: fallback  (on error, uses the fallback value)"))
        return
    }
    HATA_ELE_ALINDI = true
}

# try / fail ile çıkan hata nereye gider? Önce en yakın do/catch'e; yoksa fonksiyonun dışına.
fn _hata_iletimi_kontrol(e: parser.Dugum, kelime: text) {
    repeat i from HATA_YIGINI.length to 1 step -1 {
        if HATA_YIGINI[i] is "lambda" {
            _hata(e, dil.sec("'{kelime}' ile çıkan hata lambda'nın dışına iletilemez; lambda'nın içinde yakala:\n   do \{ ... \} catch hata \{ ... \}", "An error from '{kelime}' can't be passed outside a lambda; catch it inside the lambda:\n   do \{ ... \} catch error \{ ... \}"))
            return
        }
        var b = HATA_YIGINI[i]
        if b is "do" {
            return                                   # burada yakalanıyor
        }
        if b is "parallel" or b is "arena" or b is "when" {
            _hata(e, dil.sec("'{kelime}' ile çıkan hata bir {b} bloğunun dışına iletilemez; bloğun içinde yakala:\n   do \{ ... \} catch hata \{ ... \}", "An error from '{kelime}' can't be passed outside a {b} block; catch it inside the block:\n   do \{ ... \} catch error \{ ... \}"))
            return
        }
        if b is "fn" {
            stop
        }
    }
    if FN.length is 0 {
        return                                       # ana program: yakalanmazsa program anlaşılır bir mesajla durur
    }
    if not AKTIF.hata_verir {
        _hata(e, dil.sec("'{FN}' içinde '{kelime}' ile çıkan hata yakalanmıyor, ama '{FN}' hata verebilen (fails) bir fonksiyon değil.\n   Ya hatayı yakala:   do \{ ... \} catch hata \{ ... \}\n   ya da fonksiyonu işaretle:   fn {FN}(...) -> ... fails \{", "An error from '{kelime}' in '{FN}' isn't caught, but '{FN}' isn't a function that can fail (fails).\n   Either catch the error:   do \{ ... \} catch error \{ ... \}\n   or mark the function:   fn {FN}(...) -> ... fails \{"))
    }
}

# try f(...): f hata verirse en yakın catch'e ya da yukarı
fn _dene(e: parser.Dugum, beklenen: text) -> parser.Dugum {
    use change HATA_IZNI
    use change HATA_ELE_ALINDI
    HATA_IZNI = "try"
    HATA_ELE_ALINDI = false
    var c = _ifade(e.cocuklar[1], beklenen)
    HATA_IZNI = ""
    if not _tamam() {
        return e
    }
    if not HATA_ELE_ALINDI {
        _hata(e, dil.sec("'try' sadece hata verebilen (fails) bir fonksiyon çağrısının önüne yazılır.", "'try' is only written before a call to a function that can fail (fails)."))
        return e
    }
    HATA_ELE_ALINDI = false
    _hata_iletimi_kontrol(e, "try")
    if not _tamam() {
        return e
    }
    return _c(e, [c], c.tip)
}

# fail "mesaj"
fn _hata_ver_komutu(k: parser.Dugum) -> parser.Dugum {
    var m = _ifade(k.cocuklar[1], "text")
    if not _tamam() {
        return k
    }
    if m.tip is not "text" {
        _hata(k.cocuklar[1], dil.sec("'fail' bir metin (hata mesajı) bekler, burada {tip_aciklama(m.tip)} var:   fail \"dosya bulunamadı\"", "'fail' expects text (the error message), but here there is {tip_aciklama(m.tip)}:   fail \"file not found\""))
        return k
    }
    _hata_iletimi_kontrol(k, "fail")
    if not _tamam() {
        return k
    }
    return _c(k, [m], "")
}

# do { ... } catch hata { ... }
fn _yakala_komutu(k: parser.Dugum) -> parser.Dugum {
    _baglam_ac("do")
    var govde = _blok(k.cocuklar[1].cocuklar, none, [])
    _baglam_kapat()
    if not _tamam() {
        return k
    }
    if _ara(k.deger) is not none {
        _hata(k, dil.sec("'{k.deger}' adında bir değişken zaten var; yakalanan hataya başka bir ad ver:   catch hata2", "There is already a variable named '{k.deger}'; give the caught error a different name:   catch error2"))
        return k
    }
    var hata_degiskeni = Degisken(ad: k.deger, tip: "text", tur: "yerel", satir: k.satir)
    var yakalama = _blok(k.cocuklar[2].cocuklar, hata_degiskeni, [])
    if not _tamam() {
        return k
    }
    return _c(k, [_liste(govde), _liste(yakalama)], "")
}

# bytes: add(x) · add_int(sayi, boyut) · get_int(sira, boyut) · to_text()
fn _bayt_metodu(e: parser.Dugum, n: parser.Dugum) -> parser.Dugum {
    var ad = e.deger
    var argumanlar = e.cocuklar[2].cocuklar
    var ornekler = {"add": "veri.add(255)", "add_int": "veri.add_int(1000, 4)", "get_int": "veri.get_int(1, 4)", "to_text": "veri.to_text()"}
    if not ornekler.has(ad) {
        if ad is "length" {
            _hata(e, dil.sec("'length' bir özellik; parantez olmadan yaz:   veri.length", "'length' is a property; write it without parentheses:   data.length"))
        } else {
            _hata(e, dil.sec("Baytların '{ad}' diye bir işi yok.{oneri.oneri(ad, ornekler.keys())}", "Bytes have no method called '{ad}'.{oneri.oneri(ad, ornekler.keys())}"))
        }
        return e
    }
    if e.cocuklar[4].cocuklar.length > 0 {
        _hata(e, dil.sec("'.{ad}' değerleri adlarıyla (ad: değer) almaz:   {ornekler[ad]}", "'.{ad}' doesn't take values by name (name: value):   {ornekler[ad]}"))
        return e
    }
    var beklenen = 0
    if ad is "add" {
        beklenen = 1
    } else if ad is "add_int" or ad is "get_int" {
        beklenen = 2
    }
    if argumanlar.length is not beklenen {
        _hata(e, dil.sec("'.{ad}' {beklenen} değer bekliyor, {argumanlar.length} değer verildi.   Örnek:   {ornekler[ad]}", "'.{ad}' expects {beklenen} value(s), but {argumanlar.length} values were given.   Example:   {ornekler[ad]}"))
        return e
    }
    if ad is "add" or ad is "add_int" {              # baytları değiştiriyor: değişken değiştirilebilir olmalı
        var d = liste_degiskeni_olmali(n, "'.{ad}(...)'")
        if not _tamam() or d.tip is not "bytes" {
            return e
        }
    }
    var tipli: [parser.Dugum] = []
    repeat i from 1 to argumanlar.length {
        var a = _ifade(argumanlar[i], "")
        if not _tamam() {
            return e
        }
        if a.tip is not "int" {
            _hata(argumanlar[i], dil.sec("'.{ad}' tam sayı (int) bekliyor, burada {tip_aciklama(a.tip)} var.   Örnek:   {ornekler[ad]}", "'.{ad}' expects an integer (int), but here there is {tip_aciklama(a.tip)}.   Example:   {ornekler[ad]}"))
            return e
        }
        tipli.add(a)
    }
    var donus = "void"
    if ad is "get_int" {
        donus = "int"
    } else if ad is "to_text" {
        donus = "text"
    }
    return _c(e, [n, _liste(tipli), e.cocuklar[3], e.cocuklar[4]], donus)
}

# liste.map(f) · filter(f) · any(f) · all(f) · count(f) · find(f) / find(f, else: v)
fn _liste_lambda_metodu(e: parser.Dugum, n: parser.Dugum, t: text) -> parser.Dugum {
    var ad = e.deger
    var eleman = _ic(t)
    var argumanlar = e.cocuklar[2].cocuklar
    var yedek = e.cocuklar[3]
    var ornekler = {"map": "sayilar.map(fn(x) => x * 2)", "filter": "sayilar.filter(fn(x) => x > 2)", "any": "sayilar.any(fn(x) => x > 3)", "all": "sayilar.all(fn(x) => x > 0)", "count": "sayilar.count(fn(x) => x % 2 is 0)", "find": "sayilar.find(fn(x) => x > 2, else: 0)"}
    if argumanlar.length is not 1 or e.cocuklar[4].cocuklar.length > 0 {
        _hata(e, dil.sec("'.{ad}' tek bir fonksiyon (lambda) bekler:   {ornekler[ad]}", "'.{ad}' expects a single function (lambda):   {ornekler[ad]}"))
        return e
    }
    if ad is not "find" and not _bos_mu(yedek) {
        _hata(yedek, dil.sec("'else:' sadece '.find' ile kullanılır.", "'else:' is only used with '.find'."))
        return e
    }
    var beklenen_f = "fn({eleman})->bool"
    if ad is "map" {
        beklenen_f = "fn({eleman})->?"
    }
    var f = _ifade(argumanlar[1], beklenen_f)
    if not _tamam() {
        return e
    }
    var dogru = false
    if fn_mi(f.tip) {
        var fps = fn_parametreleri(f.tip)
        if fps.length is 1 {
            dogru = fps[1] is eleman
        }
    }
    if dogru and ad is not "map" {
        dogru = fn_donusu(f.tip) is "bool"
    }
    if dogru and ad is "map" {
        dogru = fn_donusu(f.tip) is not "void"
    }
    if not dogru {
        var istenen = dil.sec("bir eleman ({tip_aciklama(eleman)}) alıp bool döndüren bir fonksiyon", "a function that takes one element ({tip_aciklama(eleman)}) and returns bool")
        if ad is "map" {
            istenen = dil.sec("bir eleman ({tip_aciklama(eleman)}) alıp yeni bir değer döndüren bir fonksiyon", "a function that takes one element ({tip_aciklama(eleman)}) and returns a new value")
        }
        _hata(argumanlar[1], dil.sec("'.{ad}' {istenen} bekler, burada {tip_aciklama(f.tip)} var.   Örnek:   {ornekler[ad]}", "'.{ad}' expects {istenen}, but here there is {tip_aciklama(f.tip)}.   Example:   {ornekler[ad]}"))
        return e
    }
    var sonuc_tipi = "bool"
    if ad is "map" {
        sonuc_tipi = "[{fn_donusu(f.tip)}]"
    } else if ad is "filter" {
        sonuc_tipi = t
    } else if ad is "count" {
        sonuc_tipi = "int"
    } else if ad is "find" {
        if _bos_mu(yedek) {
            if eleman is "int" or eleman is "float" or eleman is "bool" or eleman.starts_with("task[") or eleman.starts_with("channel[") or secmeli_mi(eleman) {
                _hata(e, dil.sec("'.find' bulamazsa none döner, ama {tip_aciklama(eleman)} none olamaz; bir yedek değer ver:   {ornekler[ad]}", "'.find' returns none when nothing matches, but {tip_aciklama(eleman)} can't be none; give a fallback value:   {ornekler[ad]}"))
                return e
            }
            sonuc_tipi = "{eleman}?"
        } else {
            var y = _ifade(yedek, eleman)
            if not _tamam() {
                return e
            }
            if not uyumlu_mu(eleman, y.tip) {
                _hata(yedek, dil.sec("Yedek değer listenin elemanlarıyla aynı tipte olmalı ({tip_aciklama(eleman)}), burada {tip_aciklama(y.tip)} var.", "The fallback value must have the same type as the list's elements ({tip_aciklama(eleman)}), but here there is {tip_aciklama(y.tip)}."))
                return e
            }
            yedek = y
            sonuc_tipi = eleman
        }
    }
    var sonuc = _c(e, [n, _liste([f]), yedek, e.cocuklar[4]], sonuc_tipi)
    sonuc.ek = "lambda"
    return sonuc
}

# liste.sort()  /  liste.sort(by: once_mi)   — once_mi(a, b) -> bool: "a, b'den önce mi gelmeli?"
fn _liste_sirala(e: parser.Dugum, n: parser.Dugum, t: text) -> parser.Dugum {
    var d = liste_degiskeni_olmali(n, "'.sort()'")
    if not _tamam() {
        return e
    }
    var eleman_tipi = _ic(d.tip)
    var argumanlar = e.cocuklar[2].cocuklar
    var isimli = e.cocuklar[4].cocuklar
    if argumanlar.length > 0 or isimli.length > 1 or (isimli.length is 1 and isimli[1].deger is not "by") {
        _hata(e, dil.sec("'.sort' ya boş yazılır ya da sıralama fonksiyonuyla:   liste.sort()   liste.sort(by: once_mi)", "'.sort' is written either empty or with a sorting function:   list.sort()   list.sort(by: comes_first)"))
        return e
    }
    if isimli.length is 0 {
        if not _icinde_mi(eleman_tipi, ["int", "float", "text", "bool"]) {
            _hata(e, dil.sec("Bu liste {tip_aciklama(eleman_tipi)} tutuyor; hangisinin önce geleceğini bir fonksiyonla söyle:\n   fn once_mi(a: {eleman_tipi}, b: {eleman_tipi}) -> bool \{ ... \}\n   {n.deger}.sort(by: once_mi)", "This list holds {tip_aciklama(eleman_tipi)}; tell which one comes first with a function:\n   fn comes_first(a: {eleman_tipi}, b: {eleman_tipi}) -> bool \{ ... \}\n   {n.deger}.sort(by: comes_first)"))
            return e
        }
        return _c(e, [n, _liste([]), e.cocuklar[3], e.cocuklar[4]], "void")
    }
    var f_dugum = isimli[1].cocuklar[1]
    var ornek = dil.sec("fn once_mi(a: {eleman_tipi}, b: {eleman_tipi}) -> bool", "fn comes_first(a: {eleman_tipi}, b: {eleman_tipi}) -> bool")
    if not (f_dugum.tur is "Isim" and FONKSIYONLAR.has(f_dugum.deger)) {     # lambda ya da fonksiyon değeri
        var beklenen_f = "fn({eleman_tipi},{eleman_tipi})->bool"
        var kf = _ifade(f_dugum, beklenen_f)
        if not _tamam() {
            return e
        }
        if kf.tip is not beklenen_f {
            _hata(f_dugum, dil.sec("'by:' iki eleman alıp bool döndüren bir fonksiyon bekler ({tip_aciklama(beklenen_f)}), burada {tip_aciklama(kf.tip)} var:\n   liste.sort(by: fn(a, b) => a < b)", "'by:' expects a function that takes two elements and returns bool ({tip_aciklama(beklenen_f)}), but here there is {tip_aciklama(kf.tip)}:\n   list.sort(by: fn(a, b) => a < b)"))
            return e
        }
        var yeni_isimli = isimli[1]
        yeni_isimli.cocuklar = [kf]
        var sk = _c(e, [n, _liste([]), e.cocuklar[3], _liste([yeni_isimli])], "void")
        sk.ek = "kapanis"
        return sk
    }
    if FONKSIYONLAR[f_dugum.deger].c_mi {
        _hata(f_dugum, dil.sec("'by:' bir fonksiyonun adını bekler (parantezsiz), şöyle bir fonksiyon:\n   {ornek}", "'by:' expects the name of a function (without parentheses), a function like this:\n   {ornek}"))
        return e
    }
    var f = FONKSIYONLAR[f_dugum.deger]
    if f.p_tipler.length is not 2 or f.p_tipler[1] is not eleman_tipi or f.p_tipler[2] is not eleman_tipi or f.donus is not "bool" {
        _hata(f_dugum, dil.sec("'{f_dugum.deger}' sıralama için uygun değil; iki eleman alıp bool döndürmeli:\n   {ornek}", "'{f_dugum.deger}' isn't suitable for sorting; it must take two elements and return bool:\n   {ornek}"))
        return e
    }
    _izin_kontrol(e, f)
    return _c(e, [n, _liste([]), e.cocuklar[3], e.cocuklar[4]], "void")
}

# ---------- Sözlükler ----------
fn _sozluk_anahtari(t: text, anahtar: parser.Dugum) -> parser.Dugum {
    var anahtar_tipi = _sozluk_anahtar(t)
    var a = _ifade(anahtar, "")
    if _tamam() and a.tip is not anahtar_tipi {
        _hata(anahtar, dil.sec("Bu sözlüğün anahtarları {tip_aciklama(anahtar_tipi)}, burada {tip_aciklama(a.tip)} var.", "This dictionary's keys are {tip_aciklama(anahtar_tipi)}, but here there is {tip_aciklama(a.tip)}."))
    }
    return a
}

fn _sozluk_metodu(e: parser.Dugum, n: parser.Dugum, t: text) -> parser.Dugum {
    var ad = e.deger
    if not _icinde_mi(ad, SOZLUK_METOTLARI) {
        if ad is "length" {
            _hata(e, dil.sec("'length' bir özellik; parantez olmadan yaz:   sozluk.length", "'length' is a property; write it without parentheses:   scores.length"))
        } else {
            _hata(e, dil.sec("Sözlüklerin '{ad}' diye bir işi yok.{oneri.oneri(ad, SOZLUK_METOTLARI)}", "Dictionaries have no method called '{ad}'.{oneri.oneri(ad, SOZLUK_METOTLARI)}"))
        }
        return e
    }
    var anahtar_tipi = _sozluk_anahtar(t)
    var deger_tipi = _sozluk_deger(t)
    var argumanlar = e.cocuklar[2].cocuklar
    var arg_sayisi = 1
    if ad is "keys" or ad is "values" {
        arg_sayisi = 0
    }
    if argumanlar.length is not arg_sayisi {
        var ornek = dil.sec("notlar.{ad}()", "scores.{ad}()")
        if ad is "get" { ornek = dil.sec("notlar.get(\"Can\", else: 0)", "scores.get(\"Can\", else: 0)") }
        if ad is "has" { ornek = dil.sec("notlar.has(\"Ali\")", "scores.has(\"Ali\")") }
        if ad is "remove" { ornek = dil.sec("notlar.remove(\"Ali\")", "scores.remove(\"Ali\")") }
        _hata(e, dil.sec("'.{ad}' {arg_sayisi} değer bekliyor, {argumanlar.length} verildi.   Örnek:   {ornek}", "'.{ad}' expects {arg_sayisi} value(s), but {argumanlar.length} were given.   Example:   {ornek}"))
        return e
    }
    var yedek = e.cocuklar[3]
    if ad is "get" {
        if _bos_mu(yedek) {
            _hata(e, dil.sec("'.get' anahtar yoksa ne döneceğini de ister:   notlar.get(\"Can\", else: 0)\n   (Anahtarın kesin olduğunu biliyorsan doğrudan:   notlar[\"Ali\"])", "'.get' also needs to know what to return if the key is missing:   scores.get(\"Can\", else: 0)\n   (If you know for sure the key exists, use it directly:   scores[\"Ali\"])"))
            return e
        }
        yedek = _ifade(yedek, deger_tipi)
        if _tamam() and not uyumlu_mu(deger_tipi, yedek.tip) {
            _hata(e.cocuklar[3], dil.sec("Yedek değer sözlüğün değerleriyle aynı tipte olmalı ({tip_aciklama(deger_tipi)}), burada {tip_aciklama(yedek.tip)} var.", "The fallback value must have the same type as the dictionary's values ({tip_aciklama(deger_tipi)}), but here there is {tip_aciklama(yedek.tip)}."))
            return e
        }
    } else if not _bos_mu(yedek) {
        _hata(yedek, dil.sec("'else:' sadece '.get' ile kullanılır.", "'else:' is only used with '.get'."))
        return e
    }
    var tipli: [parser.Dugum] = []
    if ad is "get" or ad is "has" or ad is "remove" {
        tipli.add(_sozluk_anahtari(t, argumanlar[1]))
        if not _tamam() {
            return e
        }
    }
    if ad is "remove" {
        sozluk_degiskeni_olmali(n, "'.remove(...)'")
        if not _tamam() {
            return e
        }
    }
    var donus = deger_tipi
    if ad is "has" { donus = "bool" }
    if ad is "remove" { donus = "void" }
    if ad is "keys" { donus = "[{anahtar_tipi}]" }
    if ad is "values" { donus = "[{deger_tipi}]" }
    return _c(e, [n, _liste(tipli), yedek, e.cocuklar[4]], donus)
}

fn _sozluk_degeri(e: parser.Dugum, beklenen: text) -> parser.Dugum {
    var anahtarlar = e.cocuklar[1].cocuklar
    var degerler = e.cocuklar[2].cocuklar
    if anahtarlar.length is 0 {
        if sozluk_mu(beklenen) {
            return _t(e, beklenen)
        }
        return _t(e, "\{?\}")
    }
    var b_anahtar = ""
    var b_deger = ""
    if sozluk_mu(beklenen) {
        b_anahtar = _sozluk_anahtar(beklenen)
        b_deger = _sozluk_deger(beklenen)
    }
    var tipli_a: [parser.Dugum] = []
    var ilk = _ifade(anahtarlar[1], b_anahtar)
    if not _tamam() {
        return e
    }
    var anahtar_tipi = ilk.tip
    if anahtar_tipi is not "text" and anahtar_tipi is not "int" {
        _hata(anahtarlar[1], dil.sec("Sözlüğün anahtarı şimdilik text ya da int olabilir, burada {tip_aciklama(anahtar_tipi)} var.", "A dictionary key can currently be text or int, but here there is {tip_aciklama(anahtar_tipi)}."))
        return e
    }
    tipli_a.add(ilk)
    repeat i from 2 to anahtarlar.length {
        var a = _ifade(anahtarlar[i], b_anahtar)
        if not _tamam() {
            return e
        }
        if a.tip is not anahtar_tipi {
            _hata(anahtarlar[i], dil.sec("Bir sözlükteki bütün anahtarlar aynı tipte olmalı. İlki {tip_aciklama(anahtar_tipi)}, bu ise {tip_aciklama(a.tip)}.", "All keys in a dictionary must have the same type. The first is {tip_aciklama(anahtar_tipi)}, but this one is {tip_aciklama(a.tip)}."))
            return e
        }
        tipli_a.add(a)
    }
    var tipli_d: [parser.Dugum] = []
    var hepsi_sayi = true
    var ondalik_var = false
    repeat i from 1 to degerler.length {
        var d = _ifade(degerler[i], b_deger)
        if not _tamam() {
            return e
        }
        tipli_d.add(d)
        if not sayisal_mi(d.tip) {
            hepsi_sayi = false
        }
        if d.tip is "float" {
            ondalik_var = true
        }
    }
    var ortak = tipli_d[1].tip
    if hepsi_sayi {
        ortak = "int"
        if ondalik_var {
            ortak = "float"
        }
    } else {
        repeat i from 1 to tipli_d.length {
            if tipli_d[i].tip is not ortak {
                _hata(degerler[i], dil.sec("Bir sözlükteki bütün değerler aynı tipte olmalı. İlki {tip_aciklama(ortak)}, bu ise {tip_aciklama(tipli_d[i].tip)}.", "All values in a dictionary must have the same type. The first is {tip_aciklama(ortak)}, but this one is {tip_aciklama(tipli_d[i].tip)}."))
                return e
            }
        }
    }
    if b_deger.length > 0 and uyumlu_mu(b_deger, ortak) {
        ortak = b_deger
    }
    return _c(e, [_liste(tipli_a), _liste(tipli_d)], "\{{anahtar_tipi}:{ortak}\}")
}

fn _liste_degeri(e: parser.Dugum, beklenen: text) -> parser.Dugum {
    if e.cocuklar.length is 0 {
        if liste_mi(beklenen) {
            return _t(e, beklenen)
        }
        return _t(e, "[?]")
    }
    var eleman_beklenen = ""
    if liste_mi(beklenen) {
        eleman_beklenen = _ic(beklenen)
    }
    var tipli: [parser.Dugum] = []
    var hepsi_sayi = true
    var ondalik_var = false
    repeat i from 1 to e.cocuklar.length {
        var x = _ifade(e.cocuklar[i], eleman_beklenen)
        if not _tamam() {
            return e
        }
        tipli.add(x)
        if not sayisal_mi(x.tip) {
            hepsi_sayi = false
        }
        if x.tip is "float" {
            ondalik_var = true
        }
    }
    var ilk = tipli[1].tip
    var ortak = ilk
    if hepsi_sayi {
        ortak = "int"
        if ondalik_var {
            ortak = "float"
        }
    } else {
        repeat i from 1 to tipli.length {
            if tipli[i].tip is not ilk {
                _hata(e.cocuklar[i], dil.sec("Bir listedeki her şey aynı tipte olmalı. İlk eleman {tip_aciklama(ilk)}, bu ise {tip_aciklama(tipli[i].tip)}.", "Everything in a list must have the same type. The first element is {tip_aciklama(ilk)}, but this one is {tip_aciklama(tipli[i].tip)}."))
                return e
            }
        }
    }
    return _c(e, tipli, "[{ortak}]")
}

# ---------- İki değerli işlemler ----------
fn _sayisal_olmali(e: parser.Dugum, sol: text, sag: text) -> bool {
    if not sayisal_mi(sol) {
        _hata(e, dil.sec("'{e.deger}' sadece sayılarla kullanılır, burada {tip_aciklama(sol)} var.", "'{e.deger}' is only used with numbers, but here there is {tip_aciklama(sol)}."))
        return false
    }
    if not sayisal_mi(sag) {
        _hata(e, dil.sec("'{e.deger}' sadece sayılarla kullanılır, burada {tip_aciklama(sag)} var.", "'{e.deger}' is only used with numbers, but here there is {tip_aciklama(sag)}."))
        return false
    }
    return true
}

fn _ikili_islem(e: parser.Dugum) -> parser.Dugum {
    var s1 = _ifade(e.cocuklar[1], "")
    if not _tamam() {
        return e
    }
    var s2 = _ifade(e.cocuklar[2], "")
    if not _tamam() {
        return e
    }
    var sol = s1.tip
    var sag = s2.tip
    var op = e.deger
    var tip = "?"
    if op is "&" or op is "|" or op is "^" or op is "<<" or op is ">>" {      # bit işlemleri: sadece tam sayılarla
        if sol is "bool" and sag is "bool" and (op is "&" or op is "|") {
            var kelime = "and"
            if op is "|" {
                kelime = "or"
            }
            _hata(e, dil.sec("Doğru/yanlış (bool) değerleri birleştirmek için '{op}' değil '{kelime}' yazılır:   a {kelime} b\n   ('{op}' sayıların bitleri üzerinde çalışır.)", "To combine true/false (bool) values, write '{kelime}', not '{op}':   a {kelime} b\n   ('{op}' works on the bits of numbers.)"))
        } else if sol is not "int" {
            _hata(e.cocuklar[1], dil.sec("'{op}' bit işlemidir, iki tam sayı (int) ister; burada {tip_aciklama(sol)} var.", "'{op}' is a bit operation and needs two integers (int); but here there is {tip_aciklama(sol)}."))
        } else if sag is not "int" {
            _hata(e.cocuklar[2], dil.sec("'{op}' bit işlemidir, iki tam sayı (int) ister; burada {tip_aciklama(sag)} var.", "'{op}' is a bit operation and needs two integers (int); but here there is {tip_aciklama(sag)}."))
        }
        tip = "int"
    } else if op is "and" or op is "or" {
        if sol is not "bool" {
            _hata(e.cocuklar[1], dil.sec("'{op}' iki doğru/yanlış (bool) değeri birleştirir, burada {tip_aciklama(sol)} var.", "'{op}' combines two true/false (bool) values, but here there is {tip_aciklama(sol)}."))
        } else if sag is not "bool" {
            _hata(e.cocuklar[2], dil.sec("'{op}' iki doğru/yanlış (bool) değeri birleştirir, burada {tip_aciklama(sag)} var.", "'{op}' combines two true/false (bool) values, but here there is {tip_aciklama(sag)}."))
        }
        tip = "bool"
    } else if op is "+" or op is "-" or op is "*" {
        if op is "+" and (sol is "text" or sag is "text") {
            _hata(e, dil.sec("Metinler '+' ile birleştirilmez. Metnin içine yazabilirsin:\n   \"Merhaba \{isim\}\"", "Text can't be joined with '+'. You can write values inside the text:\n   \"Hello \{name\}\""))
        } else if _sayisal_olmali(e, sol, sag) {
            tip = "int"
            if sol is "float" or sag is "float" {
                tip = "float"
            }
        }
    } else if op is "/" {
        _sayisal_olmali(e, sol, sag)
        tip = "float"
    } else if op is "//" or op is "%" {
        if sol is not "int" or sag is not "int" {
            _hata(e, dil.sec("'{op}' sadece tam sayılarla (int) kullanılır, burada {tip_aciklama(sol)} ve {tip_aciklama(sag)} var.", "'{op}' is only used with integers (int), but here there are {tip_aciklama(sol)} and {tip_aciklama(sag)}."))
        }
        tip = "int"
    } else if op is "<" or op is ">" or op is "<=" or op is ">=" {
        _sayisal_olmali(e, sol, sag)
        tip = "bool"
    } else if (op is "is" or op is "is not") and (sol is "none" or sag is "none") {
        var diger = e.cocuklar[1]
        var dt = sol
        if sol is "none" {
            diger = e.cocuklar[2]
            dt = sag
        }
        if not secmeli_mi(dt) and dt is not "none" and dt is not "ptr" {
            _hata(diger, dil.sec("Bu değer {tip_aciklama(dt)}; hiçbir zaman none olamaz, kontrol etmeye gerek yok.", "This value is {tip_aciklama(dt)}; it can never be none, so there is no need to check it."))
        }
        tip = "bool"
    } else if op is "is" or op is "is not" {
        if liste_mi(sol) or liste_mi(sag) or sol is "bytes" or sag is "bytes" {
            _hata(e, dil.sec("Listeler ve baytlar henüz 'is' ile karşılaştırılamaz.", "Lists and bytes can't be compared with 'is' yet."))
        } else if sozluk_mu(sol) or sozluk_mu(sag) {
            _hata(e, dil.sec("Sözlükler henüz 'is' ile karşılaştırılamaz.", "Dictionaries can't be compared with 'is' yet."))
        } else if sol.starts_with("task[") or sag.starts_with("task[") or sol.starts_with("channel[") or sag.starts_with("channel[") or fn_mi(sol) or fn_mi(sag) {
            _hata(e, dil.sec("Arka plan işleri ve kanallar 'is' ile karşılaştırılamaz.", "Background tasks and channels can't be compared with 'is'."))
        } else if ENUMLAR.has(sol) or ENUMLAR.has(sag) {
            _hata(e, dil.sec("Enum değerleri 'is' ile karşılaştırılamaz; hangi çeşit olduğunu 'match' ile sor.", "Enum values can't be compared with 'is'; ask which variant it is with 'match'."))
        } else if TIPLER.has(sol) or TIPLER.has(sag) {
            _hata(e, dil.sec("Kendi tiplerin değerleri henüz 'is' ile karşılaştırılamaz; alanlarını karşılaştır (ör: a.ad is b.ad).", "Values of your own types can't be compared with 'is' yet; compare their fields (e.g. a.name is b.name)."))
        } else if not (sol is sag or (sayisal_mi(sol) and sayisal_mi(sag))) {
            _hata(e, dil.sec("{tip_aciklama(sol)} ile {tip_aciklama(sag)} karşılaştırılamaz.", "{tip_aciklama(sol)} and {tip_aciklama(sag)} can't be compared."))
        }
        tip = "bool"
    } else {
        _hata(e, dil.sec("'{op}' işlemini tanımıyorum.", "I don't recognize the '{op}' operation."))
    }
    return _c(e, [s1, s2], tip)
}

# ---------- Fonksiyon çağrıları ----------
fn _izin_kontrol(e: parser.Dugum, f: Fonksiyon) {
    if f.izinler.length is 0 {
        return
    }
    if FN.length is 0 {
        _ana_izin_ekle(e, f.izinler)            # ana program her şeye izinli; ne kullandığını not et
        return
    }
    var cagiran = AKTIF
    var eksik: [text] = []
    repeat i from 1 to f.izinler.length {
        if not _icinde_mi(f.izinler[i], cagiran.izinler) {
            eksik.add(f.izinler[i])
        }
    }
    if eksik.length is 0 {
        return
    }
    # alfabetik sırala (az eleman var; basit seçme sıralaması)
    repeat i from 1 to eksik.length {
        repeat j from i + 1 to eksik.length {
            if _once_mi(eksik[j], eksik[i]) {
                var g = eksik[i]
                eksik[i] = eksik[j]
                eksik[j] = g
            }
        }
    }
    var izin = eksik[1]
    var ayrica = ""
    if eksik.length > 1 {
        var digerleri: [text] = []
        repeat i from 2 to eksik.length {
            digerleri.add(eksik[i])
        }
        ayrica = dil.sec("\n   (Ayrıca gereken: {digerleri.join(", ")})", "\n   (Also needed: {digerleri.join(", ")})")
    }
    var ne = dil.sec("fonksiyonu", "is a function that")
    if f.c_mi {
        ne = dil.sec("C fonksiyonu", "is a C function that")
    }
    _hata(e, dil.sec("'{f.ad}' {ne} {IZINLER[izin]} ('{izin}' izni).\n   Onu çağırabilmek için '{cagiran.ad}' fonksiyonunun başına şunu yaz:   use {izin}{ayrica}", "'{f.ad}' {ne} {IZINLER_EN[izin]} ('{izin}' permission).\n   To call it, write this at the top of the '{cagiran.ad}' function:   use {izin}{ayrica}"))
}

# Ana programın (dolaylı olarak) kullandığı izinler: güvenlik kartı için
global var ANA_IZINLER: [text] = []

fn _ana_izin_ekle(e: parser.Dugum, izinler: [text]) {
    use change ANA_IZINLER
    repeat i from 1 to izinler.length {
        _kum_izin_denetle(e, izinler[i])
        if not _icinde_mi(izinler[i], ANA_IZINLER) {
            ANA_IZINLER.add(izinler[i])
        }
    }
}

# Fonksiyonu olan extern blokları: "kütüphane|dosya"
global var C_KUTUPHANELERI: [text] = []

fn _c_kutuphane_ekle(k: text) {
    use change C_KUTUPHANELERI
    if not _icinde_mi(k, C_KUTUPHANELERI) {
        C_KUTUPHANELERI.add(k)
    }
}

fn kullanilan_c_kutuphaneleri() -> [text] {
    use C_KUTUPHANELERI
    return C_KUTUPHANELERI
}

fn kullanilan_izinler() -> [text] {
    use ANA_IZINLER
    var sonuc = ANA_IZINLER
    repeat i from 1 to sonuc.length {
        repeat j from i + 1 to sonuc.length {
            if _once_mi(sonuc[j], sonuc[i]) {
                var g = sonuc[i]
                sonuc[i] = sonuc[j]
                sonuc[j] = g
            }
        }
    }
    return sonuc
}

fn _once_mi(a: text, b: text) -> bool {
    var n = a.length
    if b.length < n {
        n = b.length
    }
    repeat i from 1 to n {
        if a[i] is not b[i] {
            return code(a[i]) < code(b[i])
        }
    }
    return a.length < b.length
}

fn _argumanlar(e: parser.Dugum, argumanlar: [parser.Dugum], f: Fonksiyon, ne: text) -> [parser.Dugum] {
    var tipli: [parser.Dugum] = []
    if argumanlar.length is not f.p_adlar.length {
        var parcalar: [text] = []
        repeat i from 1 to f.p_adlar.length {
            parcalar.add("{f.p_adlar[i]}: {f.p_tipler[i]}")
        }
        var beklenen = parcalar.join(", ")
        if beklenen.length is 0 {
            beklenen = dil.sec("hiçbir şey", "nothing")
        }
        _hata(e, dil.sec("'{f.ad}' {f.p_adlar.length} değer bekliyor ({beklenen}), ama {argumanlar.length} değer verildi.", "'{f.ad}' expects {f.p_adlar.length} value(s) ({beklenen}), but {argumanlar.length} values were given."))
        return tipli
    }
    repeat i from 1 to argumanlar.length {
        var a = _ifade(argumanlar[i], f.p_tipler[i])
        if not _tamam() {
            return tipli
        }
        if not uyumlu_mu(f.p_tipler[i], a.tip) {
            _hata(argumanlar[i], dil.sec("'{f.ad}' {ne} '{f.p_adlar[i]}' parametresi {tip_aciklama(f.p_tipler[i])} bekliyor, ama {tip_aciklama(a.tip)} verildi.", "The '{f.p_adlar[i]}' parameter of the {ne} '{f.ad}' expects {tip_aciklama(f.p_tipler[i])}, but {tip_aciklama(a.tip)} was given."))
            return tipli
        }
        tipli.add(a)
    }
    return tipli
}

fn _cagri(e: parser.Dugum, beklenen: text) -> parser.Dugum {
    var izin = SON_IZIN                              # try / else: bu çağrının hatasını ele alıyor mu?
    var ad = e.deger
    var isimli = e.cocuklar[2].cocuklar
    if TIPLER.has(ad) {                                  # Ogrenci(ad: "Ali", ...)
        return _olusturma(e)
    }
    if GENERIK_TIPLER.has(ad) {                          # Kutu(deger: 5) → Kutu[int]
        return _generik_olusturma(e, beklenen)
    }
    if _yerlesik_mi(ad) and ad is not "print" and ad is not "write" {
        return _hazir_fonksiyon(e, beklenen)
    }
    if isimli.length > 0 {
        _hata(isimli[1], dil.sec("'{ad}(...)' bir fonksiyon; değerler adlarıyla (ad: değer) verilemez, sırayla yazılır.", "'{ad}(...)' is a function; values can't be given by name (name: value), they are written in order."))
        return e
    }
    var argumanlar = e.cocuklar[1].cocuklar
    if ad is "print" or ad is "write" {
        var tipli: [parser.Dugum] = []
        repeat i from 1 to argumanlar.length {
            var a = _ifade(argumanlar[i], "")
            if not _tamam() {
                return e
            }
            var t = a.tip
            if not _yazdirilabilir(t) and not liste_mi(t) and t is not "bytes" and not sozluk_mu(t) and not TIPLER.has(t) and not ENUMLAR.has(t) and not secmeli_mi(t) and t is not "none" {
                _hata(argumanlar[i], dil.sec("{ad}() şimdilik {tip_aciklama(t)} yazdıramaz.", "{ad}() can't print {tip_aciklama(t)} yet."))
                return e
            }
            tipli.add(a)
        }
        return _c(e, [_liste(tipli), e.cocuklar[2]], "void")
    }
    var fn_degiskeni = _ara(ad)
    if fn_degiskeni is not none {
        if fn_mi(fn_degiskeni.tip) {                 # f(x): fonksiyon tipli bir değişkeni çağır
            return _deger_cagrisi(e, ad, beklenen)
        }
    }
    if TIP_ICINDE.length > 0 and TIPLER[TIP_ICINDE].metotlar.has(ad) and LAMBDALAR.length > 0 {
        _hata(e, dil.sec("Lambda içinden '{ad}' metodu doğrudan çağrılamaz.\n   Gerekli değeri lambda'dan önce bir değişkene al.", "The '{ad}' method can't be called directly from inside a lambda.\n   Put the value you need into a variable before the lambda."))
        return e
    }
    if TIP_ICINDE.length > 0 and TIPLER[TIP_ICINDE].metotlar.has(ad) {    # metodun içinden aynı tipin metodu
        var m = TIPLER[TIP_ICINDE].metotlar[ad]
        if m.degistirir and not AKTIF.degistirir {
            _hata(e, dil.sec("'{AKTIF.ad}' nesneyi değiştirmeyen bir metot; nesneyi değiştiren '{ad}' metodunu çağıramaz.\n   Gerekiyorsa şöyle işaretle:   fn change {AKTIF.ad}(...)", "'{AKTIF.ad}' is a method that doesn't change the object; it can't call the '{ad}' method, which changes the object.\n   If needed, mark it like this:   fn change {AKTIF.ad}(...)"))
            return e
        }
        var tipli_m = _argumanlar(e, argumanlar, m, dil.sec("metodunun", "method"))
        if not _tamam() {
            return e
        }
        _izin_kontrol(e, m)
        _hata_cagrisi(e, m, izin)
        return _c(e, [_liste(tipli_m), e.cocuklar[2]], m.donus)
    }
    if GENERIKLER.has(ad) {                          # fn ilk[T](...): bu tipler için kopya
        return _generik_cagri(e, beklenen, izin)
    }
    if not _fonksiyon_gorunur(ad, e) {
        if _ara(ad) is not none {
            _hata(e, dil.sec("'{ad}' bir değişken, fonksiyon değil; çağrılamaz.", "'{ad}' is a variable, not a function; it can't be called."))
            return e
        }
        var tum_adlar = FONKSIYONLAR.keys()
        var adaylar: [text] = []
        repeat i from 1 to tum_adlar.length {
            if _gorunur_ad(tum_adlar[i], e) {            # başka dosyanın göremeyeceği adları önerme
                adaylar.add(tum_adlar[i])
            }
        }
        repeat i from 1 to YERLESIK.length {
            adaylar.add(YERLESIK[i])
        }
        var tip_adlari = TIPLER.keys()
        repeat i from 1 to tip_adlari.length {
            adaylar.add(tip_adlari[i])
        }
        _hata(e, dil.sec("'{ad}' diye bir fonksiyon yok.{oneri.oneri(ad, adaylar)}", "There is no function called '{ad}'.{oneri.oneri(ad, adaylar)}"))
        return e
    }
    var f = FONKSIYONLAR[ad]
    var tipli = _argumanlar(e, argumanlar, f, dil.sec("fonksiyonunun", "function"))
    if not _tamam() {
        return e
    }
    _izin_kontrol(e, f)
    _hata_cagrisi(e, f, izin)
    return _c(e, [_liste(tipli), e.cocuklar[2]], f.donus)
}

fn _hazir_fonksiyon(e: parser.Dugum, beklenen: text) -> parser.Dugum {
    var ad = e.deger
    var argumanlar = e.cocuklar[1].cocuklar
    var isimli = e.cocuklar[2].cocuklar
    if isimli.length > 0 and not ((ad is "int" or ad is "float") and isimli.length is 1 and isimli[1].deger is "else") {
        if isimli[1].deger is "else" {
            _hata(isimli[1], dil.sec("'else:' sadece int(...) ve float(...) çevirmelerinde kullanılır.", "'else:' is only used when converting with int(...) and float(...)."))
        } else {
            _hata(isimli[1], dil.sec("'{ad}(...)' değerleri adlarıyla (ad: değer) almaz.", "'{ad}(...)' doesn't take values by name (name: value)."))
        }
        return e
    }
    if ad is "input" {
        if argumanlar.length > 1 {
            _hata(e, dil.sec("'input' en fazla bir değer (ekrana yazılacak soru) alır:   input(\"Adın: \")", "'input' takes at most one value (the question to show on the screen):   input(\"Your name: \")"))
            return e
        }
        var tipli: [parser.Dugum] = []
        if argumanlar.length is 1 {
            var a = _ifade(argumanlar[1], "")
            if not _tamam() {
                return e
            }
            if a.tip is not "text" {
                _hata(argumanlar[1], dil.sec("'input'e verilen soru bir metin (text) olmalı.", "The question given to 'input' must be text."))
                return e
            }
            tipli.add(a)
        }
        var input_tipi = "text"
        if beklenen is "int" or beklenen is "float" {
            input_tipi = beklenen
        } else if beklenen.length > 0 and beklenen is not "text" {
            _hata(e, dil.sec("input bir {tip_aciklama(beklenen)} okuyamaz; metin, int ya da float okuyabilir.", "input can't read {tip_aciklama(beklenen)}; it can read text, int or float."))
            return e
        }
        return _c(e, [_liste(tipli), e.cocuklar[2]], input_tipi)
    }
    if ad is "random" {
        if argumanlar.length is 2 {
            _hata(e, dil.sec("Vash'ta aralık 'to' ile yazılır (iki sınır da dahil):   random(1 to 6)", "In Vash a range is written with 'to' (both ends are included):   random(1 to 6)"))
            return e
        }
        if argumanlar.length is not 1 {
            _hata(e, dil.sec("'random' 1 değer bekliyor, {argumanlar.length} değer verildi.", "'random' expects 1 value, but {argumanlar.length} values were given."))
            return e
        }
        var a = argumanlar[1]
        if a.tur is "Aralik" {                                   # random(1 to 6)
            var ta = _ifade(a.cocuklar[1], "")
            if not _tamam() {
                return e
            }
            var tb = _ifade(a.cocuklar[2], "")
            if not _tamam() {
                return e
            }
            if not sayisal_mi(ta.tip) {
                _hata(a.cocuklar[1], dil.sec("random'ın sınırları sayı olmalı, burada {tip_aciklama(ta.tip)} var.", "random's limits must be numbers, but here there is {tip_aciklama(ta.tip)}."))
                return e
            }
            if not sayisal_mi(tb.tip) {
                _hata(a.cocuklar[2], dil.sec("random'ın sınırları sayı olmalı, burada {tip_aciklama(tb.tip)} var.", "random's limits must be numbers, but here there is {tip_aciklama(tb.tip)}."))
                return e
            }
            var tip = "int"
            if ta.tip is "float" or tb.tip is "float" {
                tip = "float"
            }
            return _c(e, [_liste([_c(a, [ta, tb], tip)]), e.cocuklar[2]], tip)
        }
        var l = _ifade(a, "")
        if not _tamam() {
            return e
        }
        if liste_mi(l.tip) {
            return _c(e, [_liste([l]), e.cocuklar[2]], _ic(l.tip))
        }
        _hata(a, dil.sec("random bir aralık (random(1 to 6)) ya da bir liste (random(renkler)) bekler, burada {tip_aciklama(l.tip)} var.", "random expects a range (random(1 to 6)) or a list (random(colors)), but here there is {tip_aciklama(l.tip)}."))
        return e
    }
    if ad is "code" or ad is "char" {
        if argumanlar.length is not 1 {
            _hata(e, dil.sec("'{ad}' 1 değer bekliyor, {argumanlar.length} değer verildi.", "'{ad}' expects 1 value, but {argumanlar.length} values were given."))
            return e
        }
        var a = _ifade(argumanlar[1], "")
        if not _tamam() {
            return e
        }
        var istenen = "int"
        var ornek = "char(65)  → \"A\""
        var donus = "text"
        if ad is "code" {
            istenen = "text"
            ornek = "code(\"A\")  → 65"
            donus = "int"
        }
        if a.tip is not istenen {
            _hata(argumanlar[1], dil.sec("'{ad}' bir {tip_aciklama(istenen)} bekliyor, {tip_aciklama(a.tip)} verildi.   Örnek:   {ornek}", "'{ad}' expects {tip_aciklama(istenen)}, but {tip_aciklama(a.tip)} was given.   Example:   {ornek}"))
            return e
        }
        return _c(e, [_liste([a]), e.cocuklar[2]], donus)
    }
    if DOSYA_ARGUMAN.has(ad) {
        var beklenenler = DOSYA_ARGUMAN[ad]
        if argumanlar.length is not beklenenler.length {
            var ornek = dil.sec("file_exists(\"ayar.txt\")", "file_exists(\"settings.txt\")")
            if ad is "read_file" { ornek = dil.sec("read_file(\"notlar.txt\")", "read_file(\"notes.txt\")") }
            if ad is "read_lines" { ornek = dil.sec("read_lines(\"liste.txt\")", "read_lines(\"list.txt\")") }
            if ad is "write_file" { ornek = dil.sec("write_file(\"sonuc.txt\", \"Merhaba\")", "write_file(\"result.txt\", \"Hello\")") }
            if ad is "append_file" { ornek = dil.sec("append_file(\"gunluk.txt\", \"yeni satır\\n\")", "append_file(\"log.txt\", \"new line\\n\")") }
            _hata(e, dil.sec("'{ad}' {beklenenler.length} değer bekliyor, {argumanlar.length} verildi.   Örnek:   {ornek}", "'{ad}' expects {beklenenler.length} value(s), but {argumanlar.length} were given.   Example:   {ornek}"))
            return e
        }
        var tipli: [parser.Dugum] = []
        repeat i from 1 to argumanlar.length {
            var a = _ifade(argumanlar[i], "")
            if not _tamam() {
                return e
            }
            if a.tip is not beklenenler[i] {
                _hata(argumanlar[i], dil.sec("'{ad}' burada {tip_aciklama(beklenenler[i])} bekliyor (dosya adı/yazı), {tip_aciklama(a.tip)} verildi.", "'{ad}' expects {tip_aciklama(beklenenler[i])} here (file name/text), but {tip_aciklama(a.tip)} was given."))
                return e
            }
            tipli.add(a)
        }
        if FN.length is 0 {
            _ana_izin_ekle(e, ["files"])
        }
        if FN.length > 0 and not _icinde_mi("files", AKTIF.izinler) {
            _hata(e, dil.sec("'{ad}' dosyalara dokunuyor ('files' izni).\n   Onu kullanabilmek için '{FN}' fonksiyonunun başına şunu yaz:   use files", "'{ad}' touches files ('files' permission).\n   To use it, write this at the top of the '{FN}' function:   use files"))
            return e
        }
        return _c(e, [_liste(tipli), e.cocuklar[2]], DOSYA_DONUS[ad])
    }
    if ad is "args" {                                # programa komut satırından verilen bilgiler
        if argumanlar.length is not 0 {
            _hata(e, dil.sec("'args' değer almaz:   var bilgiler = args()", "'args' takes no values:   var info = args()"))
            return e
        }
        return _t(e, "[text]")
    }
    if ad is "bytes" {                               # bytes(n): n tane sıfır bayt
        if argumanlar.length is not 1 {
            _hata(e, dil.sec("'bytes' kaç bayt olacağını bekliyor:   var veri = bytes(16)", "'bytes' expects how many bytes there will be:   var data = bytes(16)"))
            return e
        }
        var n = _ifade(argumanlar[1], "")
        if _tamam() and n.tip is not "int" {
            _hata(argumanlar[1], dil.sec("'bytes' bir tam sayı (int) bekliyor, burada {tip_aciklama(n.tip)} var:   var veri = bytes(16)", "'bytes' expects an integer (int), but here there is {tip_aciklama(n.tip)}:   var data = bytes(16)"))
            return e
        }
        return _c(e, [_liste([n]), e.cocuklar[2]], "bytes")
    }
    if ad is "time" {
        if argumanlar.length is not 0 {
            _hata(e, dil.sec("'time' 0 değer bekliyor, {argumanlar.length} değer verildi.", "'time' expects 0 values, but {argumanlar.length} values were given."))
            return e
        }
        return _t(e, "float")
    }
    # int(x) / float(x) / text(x): çevirme
    if argumanlar.length is not 1 {
        _hata(e, dil.sec("'{ad}' 1 değer bekliyor, {argumanlar.length} değer verildi.", "'{ad}' expects 1 value, but {argumanlar.length} values were given."))
        return e
    }
    var x = _ifade(argumanlar[1], "")
    if not _tamam() {
        return e
    }
    var t = x.tip
    var kabul = t is "int" or t is "float" or t is "text" or (t is "bool" and ad is not "float")
    if not kabul {
        _hata(argumanlar[1], dil.sec("{tip_aciklama(t)} değeri {ad}'e çevrilemez.", "A {tip_aciklama(t)} value can't be converted to {ad}."))
        return e
    }
    var tipli_isimli = e.cocuklar[2]
    if isimli.length > 0 {                                       # int("abc", else: 0)
        if t is not "text" {
            _hata(isimli[1], dil.sec("'else:' sadece bir metni çevirirken gerekir (sayılar her zaman çevrilebilir).", "'else:' is only needed when converting text (numbers can always be converted)."))
            return e
        }
        var y = _ifade(isimli[1].cocuklar[1], ad)
        if not _tamam() {
            return e
        }
        if not uyumlu_mu(ad, y.tip) {
            _hata(isimli[1].cocuklar[1], dil.sec("Yedek değer bir {tip_aciklama(ad)} olmalı, burada {tip_aciklama(y.tip)} var.", "The fallback value must be {tip_aciklama(ad)}, but here there is {tip_aciklama(y.tip)}."))
            return e
        }
        tipli_isimli = _liste([_c(isimli[1], [y], "")])
    }
    return _c(e, [_liste([x]), tipli_isimli], ad)
}

# ---------- Metinler: "Toplam: {fiyat * adet} TL" ----------
fn _kapanis_bul(metin: text, bas: int) -> int {
    var derinlik = 0
    var j = bas
    var n = metin.length
    repeat while j <= n {
        var h = metin[j]
        if h is "\"" {
            j = j + 1
            repeat while j <= n and metin[j] is not "\"" {
                if metin[j] is "\\" {
                    j = j + 2
                } else {
                    j = j + 1
                }
            }
        } else if h is "\{" {
            derinlik = derinlik + 1
        } else if h is "\}" {
            derinlik = derinlik - 1
            if derinlik is 0 {
                return j
            }
        }
        j = j + 1
    }
    return 0
}

fn _geri(s: text) -> text {
    return s.replace(char(57344), "\{").replace(char(57345), "\}")
}

fn _parca(s: text) -> parser.Dugum {
    return parser.Dugum(tur: "Parca", deger: s, ek: "", cocuklar: [], satir: 0, sutun: 0)
}

fn _metin_parcala(e: parser.Dugum) -> parser.Dugum {
    var metin = e.deger
    var n = metin.length
    var parcalar: [parser.Dugum] = []
    var hepsi_sabit = true
    var i = 1
    repeat while i <= n {
        var ac = 0
        repeat j from i to n {
            if metin[j] is "\{" {
                ac = j
                stop
            }
        }
        if ac is 0 {
            parcalar.add(_parca(_geri(metin[i to n])))
            stop
        }
        if ac > i {
            parcalar.add(_parca(_geri(metin[i to ac - 1])))
        }
        var kapa = _kapanis_bul(metin, ac)
        if kapa is 0 {
            _hata(e, dil.sec("Metnin içindeki '\{' kapatılmamış. Değer yazmak için:   \"Merhaba \{isim\}\"", "The '\{' inside the text isn't closed. To write a value:   \"Hello \{name\}\""))
            return e
        }
        var kaynak = metin[ac + 1 to kapa - 1]
        if kaynak.trim().length is 0 {
            _hata(e, dil.sec("Metnin içinde boş bir \{ \} var; içine bir değer yaz:   \"\{isim\}\"", "There is an empty \{ \} inside the text; write a value in it:   \"\{name\}\""))
            return e
        }
        # { } içini küçük bir program parçası gibi oku
        match lexer.kelimelere_ayir(kaynak) {
            Hata(mesaj) {
                _hata_ham(dil.sec("{mesaj}\n   (metnin içindeki \{{kaynak.trim()}\} kısmında)", "{mesaj}\n   (in the \{{kaynak.trim()}\} part of the text)"))
                return e
            }
            Tamam(tokenlar) {
                var yeni: [lexer.Token] = []
                repeat k from 1 to tokenlar.length {        # hata mesajları metnin satırını göstersin
                    var t = tokenlar[k]
                    yeni.add(lexer.Token(tur: t.tur, deger: t.deger, satir: e.satir, sutun: e.sutun + ac + t.sutun))
                }
                match parser.ifade_kur(yeni) {
                    Hata(mesaj) {
                        if mesaj.length is 0 {
                            _hata(e, dil.sec("Metnin içindeki \{{kaynak}\} tek bir değer olmalı.", "The \{{kaynak}\} inside the text must be a single value."))
                        } else {
                            _hata_ham(dil.sec("{mesaj}\n   (metnin içindeki \{{kaynak.trim()}\} kısmında)", "{mesaj}\n   (in the \{{kaynak.trim()}\} part of the text)"))
                        }
                        return e
                    }
                    Tamam(ic_ham) {
                        var ic = moduller.metin_duzelt(ic_ham, e.dosya)   # modüldeyse adları düzelt
                        if moduller.HATA.length > 0 {
                            _hata_ham(moduller.HATA)
                            return e
                        }
                        var tipli = _ifade(ic, "")
                        if not _tamam() {
                            return e
                        }
                        if not _yazdirilabilir(tipli.tip) {
                            _hata(e, dil.sec("\{{kaynak.trim()}\} bir {tip_aciklama(tipli.tip)}; metnin içine sadece sayı, metin ve bool yazılabilir.", "\{{kaynak.trim()}\} is {tip_aciklama(tipli.tip)}; only numbers, text and bool can be written inside text."))
                            return e
                        }
                        parcalar.add(tipli)
                        hepsi_sabit = false
                    }
                }
            }
        }
        i = kapa + 1
    }
    var deger = e.deger
    if hepsi_sabit {                                         # sabit metin: \{ \} işaretleri temizlenmiş hâli
        var yazilar: [text] = []
        repeat k from 1 to parcalar.length {
            yazilar.add(parcalar[k].deger)
        }
        deger = yazilar.join("")
    }
    return parser.Dugum(tur: "Metin", deger: deger, ek: "", cocuklar: parcalar, satir: e.satir, sutun: e.sutun, tip: "text", dosya: e.dosya)
}

# =====================================================================
#  ANA AKIŞ
# =====================================================================
fn _imza_kaydet(f: parser.Dugum) {
    use change FONKSIYONLAR
    var ad = f.deger
    if _yerlesik_mi(ad) {
        _hata(f, dil.sec("'{ad}' dilin hazır fonksiyonu, aynı adla yeni fonksiyon yazılamaz.", "'{ad}' is a built-in function of the language; a new function with the same name can't be written."))
        return
    }
    if FONKSIYONLAR.has(ad) {
        _hata(f, dil.sec("'{ad}' adında bir fonksiyon zaten var (satır {FONKSIYONLAR[ad].satir}).", "There is already a function named '{ad}' (line {FONKSIYONLAR[ad].satir})."))
        return
    }
    if TIPLER.has(ad) {
        _hata(f, dil.sec("'{ad}' bir tipin adı; fonksiyona aynı ad verilemez.", "'{ad}' is the name of a type; a function can't have the same name."))
        return
    }
    if f.ek.starts_with("change") {
        _hata(f, dil.sec("'fn change' sadece bir 'type' içindeki metotlar için kullanılır.", "'fn change' is only used for methods inside a 'type'."))
        return
    }
    var fn_bilgi = _imza_olustur(f)
    if _tamam() {
        FONKSIYONLAR[ad] = fn_bilgi
    }
}

fn _imza_olustur(f: parser.Dugum) -> Fonksiyon {
    var ad = f.deger
    var p_adlar: [text] = []
    var p_tipler: [text] = []
    var izinler: [text] = []
    var parametreler = f.cocuklar[1].cocuklar
    repeat i from 1 to parametreler.length {
        var p = parametreler[i]
        if _icinde_mi(p.deger, p_adlar) {
            _hata(p, dil.sec("'{p.deger}' parametresi iki kere yazılmış.", "The '{p.deger}' parameter is written twice."))
            stop
        }
        p_adlar.add(p.deger)
        p_tipler.add(tip_coz(p.cocuklar[1]))
        if not _tamam() {
            stop
        }
    }
    var donus = "void"
    if _tamam() and not _bos_mu(f.cocuklar[2]) {
        donus = tip_coz(f.cocuklar[2])
    }
    return Fonksiyon(ad: ad, p_adlar: p_adlar, p_tipler: p_tipler, donus: donus, satir: f.satir, izinler: _izinleri_topla(f.cocuklar[3], izinler), hata_verir: f.ek.ends_with("fails"))
}

fn _fonksiyon_govdesi(k: parser.Dugum, f: Fonksiyon, tip_adi: text) -> parser.Dugum {
    use change FN
    use change YIGIN
    use change KAPANAN
    use change AKTIF
    use change TIP_ICINDE
    use change HATA_YIGINI
    var onceki_hata_yigini = HATA_YIGINI
    HATA_YIGINI = ["fn"]
    AKTIF = f
    TIP_ICINDE = tip_adi
    FN = k.deger
    YIGIN = [{}]
    KAPANAN = {}
    var parametreler = k.cocuklar[1].cocuklar
    repeat i from 1 to f.p_adlar.length {
        _koy(Degisken(ad: f.p_adlar[i], tip: f.p_tipler[i], tur: "parametre", satir: parametreler[i].satir))
    }
    var govde: [parser.Dugum] = []
    var komutlar = k.cocuklar[3].cocuklar
    repeat i from 1 to komutlar.length {
        govde.add(_komut(komutlar[i]))
        if not _tamam() {
            stop
        }
    }
    if _tamam() and f.donus is not "void" and not her_zaman_doner_mu(komutlar) {
        _hata(k, dil.sec("'{k.deger}' bir {tip_aciklama(f.donus)} döndürmeli, ama her durumda 'return' ile bitmiyor.\n   Örneğin bir 'if' içinde return var ama 'else' durumunda yok olabilir.", "'{k.deger}' must return {tip_aciklama(f.donus)}, but it doesn't always end with 'return'.\n   For example, there may be a return inside an 'if' but none in the 'else' case."))
    }
    FN = ""
    TIP_ICINDE = ""
    AKTIF = Fonksiyon(ad: "", p_adlar: [], p_tipler: [], donus: "void", satir: 0, izinler: [])
    YIGIN = []
    KAPANAN = {}
    HATA_YIGINI = onceki_hata_yigini
    return _c(k, [k.cocuklar[1], k.cocuklar[2], _liste(govde)], "")
}

# =====================================================================
#  KENDİ TİPLER (type)
# =====================================================================
fn _bos_fonksiyon() -> Fonksiyon {
    return Fonksiyon(ad: "", p_adlar: [], p_tipler: [], donus: "void", satir: 0, izinler: [])
}

fn _sira(ad: text, liste: [text]) -> int {
    repeat i from 1 to liste.length {
        if liste[i] is ad {
            return i
        }
    }
    return 0
}

# Bir ağaç parçasında geçen değişken adları (when'in neyi izlediğini bulmak için)
fn _adlari_topla(d: parser.Dugum, adlar: [text]) -> [text] {
    var sonuc = adlar
    if (d.tur is "Isim" or d.tur is "Atama") and not _icinde_mi(d.deger, sonuc) {
        sonuc.add(d.deger)
    }
    repeat i from 1 to d.cocuklar.length {
        sonuc = _adlari_topla(d.cocuklar[i], sonuc)
    }
    return sonuc
}

fn _sirala(l: [text]) -> [text] {
    var s = l
    repeat i from 1 to s.length {
        repeat j from i + 1 to s.length {
            if _once_mi(s[j], s[i]) {
                var g = s[i]
                s[i] = s[j]
                s[j] = g
            }
        }
    }
    return s
}

fn _tip_ayrintilari(t: parser.Dugum) -> parser.Dugum {
    use change TIPLER
    var b = TIPLER[t.deger]
    var alan_adlari: [text] = []
    var alan_tipleri: [text] = []
    var varsayilanli: [bool] = []
    var satirlar: [int] = []
    var tipli_alanlar: [parser.Dugum] = []
    var alanlar = t.cocuklar[1].cocuklar
    repeat i from 1 to alanlar.length {
        var a = alanlar[i]
        if _icinde_mi(a.deger, alan_adlari) {
            _hata(a, dil.sec("'{a.deger}' alanı iki kere yazılmış.", "The '{a.deger}' field is written twice."))
            return t
        }
        var tip = tip_coz(a.cocuklar[1])
        if not _tamam() {
            return t
        }
        if tip is t.deger {
            _hata(a, dil.sec("'{t.deger}' kendi tipinde bir alan içeremez (sonsuz büyük olurdu).\n   Birden fazla tutmak istiyorsan liste kullan:   {a.deger}: [{t.deger}] = []", "'{t.deger}' can't contain a field of its own type (it would be infinitely big).\n   If you want to hold more than one, use a list:   {a.deger}: [{t.deger}] = []"))
            return t
        }
        var varsayilan = a.cocuklar[2]
        var var_mi = false
        if not _bos_mu(varsayilan) {
            var bos: [text] = []
            if _adlari_topla(varsayilan, bos).length > 0 {
                _hata(varsayilan, dil.sec("Varsayılan değer sabit olmalı (değişken kullanılamaz).", "The default value must be a constant (variables can't be used)."))
                return t
            }
            varsayilan = _ifade(a.cocuklar[2], tip)
            if not _tamam() {
                return t
            }
            if not uyumlu_mu(tip, varsayilan.tip) {
                _hata(a.cocuklar[2], dil.sec("'{a.deger}' alanı {tip_aciklama(tip)}, varsayılan değeri {tip_aciklama(varsayilan.tip)} olamaz.", "The '{a.deger}' field is {tip_aciklama(tip)}; its default value can't be {tip_aciklama(varsayilan.tip)}."))
                return t
            }
            var_mi = true
        }
        alan_adlari.add(a.deger)
        alan_tipleri.add(tip)
        varsayilanli.add(var_mi)
        satirlar.add(a.satir)
        b.alan_adlari = alan_adlari                  # metotların imzası alanlara bakıyor: hemen kaydet
        TIPLER[t.deger] = b
        tipli_alanlar.add(_c(a, [a.cocuklar[1], varsayilan], ""))
    }
    b.alan_tipleri = alan_tipleri
    b.alan_varsayilanli = varsayilanli
    b.alan_satirlari = satirlar
    var metotlar = t.cocuklar[2].cocuklar
    var metot_bilgileri: {text: Fonksiyon} = {}
    repeat i from 1 to metotlar.length {
        var m = metotlar[i]
        if metot_bilgileri.has(m.deger) {
            _hata(m, dil.sec("'{t.deger}' tipinde '{m.deger}' adında bir metot zaten var.", "The '{t.deger}' type already has a method named '{m.deger}'."))
            return t
        }
        if _icinde_mi(m.deger, alan_adlari) {
            _hata(m, dil.sec("'{m.deger}' hem alan hem metot adı olamaz.", "'{m.deger}' can't be both a field name and a method name."))
            return t
        }
        var f = _imza_olustur(m)
        if not _tamam() {
            return t
        }
        f.degistirir = m.ek.starts_with("change")
        f.tip_adi = t.deger
        repeat j from 1 to f.p_adlar.length {
            if _icinde_mi(f.p_adlar[j], alan_adlari) {
                _hata(m, dil.sec("'{m.deger}' metodunun '{f.p_adlar[j]}' parametresi, tipin bir alanıyla aynı adda; başka bir ad ver.", "The '{f.p_adlar[j]}' parameter of the '{m.deger}' method has the same name as a field of the type; give it a different name."))
                return t
            }
        }
        metot_bilgileri[m.deger] = f
    }
    b.metotlar = metot_bilgileri
    TIPLER[t.deger] = b
    return _c(t, [_liste(tipli_alanlar), t.cocuklar[2]], "")
}

fn _olusturma(e: parser.Dugum) -> parser.Dugum {
    var b = TIPLER[e.deger]
    var argumanlar = e.cocuklar[1].cocuklar
    var isimli = e.cocuklar[2].cocuklar
    if argumanlar.length > 0 {
        var parcalar: [text] = []
        repeat i from 1 to b.alan_adlari.length {
            parcalar.add("{b.alan_adlari[i]}: ...")
        }
        _hata(e, dil.sec("'{e.deger}' oluşturulurken değerler alan adlarıyla yazılır:   {e.deger}({parcalar.join(", ")})", "When creating '{e.deger}', values are written with field names:   {e.deger}({parcalar.join(", ")})"))
        return e
    }
    var verilen: [text] = []
    var tipli: [parser.Dugum] = []
    repeat i from 1 to isimli.length {
        var x = isimli[i]
        var no = _sira(x.deger, b.alan_adlari)
        if no is 0 {
            _hata(x, dil.sec("'{e.deger}' tipinin '{x.deger}' diye bir alanı yok.{oneri.oneri(x.deger, b.alan_adlari)}", "The '{e.deger}' type has no field called '{x.deger}'.{oneri.oneri(x.deger, b.alan_adlari)}"))
            return e
        }
        if _icinde_mi(x.deger, verilen) {
            _hata(x, dil.sec("'{x.deger}' alanına iki kere değer verilmiş.", "The '{x.deger}' field was given a value twice."))
            return e
        }
        var alan_tipi = b.alan_tipleri[no]
        var g = _ifade(x.cocuklar[1], alan_tipi)
        if not _tamam() {
            return e
        }
        if not uyumlu_mu(alan_tipi, g.tip) {
            _hata(x.cocuklar[1], dil.sec("'{x.deger}' alanı {tip_aciklama(alan_tipi)}, ona {tip_aciklama(g.tip)} verilemez.", "The '{x.deger}' field is {tip_aciklama(alan_tipi)}; it can't be given {tip_aciklama(g.tip)}."))
            return e
        }
        verilen.add(x.deger)
        tipli.add(_c(x, [g], ""))
    }
    var eksik: [text] = []
    repeat i from 1 to b.alan_adlari.length {
        if not _icinde_mi(b.alan_adlari[i], verilen) and not b.alan_varsayilanli[i] {
            eksik.add(b.alan_adlari[i])
        }
    }
    if eksik.length > 0 {
        _hata(e, dil.sec("'{e.deger}' oluşturulurken şu alanlara değer verilmedi (varsayılanları yok): {eksik.join(", ")}", "When creating '{e.deger}', these fields were not given values (they have no defaults): {eksik.join(", ")}"))
        return e
    }
    return _c(e, [e.cocuklar[1], _liste(tipli)], e.deger)
}

fn _nesne_degiskeni_olmali(nesne: parser.Dugum, ne: text) -> Degisken {
    return _yol_degiskeni(nesne, ne)
}

fn _alan_atama(k: parser.Dugum) -> parser.Dugum {         # nesne.alan = x
    var nesne = k.cocuklar[1]
    var d = _nesne_degiskeni_olmali(nesne, "'.{k.deger} = ...'")
    if not _tamam() {
        return k
    }
    if not TIPLER.has(d.tip) {
        _hata(nesne, dil.sec("'{nesne.deger}' bir {tip_aciklama(d.tip)}; alanı olan bir tip değil.", "'{nesne.deger}' is {tip_aciklama(d.tip)}; it is not a type with fields."))
        return k
    }
    var b = TIPLER[d.tip]
    var no = _sira(k.deger, b.alan_adlari)
    if no is 0 {
        _hata(k, dil.sec("'{d.tip}' tipinin '{k.deger}' diye bir alanı yok.{oneri.oneri(k.deger, b.alan_adlari)}", "The '{d.tip}' type has no field called '{k.deger}'.{oneri.oneri(k.deger, b.alan_adlari)}"))
        return k
    }
    var alan_tipi = b.alan_tipleri[no]
    var deger = _ifade(k.cocuklar[2], alan_tipi)
    if _tamam() and not uyumlu_mu(alan_tipi, deger.tip) {
        _hata(k.cocuklar[2], dil.sec("'{k.deger}' alanı {tip_aciklama(alan_tipi)}, ona {tip_aciklama(deger.tip)} verilemez.", "The '{k.deger}' field is {tip_aciklama(alan_tipi)}; it can't be given {tip_aciklama(deger.tip)}."))
        return k
    }
    var tipli_nesne = _t(nesne, d.tip)
    if nesne.tur is not "Isim" {                     # a[i].alan = x: yolun kendisi de tipli olmalı
        tipli_nesne = _ifade(nesne, "")
    }
    return _c(k, [tipli_nesne, deger], "")
}

# =====================================================================
#  ENUM ve MATCH
# =====================================================================
fn _enum_ayrintilari(t: parser.Dugum) {
    use change ENUMLAR
    var cesitler = t.cocuklar[1].cocuklar
    if cesitler.length is 0 {
        _hata(t, dil.sec("'{t.deger}' enum'unun hiç çeşidi yok. Örnek:   enum {t.deger} \{ Birinci  Ikinci(deger: int) \}", "The '{t.deger}' enum has no variants. Example:   enum {t.deger} \{ First  Second(value: int) \}"))
        return
    }
    var b = ENUMLAR[t.deger]
    var adlar: [text] = []
    var tum_alan_adlari: [[text]] = []
    var tum_alan_tipleri: [[text]] = []
    repeat i from 1 to cesitler.length {
        var c = cesitler[i]
        if _icinde_mi(c.deger, adlar) {
            _hata(c, dil.sec("'{c.deger}' çeşidi iki kere yazılmış.", "The '{c.deger}' variant is written twice."))
            return
        }
        var alan_adlari: [text] = []
        var alan_tipleri: [text] = []
        var alanlar = c.cocuklar[1].cocuklar
        repeat j from 1 to alanlar.length {
            var a = alanlar[j]
            if _icinde_mi(a.deger, alan_adlari) {
                _hata(a, dil.sec("'{a.deger}' alanı iki kere yazılmış.", "The '{a.deger}' field is written twice."))
                return
            }
            alan_adlari.add(a.deger)
            alan_tipleri.add(tip_coz(a.cocuklar[1]))     # kendi enum'una işaret edebilir (ağaçlar için)
            if not _tamam() {
                return
            }
        }
        adlar.add(c.deger)
        tum_alan_adlari.add(alan_adlari)
        tum_alan_tipleri.add(alan_tipleri)
    }
    b.cesitler = adlar
    b.alan_adlari = tum_alan_adlari
    b.alan_tipleri = tum_alan_tipleri
    ENUMLAR[t.deger] = b
}

fn _enum_adi_mi(d: parser.Dugum) -> bool {
    return d.tur is "Isim" and ENUMLAR.has(d.deger) and _ara(d.deger) is none
}

# Odeme.Nakit  /  Odeme.Kart(no: "1234", taksit: 3)
fn _enum_olusturma(e: parser.Dugum) -> parser.Dugum {
    var b = ENUMLAR[e.cocuklar[1].deger]
    var nesne = _t(e.cocuklar[1], b.ad)
    var no = _sira(e.deger, b.cesitler)
    if no is 0 {
        _hata(e, dil.sec("'{b.ad}' enum'unun '{e.deger}' diye bir çeşidi yok.{oneri.oneri(e.deger, b.cesitler)}", "The '{b.ad}' enum has no variant called '{e.deger}'.{oneri.oneri(e.deger, b.cesitler)}"))
        return e
    }
    var alan_adlari = b.alan_adlari[no]
    var alan_tipleri = b.alan_tipleri[no]
    var metot_mu = e.tur is "MetotCagrisi"
    var ornek = "{b.ad}.{e.deger}"
    if alan_adlari.length > 0 {
        var parcalar: [text] = []
        repeat i from 1 to alan_adlari.length {
            parcalar.add("{alan_adlari[i]}: ...")
        }
        ornek = "{b.ad}.{e.deger}({parcalar.join(", ")})"
    }
    if metot_mu and (e.cocuklar[2].cocuklar.length > 0 or not _bos_mu(e.cocuklar[3])) {
        _hata(e, dil.sec("Çeşidin alanlarına değerler adlarıyla verilir:   {ornek}", "Values for a variant's fields are given with names:   {ornek}"))
        return e
    }
    if alan_adlari.length > 0 and not metot_mu {
        _hata(e, dil.sec("'{e.deger}' çeşidinin alanları var, değerlerini ver:   {ornek}", "The '{e.deger}' variant has fields; give their values:   {ornek}"))
        return e
    }
    if alan_adlari.length is 0 and metot_mu {
        _hata(e, dil.sec("'{e.deger}' çeşidinin alanı yok; parantez olmadan yaz:   {b.ad}.{e.deger}", "The '{e.deger}' variant has no fields; write it without parentheses:   {b.ad}.{e.deger}"))
        return e
    }
    if not metot_mu {
        return _c(e, [nesne], b.ad)
    }
    var isimli = e.cocuklar[4].cocuklar
    var verilen: [text] = []
    var tipli: [parser.Dugum] = []
    repeat i from 1 to isimli.length {
        var x = isimli[i]
        var sira = _sira(x.deger, alan_adlari)
        if sira is 0 {
            _hata(x, dil.sec("'{e.deger}' çeşidinin '{x.deger}' diye bir alanı yok.{oneri.oneri(x.deger, alan_adlari)}", "The '{e.deger}' variant has no field called '{x.deger}'.{oneri.oneri(x.deger, alan_adlari)}"))
            return e
        }
        if _icinde_mi(x.deger, verilen) {
            _hata(x, dil.sec("'{x.deger}' alanına iki kere değer verilmiş.", "The '{x.deger}' field was given a value twice."))
            return e
        }
        var g = _ifade(x.cocuklar[1], alan_tipleri[sira])
        if not _tamam() {
            return e
        }
        if not uyumlu_mu(alan_tipleri[sira], g.tip) {
            _hata(x.cocuklar[1], dil.sec("'{x.deger}' alanı {tip_aciklama(alan_tipleri[sira])}, ona {tip_aciklama(g.tip)} verilemez.", "The '{x.deger}' field is {tip_aciklama(alan_tipleri[sira])}; it can't be given {tip_aciklama(g.tip)}."))
            return e
        }
        verilen.add(x.deger)
        tipli.add(_c(x, [g], ""))
    }
    var eksik: [text] = []
    repeat i from 1 to alan_adlari.length {
        if not _icinde_mi(alan_adlari[i], verilen) {
            eksik.add(alan_adlari[i])
        }
    }
    if eksik.length > 0 {
        _hata(e, dil.sec("'{e.deger}' oluşturulurken şu alanlara değer verilmedi: {eksik.join(", ")}   Örnek:   {ornek}", "When creating '{e.deger}', these fields were not given values: {eksik.join(", ")}   Example:   {ornek}"))
        return e
    }
    return _c(e, [nesne, e.cocuklar[2], e.cocuklar[3], _liste(tipli)], b.ad)
}

fn _match_komutu(k: parser.Dugum) -> parser.Dugum {
    use change YIGIN
    use change KAPANAN
    var deger = _ifade(k.cocuklar[1], "")
    if not _tamam() {
        return k
    }
    var t = deger.tip
    if not ENUMLAR.has(t) {
        _hata(k.cocuklar[1], dil.sec("'match' bir enum değeri ister, burada {tip_aciklama(t)} var.\n   (Diğer değerler için if / else if kullan.)", "'match' needs an enum value, but here there is {tip_aciklama(t)}.\n   (For other values use if / else if.)"))
        return k
    }
    var b = ENUMLAR[t]
    var gorulen: [text] = []
    var tipli_durumlar: [parser.Dugum] = []
    var durumlar = k.cocuklar[2].cocuklar
    repeat i from 1 to durumlar.length {
        var d = durumlar[i]
        var no = _sira(d.deger, b.cesitler)
        if no is 0 {
            _hata(d, dil.sec("'{b.ad}' enum'unun '{d.deger}' diye bir çeşidi yok.{oneri.oneri(d.deger, b.cesitler)}", "The '{b.ad}' enum has no variant called '{d.deger}'.{oneri.oneri(d.deger, b.cesitler)}"))
            return k
        }
        if _icinde_mi(d.deger, gorulen) {
            _hata(d, dil.sec("'{d.deger}' durumu iki kere yazılmış.", "The '{d.deger}' case is written twice."))
            return k
        }
        gorulen.add(d.deger)
        var alan_adlari = b.alan_adlari[no]
        var alan_tipleri = b.alan_tipleri[no]
        var adlar: [text] = []
        if d.ek.length > 0 {
            adlar = d.ek.split(",")
        }
        if adlar.length > 0 and adlar.length is not alan_adlari.length {
            var ornek = d.deger
            if alan_adlari.length > 0 {
                ornek = "{d.deger}({alan_adlari.join(", ")})"
            }
            _hata(d, dil.sec("'{d.deger}' çeşidinin {alan_adlari.length} alanı var, {adlar.length} ad verilmiş.   Örnek:   {ornek} \{ ... \}", "The '{d.deger}' variant has {alan_adlari.length} field(s), but {adlar.length} name(s) were given.   Example:   {ornek} \{ ... \}"))
            return k
        }
        YIGIN.add({})
        repeat j from 1 to adlar.length {
            if _ara(adlar[j]) is not none {
                _hata(d, dil.sec("'{adlar[j]}' adında bir değişken zaten var; alana başka bir ad ver.", "There is already a variable named '{adlar[j]}'; give the field a different name."))
                return k
            }
            _koy(Degisken(ad: adlar[j], tip: alan_tipleri[j], tur: "eslesme", satir: d.satir))
        }
        var govde: [parser.Dugum] = []
        var komutlar = d.cocuklar[1].cocuklar
        repeat j from 1 to komutlar.length {
            govde.add(_komut(komutlar[j]))
            if not _tamam() {
                return k
            }
        }
        var son = YIGIN[YIGIN.length]
        var son_adlar = son.keys()
        repeat j from 1 to son_adlar.length {
            KAPANAN[son_adlar[j]] = son[son_adlar[j]].satir
        }
        YIGIN.remove(YIGIN.length)
        tipli_durumlar.add(_c(d, [_liste(govde)], ""))
    }
    var eksik: [text] = []
    repeat i from 1 to b.cesitler.length {
        if not _icinde_mi(b.cesitler[i], gorulen) {
            eksik.add(b.cesitler[i])
        }
    }
    var degilse = k.cocuklar[3]
    if eksik.length > 0 and _bos_mu(degilse) {
        _hata(k, dil.sec("match '{b.ad}' değerinin şu çeşitlerini ele almıyor: {eksik.join(", ")}\n   Hepsini yaz ya da geri kalanlar için bir 'else \{ ... \}' ekle.", "match doesn't handle these variants of '{b.ad}': {eksik.join(", ")}\n   Write all of them, or add an 'else \{ ... \}' for the rest."))
        return k
    }
    if not _bos_mu(degilse) {
        if eksik.length is 0 {
            _hata(k, dil.sec("Bütün çeşitler zaten yazılmış; 'else' hiç çalışmaz, silebilirsin.", "All variants are already written; 'else' will never run, you can delete it."))
            return k
        }
        degilse = _liste(_blok(degilse.cocuklar, none, []))
    }
    return _c(k, [deger, _liste(tipli_durumlar), degilse], "")
}

# =====================================================================
#  WHEN
# =====================================================================
# arena { ... }: içindeki geçici değerler blok bitince toplu silinir (çalışma zamanı ve üretici halleder)
fn _arena_blok(k: parser.Dugum) -> parser.Dugum {
    use change DONGU
    use change ARENA
    var onceki = DONGU                               # dışarıdaki döngünün stop/skip'i yok
    DONGU = 0
    ARENA = ARENA + 1
    _baglam_ac("arena")
    var govde = _blok(k.cocuklar[1].cocuklar, none, [])
    _baglam_kapat()
    ARENA = ARENA - 1
    DONGU = onceki
    return _c(k, [_liste(govde)], "")
}

fn _when_komutu(k: parser.Dugum) -> parser.Dugum {
    use change DONGU
    use change WHEN
    use change WHEN_IZLENEN
    var kosul = _sart_olmali(k.cocuklar[1], "when")
    if not _tamam() {
        return k
    }
    var bos: [text] = []
    var izlenenler = _sirala(_adlari_topla(kosul, bos))
    if izlenenler.length is 0 {
        _hata(k.cocuklar[1], dil.sec("when'in şartında hiç değişken yok; şart hiçbir zaman değişmez, when hiç çalışmaz.", "There is no variable in when's condition; the condition never changes, so when never runs."))
        return k
    }
    repeat i from 1 to izlenenler.length {
        var d = bul(izlenenler[i], k.cocuklar[1])
        if not _tamam() {
            return k
        }
        if d.tur is "sayac" {
            _hata(k.cocuklar[1], dil.sec("'{izlenenler[i]}' bir döngü sayacı; when döngü sayaçlarını izleyemez.", "'{izlenenler[i]}' is a loop counter; when can't watch loop counters."))
            return k
        }
        WHEN_IZLENEN = _ekle_tekil(WHEN_IZLENEN, _anahtar_bul(izlenenler[i]))
    }
    var onceki = DONGU                               # when bloğunun içinde: return yok, dışarıdaki döngünün stop/skip'i yok
    DONGU = 0
    WHEN = WHEN + 1
    _baglam_ac("when")
    var govde = _blok(k.cocuklar[2].cocuklar, none, [])
    _baglam_kapat()
    WHEN = WHEN - 1
    DONGU = onceki
    return _c(k, [kosul, _liste(govde)], "")
}

# =====================================================================
#  WINDOW: görsel arayüz
# =====================================================================
fn _pencere(k: parser.Dugum) -> parser.Dugum {
    use change PENCERE_SATIR
    _ana_izin_ekle(k, ["screen"])
    if FN.length > 0 or YIGIN.length > 0 {
        _hata(k, dil.sec("'window' şimdilik sadece ana programın en dışında yazılabilir (bir fonksiyonun ya da bloğun içinde değil).", "'window' can currently only be written at the outermost level of the main program (not inside a function or block)."))
        return k
    }
    if PENCERE_SATIR > 0 {
        _hata(k, dil.sec("Şimdilik bir programda tek pencere olabilir (ilki satır {PENCERE_SATIR}'de).", "For now a program can have only one window (the first one is on line {PENCERE_SATIR})."))
        return k
    }
    PENCERE_SATIR = k.satir
    var baslik = _ifade(k.cocuklar[1], "")
    if not _tamam() {
        return k
    }
    repeat i from 1 to baslik.cocuklar.length {
        if baslik.cocuklar[i].tur is not "Parca" {
            _hata(k.cocuklar[1], dil.sec("Pencere başlığı sabit bir metin olmalı (içinde \{değer\} olamaz).", "The window title must be a constant text (it can't contain \{value\})."))
            return k
        }
    }
    var ogeler = _arayuz_ogeleri(k.cocuklar[2].cocuklar, false)
    return _c(k, [baslik, _liste(ogeler)], "")
}

fn _arayuz_ogeleri(ogeler: [parser.Dugum], liste_icinde: bool) -> [parser.Dugum] {
    use change DONGU
    var sonuc: [parser.Dugum] = []
    repeat i from 1 to ogeler.length {
        if not _tamam() {
            return sonuc
        }
        var o = ogeler[i]
        var tur = o.deger
        if tur is "row" {
            var ic = _arayuz_ogeleri(o.cocuklar[3].cocuklar, liste_icinde)
            sonuc.add(_c(o, [o.cocuklar[1], o.cocuklar[2], _liste(ic), o.cocuklar[4]], ""))
            skip
        }
        if tur is "list" {
            sonuc.add(_liste_gorunumu(o, liste_icinde))
            skip
        }
        if liste_icinde and (tur is "textbox" or tur is "checkbox") {
            _hata(o, dil.sec("'{tur}' şimdilik bir list'in satırlarına konamaz; sadece label, button ve row olabilir.", "'{tur}' can't be put in the rows of a list yet; only label, button and row can."))
            return sonuc
        }
        var metin = _ifade(o.cocuklar[1], "")
        if not _tamam() {
            return sonuc
        }
        if not _yazdirilabilir(metin.tip) {
            _hata(o.cocuklar[1], dil.sec("'{tur}' yazısı olarak sayı, metin ya da bool yazılabilir; burada {tip_aciklama(metin.tip)} var.", "As the text of '{tur}' you can write a number, text or bool; but here there is {tip_aciklama(metin.tip)}."))
            return sonuc
        }
        var govde = o.cocuklar[2]
        if tur is "button" {
            var onceki = DONGU                       # düğmenin bloğu ana programın bir parçası gibi çalışır
            DONGU = 0
            govde = _liste(_blok(o.cocuklar[2].cocuklar, none, []))
            DONGU = onceki
        } else if tur is "textbox" or tur is "checkbox" {
            var hedef = o.ek.split(",")[1]
            var d = degistirilebilir_olmali(hedef, o)
            if not _tamam() {
                return sonuc
            }
            var uygun = d.tip is "int" or d.tip is "float" or d.tip is "text"
            var uygun_yazi = "int / float / text"
            var ornek = dil.sec("textbox \"Adın\" -> ad   (var ad = \"\")", "textbox \"Your name\" -> name   (var name = \"\")")
            if tur is "checkbox" {
                uygun = d.tip is "bool"
                uygun_yazi = "bool"
                ornek = dil.sec("checkbox \"Kabul ediyorum\" -> onay   (var onay = false)", "checkbox \"I agree\" -> agreed   (var agreed = false)")
            }
            if not uygun {
                _hata(o, dil.sec("'{hedef}' bir {tip_aciklama(d.tip)}; {tur} sadece {uygun_yazi} bir değişkene bağlanabilir.\n   Örnek:   {ornek}", "'{hedef}' is {tip_aciklama(d.tip)}; {tur} can only be bound to a {uygun_yazi} variable.\n   Example:   {ornek}"))
                return sonuc
            }
        }
        sonuc.add(_c(o, [metin, govde, o.cocuklar[3], o.cocuklar[4]], ""))
    }
    return sonuc
}

# list urun, i in urunler -> secili { şablon }
fn _liste_gorunumu(o: parser.Dugum, liste_icinde: bool) -> parser.Dugum {
    use change YIGIN
    if liste_icinde {
        _hata(o, dil.sec("Bir list'in satırının içine başka bir list konamaz (şimdilik).", "A list can't be put inside a row of another list (for now)."))
        return o
    }
    var kaynak = _ifade(o.cocuklar[4], "")
    if not _tamam() {
        return o
    }
    var t = kaynak.tip
    if not liste_mi(t) or t is "[?]" {
        _hata(o.cocuklar[4], dil.sec("'list ... in' bir liste ister, burada {tip_aciklama(t)} var.", "'list ... in' needs a list, but here there is {tip_aciklama(t)}."))
        return o
    }
    var parcalar = o.ek.split(",")
    var hedef = parcalar[1]
    var eleman = parcalar[2]
    var sira_adi = parcalar[3]
    if hedef.length > 0 {
        var d = degistirilebilir_olmali(hedef, o)
        if not _tamam() {
            return o
        }
        if d.tip is not "int" {
            _hata(o, dil.sec("Seçilen satırın sırası bir int (tam sayı) değişkene bağlanır; '{hedef}' bir {tip_aciklama(d.tip)}.\n   Örnek:   var secili = 0   (0 = seçim yok)", "The position of the selected row is bound to an int (integer) variable; '{hedef}' is {tip_aciklama(d.tip)}.\n   Example:   var selected = 0   (0 = nothing selected)"))
            return o
        }
    }
    # Şablonun içinde: eleman ve sıra numarası okunabilir ama değiştirilemez
    YIGIN.add({})
    var adlar = [eleman, sira_adi]
    var tipler = [_ic(t), "int"]
    repeat i from 1 to 2 {
        if adlar[i].length > 0 {
            if _ara(adlar[i]) is not none {
                _hata(o, dil.sec("'{adlar[i]}' adında bir değişken zaten var; satırdaki elemana başka bir ad ver.", "There is already a variable named '{adlar[i]}'; give the item in the row a different name."))
                return o
            }
            _koy(Degisken(ad: adlar[i], tip: tipler[i], tur: "satir", satir: o.satir))
        }
    }
    if sira_adi.length > 0 and sira_adi is eleman {
        _hata(o, dil.sec("Eleman ile sıra numarasına farklı adlar ver (ör: list urun, i in urunler).", "Give the item and the position number different names (e.g. list product, i in products)."))
        return o
    }
    var ic = _arayuz_ogeleri(o.cocuklar[3].cocuklar, true)
    YIGIN.remove(YIGIN.length)
    return _c(o, [o.cocuklar[1], o.cocuklar[2], _liste(ic), kaynak], "")
}

# =====================================================================
#  EXTERN: C'de yazılmış hazır fonksiyonlar
# =====================================================================
fn _c_tipi(t: parser.Dugum, ne: text) -> text {
    if t.tur is "TipAdi" and (t.deger is "i32" or t.deger is "u8") {
        return "int"
    }
    if t.tur is "TipAdi" and t.deger is "f32" {
        return "float"
    }
    var vt = tip_coz(t)
    if not _tamam() {
        return vt
    }
    if not EXTERN_TIPLERI.has(vt) and not C_YAPILARI.has(vt) {
        _hata(t, dil.sec("{ne} C'ye {tip_aciklama(vt)} verilemez/alınamaz. Kullanılabilenler: int, i32, u8, float, f32, bool, text, ptr, bytes (sadece değer olarak verilir) ve extern içinde tanımlanan C yapıları (type ...)", "{ne} {tip_aciklama(vt)} can't be given to or taken from C. Allowed: int, i32, u8, float, f32, bool, text, ptr, bytes (only passed in) and C structs defined inside extern (type ...)"))
    }
    return vt
}

# extern içindeki bir C yapısının alanı: Vash'taki tipi ve C'deki tipi
fn _c_alan_tipi(t: parser.Dugum) -> text {
    if t.tur is "TipAdi" {
        if t.deger is "int" { return "i64" }
        if t.deger is "i32" { return "i32" }
        if t.deger is "u8" or t.deger is "bool" { return "i8" }
        if t.deger is "float" { return "double" }
        if t.deger is "f32" { return "float" }
        if t.deger is "ptr" { return "i64" }         # C'deki adres (8 bayt); Vash'ta ptr
    }
    return ""
}

# extern "kutuphane" { type Renk { r: u8 ... } }: alanları Vash tipine çevirip normal bir tip gibi kaydet
fn _c_yapi_ayrintilari(t: parser.Dugum) -> parser.Dugum {
    use change C_YAPILARI
    if t.cocuklar[2].cocuklar.length > 0 {
        _hata(t.cocuklar[2].cocuklar[1], dil.sec("extern içindeki C yapılarının metodu olamaz; metotları Vash'ta ayrı bir fonksiyon olarak yaz.", "C structs inside extern can't have methods; write the methods as separate functions in Vash."))
        return t
    }
    var c_tipleri: [text] = []
    var alanlar: [parser.Dugum] = []
    var eski = t.cocuklar[1].cocuklar
    repeat i from 1 to eski.length {
        var a = eski[i]
        var c = _c_alan_tipi(a.cocuklar[1])
        if c.length is 0 {
            _hata(a.cocuklar[1], dil.sec("C yapısının alanı int, i32, u8, bool, float, f32 ya da ptr olabilir (C'nin bellekteki biçimi bilinmeli).", "A C struct field can be int, i32, u8, bool, float, f32 or ptr (C's memory layout must be known)."))
            return t
        }
        c_tipleri.add(c)
        var vash_tipi = "int"
        if c is "double" or c is "float" {
            vash_tipi = "float"
        }
        if a.cocuklar[1].deger is "bool" {
            vash_tipi = "bool"
        }
        if a.cocuklar[1].deger is "ptr" {
            vash_tipi = "ptr"
        }
        var tip_d = parser.Dugum(tur: "TipAdi", deger: vash_tipi, ek: "", cocuklar: [], satir: a.cocuklar[1].satir, sutun: a.cocuklar[1].sutun, dosya: a.cocuklar[1].dosya)
        alanlar.add(_c(a, [tip_d, a.cocuklar[2]], ""))
    }
    C_YAPILARI[t.deger] = c_tipleri
    return _tip_ayrintilari(_c(t, [_liste(alanlar), t.cocuklar[2]], ""))
}

fn _extern_kaydet(blok: parser.Dugum) {
    use change FONKSIYONLAR
    if KUM and not _std_dosyasi_mi(blok.dosya) {
        _hata(blok, dil.sec("Kum havuzu: programın kendi dosyalarında C kodu (extern) kullanılamaz; sadece Vash'ın hazır modülleri C'ye bağlanabilir.", "Sandbox: the program's own files can't use C code (extern); only Vash's built-in modules may connect to C."))
        return
    }
    if blok.cocuklar[1].cocuklar.length > 0 {
        _c_kutuphane_ekle("{blok.deger}|{blok.dosya}")
    }
    var izinler: [text] = []
    var izin_dugumleri = blok.cocuklar[2].cocuklar
    repeat i from 1 to izin_dugumleri.length {
        var t = izin_dugumleri[i]
        if not IZINLER.has(t.deger) {
            _hata(t, dil.sec("'{t.deger}' diye bir izin yok.{oneri.oneri(t.deger, IZINLER.keys())}\n   İzinler: {IZINLER.keys().join(", ")}", "There is no permission called '{t.deger}'.{oneri.oneri(t.deger, IZINLER.keys())}\n   Permissions: {IZINLER.keys().join(", ")}"))
            return
        }
        if not _icinde_mi(t.deger, izinler) {
            izinler.add(t.deger)
        }
    }
    var fonksiyonlar = blok.cocuklar[1].cocuklar
    repeat i from 1 to fonksiyonlar.length {
        var f = fonksiyonlar[i]
        if _yerlesik_mi(f.deger) or FONKSIYONLAR.has(f.deger) {
            _hata(f, dil.sec("'{f.deger}' adında bir fonksiyon zaten var.", "There is already a function named '{f.deger}'."))
            return
        }
        var p_adlar: [text] = []
        var p_tipler: [text] = []
        var parametreler = f.cocuklar[1].cocuklar
        repeat j from 1 to parametreler.length {
            var p = parametreler[j]
            var vt = _c_tipi(p.cocuklar[1], dil.sec("'{p.deger}' parametresi olarak", "As the '{p.deger}' parameter,"))
            if not _tamam() {
                return
            }
            p_adlar.add(p.deger)
            p_tipler.add(vt)
        }
        var donus = "void"
        if not _bos_mu(f.cocuklar[2]) {
            donus = _c_tipi(f.cocuklar[2], dil.sec("Dönüş değeri olarak", "As a return value,"))
            if not _tamam() {
                return
            }
        }
        FONKSIYONLAR[f.deger] = Fonksiyon(ad: f.deger, p_adlar: p_adlar, p_tipler: p_tipler, donus: donus, satir: f.satir, izinler: izinler, c_mi: true)
    }
}

# =====================================================================
#  ANA AKIŞ: 4 tur
# =====================================================================
# =====================================================================
#  PARALLEL: aynı anda çalışan işler aynı değişkene dokunuyor mu?
# =====================================================================
#  Her değişkene bir "anahtar" verilir:
#     "ana:X"   ana programın değişkeni (fonksiyonlar 'use' ile görür) ya da global
#     "yerel:X" bulunduğumuz fonksiyonun / bloğun değişkeni
#     "alan:X"  metodun içindeyken nesnenin alanı
#  Her iş için "neyi okuyor, neyi değiştiriyor, hangi fonksiyonları çağırıyor" toplanır.
#  Fonksiyonların etkisi, çağırdıkları fonksiyonlarınkiyle birlikte (sonuna kadar) hesaplanır.

fn _anahtar_bul(ad: text) -> text {
    repeat i from YIGIN.length to 1 step -1 {
        if YIGIN[i].has(ad) {
            var d = YIGIN[i][ad]
            if d.tur is "global" or d.tur is "dis-okur" or d.tur is "dis-degistirir" {
                return "ana:{ad}"
            }
            return "yerel:{ad}"
        }
    }
    if ANA.has(ad) and (FN.length is 0 or ANA[ad].tur is "global") {
        return "ana:{ad}"
    }
    if TIP_ICINDE.length > 0 and _icinde_mi(ad, TIPLER[TIP_ICINDE].alan_adlari) {
        return "alan:{ad}"
    }
    return ""
}

# Şu an görünen bütün değişkenler ve anahtarları
fn _disaridakiler() -> Etki {
    var adlar: [text] = []
    repeat i from 1 to YIGIN.length {
        var anahtarlar = YIGIN[i].keys()
        repeat j from 1 to anahtarlar.length {
            if not _icinde_mi(anahtarlar[j], adlar) {
                adlar.add(anahtarlar[j])
            }
        }
    }
    var ana_adlar = ANA.keys()
    repeat j from 1 to ana_adlar.length {
        if not _icinde_mi(ana_adlar[j], adlar) and (FN.length is 0 or ANA[ana_adlar[j]].tur is "global") {
            adlar.add(ana_adlar[j])
        }
    }
    if TIP_ICINDE.length > 0 {
        var alanlar = TIPLER[TIP_ICINDE].alan_adlari
        repeat j from 1 to alanlar.length {
            if not _icinde_mi(alanlar[j], adlar) {
                adlar.add(alanlar[j])
            }
        }
    }
    var anahtarlar: [text] = []
    repeat i from 1 to adlar.length {
        anahtarlar.add(_anahtar_bul(adlar[i]))
    }
    return Etki(okur: adlar, yazar: anahtarlar, cagirir: [])          # (burada okur = adlar, yazar = anahtarlar)
}

fn _paralel_blok(k: parser.Dugum) -> parser.Dugum {
    use change DONGU
    use change PARALEL
    use change PARALEL_KAYITLARI
    var dis = _disaridakiler()
    var adlar = dis.okur
    var anahtarlar = dis.yazar
    var onceki = DONGU                               # dışarıdaki döngünün stop/skip'i yok
    DONGU = 0
    PARALEL = PARALEL + 1
    _baglam_ac("parallel")
    var gorevler: [parser.Dugum] = []
    var komutlar = k.cocuklar[1].cocuklar
    repeat i from 1 to komutlar.length {
        if komutlar[i].tur is "DegiskenTanimi" and komutlar[i].ek is "global" {
            _hata(komutlar[i], dil.sec("'global var' bir parallel bloğunun içinde yazılamaz.", "'global var' can't be written inside a parallel block."))
            stop
        }
        gorevler.add(_komut(komutlar[i]))            # bloktaki her komut ayrı bir iş; 'var' ile oluşan bloktan sonra da görünür
        if not _tamam() {
            stop
        }
    }
    _baglam_kapat()
    PARALEL = PARALEL - 1
    DONGU = onceki
    var tipli = _c(k, [_liste(gorevler)], "")
    if not _tamam() {
        return tipli
    }
    repeat i from 1 to gorevler.length {             # işlerin oluşturduğu değişkenler de diğer işler için "dışarısı"
        if gorevler[i].tur is "DegiskenTanimi" {
            adlar.add(gorevler[i].deger)
            anahtarlar.add(_anahtar_bul(gorevler[i].deger))
        }
    }
    PARALEL_KAYITLARI.add(ParalelKaydi(tur: "blok", dugum: tipli, adlar: adlar, anahtarlar: anahtarlar, sayac: "", tip_icinde: TIP_ICINDE))
    return tipli
}

fn _paralel_tekrar(k: parser.Dugum) -> parser.Dugum {
    use change PARALEL
    use change PARALEL_KAYITLARI
    if not _bos_mu(k.cocuklar[3]) {
        _hata(k.cocuklar[3], dil.sec("'parallel repeat' içinde 'step' kullanılamaz (şimdilik); turlar 1'er 1'er ilerler.", "'step' can't be used inside 'parallel repeat' (for now); the rounds go up 1 at a time."))
        return k
    }
    var dis = _disaridakiler()
    var parcalar: [parser.Dugum] = []
    var adlar = ["from", "to"]
    repeat i from 1 to 2 {
        var t = _ifade(k.cocuklar[i], "")
        if not _tamam() {
            return k
        }
        if t.tip is not "int" {
            _hata(k.cocuklar[i], dil.sec("'{adlar[i]}' bir tam sayı (int) olmalı, burada {tip_aciklama(t.tip)} var.", "'{adlar[i]}' must be an integer (int), but here there is {tip_aciklama(t.tip)}."))
            return k
        }
        parcalar.add(t)
    }
    parcalar.add(k.cocuklar[3])
    if _ara(k.deger) is not none {
        _hata(k, dil.sec("'{k.deger}' adında bir değişken zaten var; sayaca başka bir ad ver.", "There is already a variable named '{k.deger}'; give the loop counter a different name."))
        return k
    }
    var sayac = Degisken(ad: k.deger, tip: "int", tur: "sayac", satir: k.satir)
    PARALEL = PARALEL + 1
    _baglam_ac("parallel")
    var govde = _dongu(k.cocuklar[4].cocuklar, sayac, [])
    _baglam_kapat()
    PARALEL = PARALEL - 1
    parcalar.add(_liste(govde))
    var tipli = _c(k, parcalar, "")
    if _tamam() {
        PARALEL_KAYITLARI.add(ParalelKaydi(tur: "tekrar", dugum: tipli, adlar: dis.okur, anahtarlar: dis.yazar, sayac: k.deger, tip_icinde: TIP_ICINDE))
    }
    return tipli
}

fn _ekle_tekil(l: [text], x: text) -> [text] {
    var s = l
    if x.length > 0 and not _icinde_mi(x, s) {
        s.add(x)
    }
    return s
}

fn _anahtari(ad: text, adlar: [text], anahtarlar: [text]) -> text {
    repeat i from 1 to adlar.length {
        if adlar[i] is ad {
            return anahtarlar[i]
        }
    }
    return ""
}

fn _degistiren_metot_mu(e: parser.Dugum) -> bool {
    var t = e.cocuklar[1].tip
    if liste_mi(t) {
        return e.deger is "add" or e.deger is "remove" or e.deger is "sort"
    }
    if t is "bytes" {
        return e.deger is "add" or e.deger is "add_int"
    }
    if sozluk_mu(t) {
        return e.deger is "remove"
    }
    if TIPLER.has(t) and TIPLER[t].metotlar.has(e.deger) {
        return TIPLER[t].metotlar[e.deger].degistirir
    }
    return false
}

# Bir ağaç parçasının etkisi. eleman_listeleri: parallel repeat'te sadece kendi sırasından (L[sayac]) dokunulan listeler.
fn _etki(d: parser.Dugum, adlar: [text], anahtarlar: [text], e: Etki, tip_icinde: text, eleman_listeleri: [text], sayac: text) -> Etki {
    var sonuc = e
    var tur = d.tur
    var c = d.cocuklar
    if eleman_listeleri.length > 0 {
        if tur is "Erisim" and c[1].tur is "Isim" and _icinde_mi(c[1].deger, eleman_listeleri) and c[2].tur is "Isim" and c[2].deger is sayac {
            return sonuc                             # L[i]: kendi sırası
        }
        if tur is "Ozellik" and d.deger is "length" and c[1].tur is "Isim" and _icinde_mi(c[1].deger, eleman_listeleri) {
            return sonuc                             # L.length değişmiyor
        }
        if tur is "ElemanAtama" and c[1].tur is "Isim" and _icinde_mi(c[1].deger, eleman_listeleri) and c[2].tur is "Isim" and c[2].deger is sayac {
            return _etki(c[3], adlar, anahtarlar, sonuc, tip_icinde, eleman_listeleri, sayac)
        }
    }
    if tur is "Isim" {
        sonuc.okur = _ekle_tekil(sonuc.okur, _anahtari(d.deger, adlar, anahtarlar))
    } else if tur is "Atama" {
        sonuc.yazar = _ekle_tekil(sonuc.yazar, _anahtari(d.deger, adlar, anahtarlar))
    } else if (tur is "ElemanAtama" or tur is "AlanAtama") and _kok_adi(c[1]).length > 0 {
        sonuc.yazar = _ekle_tekil(sonuc.yazar, _anahtari(_kok_adi(c[1]), adlar, anahtarlar))
    } else if tur is "MetotCagrisi" {
        if _kok_adi(c[1]).length > 0 and _degistiren_metot_mu(d) {
            sonuc.yazar = _ekle_tekil(sonuc.yazar, _anahtari(_kok_adi(c[1]), adlar, anahtarlar))
        }
        if TIPLER.has(c[1].tip) {
            sonuc.cagirir = _ekle_tekil(sonuc.cagirir, "metot:{c[1].tip}.{d.deger}")
        }
        if d.deger is "sort" and c[4].cocuklar.length is 1 {      # liste.sort(by: f): f de çağrılır
            sonuc.cagirir = _ekle_tekil(sonuc.cagirir, "fn:{c[4].cocuklar[1].cocuklar[1].deger}")
            return sonuc
        }
    } else if tur is "Cagri" {
        var ad = d.deger
        if tip_icinde.length > 0 and TIPLER.has(tip_icinde) and TIPLER[tip_icinde].metotlar.has(ad) {
            sonuc.cagirir = _ekle_tekil(sonuc.cagirir, "metot:{tip_icinde}.{ad}")
        } else if FONKSIYONLAR.has(ad) and not FONKSIYONLAR[ad].c_mi {
            sonuc.cagirir = _ekle_tekil(sonuc.cagirir, "fn:{ad}")
        }
    }
    repeat i from 1 to c.length {
        sonuc = _etki(c[i], adlar, anahtarlar, sonuc, tip_icinde, eleman_listeleri, sayac)
    }
    return sonuc
}

# a[i].b[j] → "a" (iç içe değiştirmede değişen değişken); geçici bir değerse ""
fn _kok_adi(d: parser.Dugum) -> text {
    var k = d
    repeat while k.tur is "Erisim" or k.tur is "Ozellik" {
        k = k.cocuklar[1]
    }
    if k.tur is "Isim" {
        return k.deger
    }
    return ""
}

fn _bos_etki() -> Etki {
    return Etki(okur: [], yazar: [], cagirir: [])
}

# Bir fonksiyonun gövdesinde ana programa ait adlar: 'use' ile çağrılanlar ve globaller (yerel adlar hariç)
fn _yerel_adlari_topla(d: parser.Dugum, adlar: [text]) -> [text] {
    var s = adlar
    if d.tur is "DegiskenTanimi" or d.tur is "TekrarSayac" or d.tur is "ParalelTekrar" {
        s = _ekle_tekil(s, d.deger)
    }
    if d.tur is "MatchDurumu" and d.ek.length > 0 {
        var b = d.ek.split(",")
        repeat i from 1 to b.length {
            s = _ekle_tekil(s, b[i])
        }
    }
    repeat i from 1 to d.cocuklar.length {
        s = _yerel_adlari_topla(d.cocuklar[i], s)
    }
    return s
}

fn _use_adlari(d: parser.Dugum, adlar: [text]) -> [text] {
    var s = adlar
    if d.tur is "UseKomutu" and not IZINLER.has(d.deger) {
        s = _ekle_tekil(s, d.deger)
    }
    repeat i from 1 to d.cocuklar.length {
        s = _use_adlari(d.cocuklar[i], s)
    }
    return s
}

fn _fonksiyon_etkisi(f: parser.Dugum, tip_adi: text) -> Etki {
    var govde = _liste(f.cocuklar[3].cocuklar)
    var yereller: [text] = []
    var parametreler = f.cocuklar[1].cocuklar
    repeat i from 1 to parametreler.length {
        yereller.add(parametreler[i].deger)
    }
    yereller = _yerel_adlari_topla(govde, yereller)
    var bos: [text] = []
    var adlar = _use_adlari(govde, bos)
    var ana_adlar = ANA.keys()
    repeat i from 1 to ana_adlar.length {
        if ANA[ana_adlar[i]].tur is "global" and not _icinde_mi(ana_adlar[i], yereller) {
            adlar = _ekle_tekil(adlar, ana_adlar[i])
        }
    }
    var anahtarlar: [text] = []
    repeat i from 1 to adlar.length {
        anahtarlar.add("ana:{adlar[i]}")
    }
    return _etki(govde, adlar, anahtarlar, _bos_etki(), tip_adi, bos, "")
}

fn _birlestir(a: [text], b: [text]) -> [text] {
    var s = a
    repeat i from 1 to b.length {
        s = _ekle_tekil(s, b[i])
    }
    return s
}

fn _gorunen_ad(anahtar: text) -> text {
    var p = anahtar.split(":")
    return p[p.length]
}

fn _kesisim(a: [text], b: [text]) -> text {
    repeat i from 1 to a.length {
        if _icinde_mi(a[i], b) {
            return a[i]
        }
    }
    return ""
}

# Bir iş/gövde ile çağırdığı fonksiyonların toplam etkisi
fn _toplam_etki(e: Etki, fonksiyon_etkileri: {text: Etki}) -> Etki {
    var sonuc = e
    repeat i from 1 to e.cagirir.length {
        if fonksiyon_etkileri.has(e.cagirir[i]) {
            var f = fonksiyon_etkileri[e.cagirir[i]]
            sonuc.okur = _birlestir(sonuc.okur, f.okur)
            sonuc.yazar = _birlestir(sonuc.yazar, f.yazar)
        }
    }
    return sonuc
}

fn _cagri_adi(anahtar: text) -> text {
    var p = anahtar.split(":")
    return p[2]
}

# Dur/Atla bul (iç içe döngülerin kendi stop/skip'leri hariç)
fn _dur_atla_bul(d: parser.Dugum) -> parser.Dugum? {
    if d.tur is "Dur" or d.tur is "Atla" {
        return d
    }
    if d.tur is "TekrarSayi" or d.tur is "TekrarSurece" or d.tur is "TekrarSayac" or d.tur is "ParalelTekrar" {
        return none
    }
    repeat i from 1 to d.cocuklar.length {
        var x = _dur_atla_bul(d.cocuklar[i])
        if x is not none {
            return x
        }
    }
    return none
}

# parallel repeat'te L[sayac] = ... ile yazılan dışarıdaki listeler
fn _eleman_listeleri(d: parser.Dugum, adlar: [text], sayac: text, liste: [text]) -> [text] {
    var s = liste
    var c = d.cocuklar
    if d.tur is "ElemanAtama" and c[1].tur is "Isim" and _icinde_mi(c[1].deger, adlar) and liste_mi(c[1].tip) and c[2].tur is "Isim" and c[2].deger is sayac {
        s = _ekle_tekil(s, c[1].deger)
    }
    repeat i from 1 to c.length {
        s = _eleman_listeleri(c[i], adlar, sayac, s)
    }
    return s
}

fn _paralel_dogrula(program: [parser.Dugum]) {
    # 1) Her fonksiyonun ve metodun kendi etkisi
    var etkiler: {text: Etki} = {}
    repeat i from 1 to program.length {
        var k = program[i]
        if k.tur is "FonksiyonTanimi" {
            etkiler["fn:{k.deger}"] = _fonksiyon_etkisi(k, "")
        } else if k.tur is "TipTanimi" {
            var metotlar = k.cocuklar[2].cocuklar
            repeat j from 1 to metotlar.length {
                etkiler["metot:{k.deger}.{metotlar[j].deger}"] = _fonksiyon_etkisi(metotlar[j], k.deger)
            }
        }
    }
    # 2) Çağırdıkları fonksiyonlarınkiyle birleştir (değişiklik kalmayana kadar)
    var degisti = true
    var adlar = etkiler.keys()
    repeat while degisti {
        degisti = false
        repeat i from 1 to adlar.length {
            var once = etkiler[adlar[i]]
            var sonra = _toplam_etki(once, etkiler)
            if sonra.okur.length is not once.okur.length or sonra.yazar.length is not once.yazar.length {
                etkiler[adlar[i]] = sonra
                degisti = true
            }
        }
    }
    # 3) Her paralel bölümü kontrol et
    repeat i from 1 to PARALEL_KAYITLARI.length {
        var p = PARALEL_KAYITLARI[i]
        if p.tur is "blok" {
            _blok_dogrula(p, etkiler)
        } else {
            _tekrar_dogrula(p, etkiler)
        }
        if not _tamam() {
            return
        }
    }
    # 4) start ile başlatılan işler: dışarıdakini değiştirmemeli, değişen bir şeyi okumamalı
    if BASLATMALAR.length > 0 {
        _baslatma_dogrula(program, etkiler)
    }
}

# Arka plandaki iş ana programla aynı anda çalışır: sadece kendisine verilen değerlerle çalışmalı.
fn _baslatma_dogrula(program: [parser.Dugum], etkiler: {text: Etki}) {
    # Programda (ana programda ya da herhangi bir fonksiyonda) değiştirilen dış değişkenler
    var adlar = ANA.keys()
    var anahtarlar: [text] = []
    repeat i from 1 to adlar.length {
        anahtarlar.add("ana:{adlar[i]}")
    }
    var bos: [text] = []
    var degisen: [text] = []
    repeat i from 1 to program.length {
        var k = program[i]
        if k.tur is not "FonksiyonTanimi" and k.tur is not "TipTanimi" and k.tur is not "EnumTanimi" {
            var e = _etki(k, adlar, anahtarlar, _bos_etki(), "", bos, "")
            degisen = _birlestir(degisen, e.yazar)
        }
    }
    var fadlar = etkiler.keys()
    repeat i from 1 to fadlar.length {
        degisen = _birlestir(degisen, etkiler[fadlar[i]].yazar)
    }
    repeat i from 1 to BASLATMALAR.length {
        var b = BASLATMALAR[i]
        var ad = b.cocuklar[1].deger
        if etkiler.has("fn:{ad}") {
            var f = etkiler["fn:{ad}"]
            if f.yazar.length > 0 {
                _hata(b, dil.sec("'{ad}' arka planda başlatılamaz: '{_gorunen_ad(f.yazar[1])}' değişkenini değiştiriyor (kendisi ya da çağırdığı bir fonksiyon).\n   Arka plandaki iş ana programla aynı anda çalışır; sadece kendisine verilen değerlerle çalışıp sonucunu döndürmeli:\n   var sonuc = gorev.wait()   ile alıp ana programda değiştir.", "'{ad}' can't be started in the background: it changes the '{_gorunen_ad(f.yazar[1])}' variable (itself or through a function it calls).\n   A background task runs at the same time as the main program; it should only work with the values given to it and return its result:\n   get it with   var result = job.wait()   and change things in the main program."))
                return
            }
            var x = _kesisim(f.okur, degisen)
            if x.length > 0 {
                _hata(b, dil.sec("'{ad}' arka planda başlatılamaz: '{_gorunen_ad(x)}' değişkenini okuyor, ama o değişken programın başka bir yerinde değişiyor\n   (iş çalışırken değişirse yarım bir değer görebilir). Değerini parametre olarak ver:   start {ad}(..., {_gorunen_ad(x)})", "'{ad}' can't be started in the background: it reads the '{_gorunen_ad(x)}' variable, but that variable changes somewhere else in the program\n   (if it changes while the task runs, the task may see a half-written value). Pass its value as a parameter:   start {ad}(..., {_gorunen_ad(x)})"))
                return
            }
        }
    }
}

fn _blok_dogrula(p: ParalelKaydi, etkiler: {text: Etki}) {
    var gorevler = p.dugum.cocuklar[1].cocuklar
    var gorev_etkileri: [Etki] = []
    var bos: [text] = []
    repeat i from 1 to gorevler.length {
        var e = _etki(gorevler[i], p.adlar, p.anahtarlar, _bos_etki(), p.tip_icinde, bos, "")
        if gorevler[i].tur is "DegiskenTanimi" {      # 'var x = ...' işi x'i oluşturuyor
            e.yazar = _ekle_tekil(e.yazar, _anahtari(gorevler[i].deger, p.adlar, p.anahtarlar))
        }
        gorev_etkileri.add(_toplam_etki(e, etkiler))
    }
    repeat i from 1 to gorevler.length {
        var izlenen = _kesisim(gorev_etkileri[i].yazar, WHEN_IZLENEN)
        if izlenen.length > 0 {
            _hata(gorevler[i], dil.sec("'{_gorunen_ad(izlenen)}' bir when tarafından izleniyor; parallel bloğunun içinde değiştirilemez.\n   (when, değişiklik olunca hemen çalışır; o an başka çekirdekte olurdu.)", "'{_gorunen_ad(izlenen)}' is watched by a when; it can't be changed inside a parallel block.\n   (when runs right away when something changes; at that moment it would be on another core.)"))
            return
        }
        repeat j from i + 1 to gorevler.length {
            var x = _kesisim(gorev_etkileri[i].yazar, _birlestir(gorev_etkileri[j].okur, gorev_etkileri[j].yazar))
            var yazan = i
            var kullanan = j
            if x.length is 0 {
                x = _kesisim(gorev_etkileri[j].yazar, gorev_etkileri[i].okur)
                yazan = j
                kullanan = i
            }
            if x.length > 0 {
                _hata(gorevler[kullanan], dil.sec("'{_gorunen_ad(x)}' değişkenini bir iş değiştiriyor (satır {gorevler[yazan].satir}), başka bir iş de kullanıyor (satır {gorevler[kullanan].satir}).\n   parallel bloğundaki işler aynı anda çalışır; aynı değişkene dokunurlarsa sonuç bozulur.\n   Bu işleri bloğun dışında sırayla yaz ya da farklı değişkenler kullan.", "The '{_gorunen_ad(x)}' variable is changed by one task (line {gorevler[yazan].satir}) and used by another task (line {gorevler[kullanan].satir}).\n   Tasks in a parallel block run at the same time; if they touch the same variable, the result gets corrupted.\n   Write these tasks one after another outside the block, or use different variables."))
                return
            }
        }
    }
}

# ---- parallel repeat'te toplama: x = x + ... , x = x * ... , L[a] = L[a] + ... ----
# Her çekirdek kendi ara sonucunda toplar; döngü bitince ara sonuçlar asıl değişkene eklenir.
fn _ayni_agac(a: parser.Dugum, b: parser.Dugum) -> bool {
    if a.tur is not b.tur or a.deger is not b.deger or a.cocuklar.length is not b.cocuklar.length {
        return false
    }
    repeat i from 1 to a.cocuklar.length {
        if not _ayni_agac(a.cocuklar[i], b.cocuklar[i]) {
            return false
        }
    }
    return true
}

fn _ad_geciyor_mu(d: parser.Dugum, ad: text) -> bool {
    if (d.tur is "Isim" or d.tur is "Atama") and d.deger is ad {
        return true
    }
    repeat i from 1 to d.cocuklar.length {
        if _ad_geciyor_mu(d.cocuklar[i], ad) {
            return true
        }
    }
    return false
}

fn _toplama_islemi_mi(e: parser.Dugum) -> bool {
    return e.tur is "IkiliIslem" and (e.deger is "+" or e.deger is "-" or e.deger is "*") and (e.tip is "int" or e.tip is "float")
}

# Toplama komutu mu? Öyleyse hedefin adı, değilse "".  (adlar: döngünün dışındaki değişkenler)
fn toplama_hedefi(d: parser.Dugum, adlar: [text], sayac: text) -> text {
    var c = d.cocuklar
    if d.tur is "Atama" and _icinde_mi(d.deger, adlar) and c.length is 1 and _toplama_islemi_mi(c[1]) {
        var x = c[1].cocuklar
        if x[1].tur is "Isim" and x[1].deger is d.deger and not _ad_geciyor_mu(x[2], d.deger) {
            return d.deger                           # x = x + e
        }
        if c[1].deger is not "-" and x[2].tur is "Isim" and x[2].deger is d.deger and not _ad_geciyor_mu(x[1], d.deger) {
            return d.deger                           # x = e + x
        }
        return ""
    }
    if d.tur is "ElemanAtama" and d.ek is not "sozluk" and c[1].tur is "Isim" and _icinde_mi(c[1].deger, adlar) and _toplama_islemi_mi(c[3]) {
        var ad = c[1].deger
        if c[2].tur is "Isim" and c[2].deger is sayac {
            return ""                                # L[i] = ...: her tur kendi elemanı (toplama değil)
        }
        if _ad_geciyor_mu(c[2], ad) {
            return ""
        }
        var x = c[3].cocuklar
        var oku = x[1]
        var diger = x[2]
        if not (oku.tur is "Erisim" and oku.cocuklar[1].tur is "Isim" and oku.cocuklar[1].deger is ad) and c[3].deger is not "-" {
            oku = x[2]
            diger = x[1]
        }
        if oku.tur is "Erisim" and oku.cocuklar[1].tur is "Isim" and oku.cocuklar[1].deger is ad and _ayni_agac(oku.cocuklar[2], c[2]) and not _ad_geciyor_mu(diger, ad) {
            return ad                                # L[a] = L[a] + e
        }
    }
    return ""
}

# Toplamanın türü: "+" (toplama/çıkarma) ya da "*"
fn toplama_turu(d: parser.Dugum) -> text {
    var e = d.cocuklar[1]
    if d.tur is "ElemanAtama" {
        e = d.cocuklar[3]
    }
    if e.deger is "*" {
        return "*"
    }
    return "+"
}

# Toplama komutlarını, sadece hesapladıkları parçalar kalacak şekilde ağaçtan çıkar (geri kalan kullanım kontrolü için)
fn _toplamalari_cikar(d: parser.Dugum, adlar: [text], sayac: text) -> parser.Dugum {
    var y = d
    if toplama_hedefi(d, adlar, sayac).length > 0 {
        y.tur = "Toplama"
        if d.tur is "Atama" {
            var x = d.cocuklar[1].cocuklar
            if x[1].tur is "Isim" and x[1].deger is d.deger {
                y.cocuklar = [x[2]]
            } else {
                y.cocuklar = [x[1]]
            }
        } else {
            var x = d.cocuklar[3].cocuklar
            if x[1].tur is "Erisim" and x[1].cocuklar[1].tur is "Isim" and x[1].cocuklar[1].deger is d.cocuklar[1].deger {
                y.cocuklar = [d.cocuklar[2], x[2]]
            } else {
                y.cocuklar = [d.cocuklar[2], x[1]]
            }
        }
        return y
    }
    var yeni: [parser.Dugum] = []
    repeat i from 1 to d.cocuklar.length {
        yeni.add(_toplamalari_cikar(d.cocuklar[i], adlar, sayac))
    }
    y.cocuklar = yeni
    return y
}

fn _toplamalari_bul(d: parser.Dugum, adlar: [text], sayac: text, bulunan: [parser.Dugum]) -> [parser.Dugum] {
    var s = bulunan
    if toplama_hedefi(d, adlar, sayac).length > 0 {
        s.add(d)
        return s
    }
    repeat i from 1 to d.cocuklar.length {
        s = _toplamalari_bul(d.cocuklar[i], adlar, sayac, s)
    }
    return s
}

fn _tekrar_dogrula(p: ParalelKaydi, etkiler: {text: Etki}) {
    var govde = p.dugum.cocuklar[4]
    var dur = _dur_atla_bul(govde)
    if dur is not none {
        var kelime = "stop"
        if dur.tur is "Atla" {
            kelime = "skip"
        }
        _hata(dur, dil.sec("'parallel repeat'in içinde '{kelime}' kullanılamaz: turlar aynı anda farklı çekirdeklerde çalışıyor.\n   Bir turun işini atlamak için 'if' kullan.", "'{kelime}' can't be used inside 'parallel repeat': the rounds run at the same time on different cores.\n   To skip the work of one round, use 'if'."))
        return
    }
    var bos: [text] = []
    var listeler = _eleman_listeleri(govde, p.adlar, p.sayac, bos)
    # Toplamalar: x = x + ... (her çekirdek kendi ara toplamını tutar)
    var bos_d: [parser.Dugum] = []
    var toplamalar = _toplamalari_bul(govde, p.adlar, p.sayac, bos_d)
    var t_adlari: [text] = []
    var t_turleri: [text] = []
    repeat i from 1 to toplamalar.length {
        var ad = toplama_hedefi(toplamalar[i], p.adlar, p.sayac)
        var tur = toplama_turu(toplamalar[i])
        var yer = 0
        repeat j from 1 to t_adlari.length {
            if t_adlari[j] is ad {
                yer = j
            }
        }
        if yer is 0 {
            t_adlari.add(ad)
            t_turleri.add(tur)
        } else if t_turleri[yer] is not tur {
            _hata(toplamalar[i], dil.sec("'{ad}' bu döngüde hem toplanıyor (+, -) hem çarpılıyor (*); ikisi bir arada olamaz.\n   (Her çekirdek kendi ara sonucunu tutup en sonda birleştiriyor; bunun için tek tür işlem gerekir.)", "'{ad}' is both added (+, -) and multiplied (*) in this loop; both can't happen together.\n   (Each core keeps its own partial result and they are combined at the end; this needs a single kind of operation.)"))
            return
        }
        if _icinde_mi(ad, listeler) {
            _hata(toplamalar[i], dil.sec("'{ad}' listesine bu döngüde hem kendi sırasından ({ad}[{p.sayac}] = ...) yazılıyor hem de toplanıyor; ikisi bir arada olamaz.", "In this loop the '{ad}' list is both written at its own position ({ad}[{p.sayac}] = ...) and summed; both can't happen together."))
            return
        }
        var izlenen = _anahtari(ad, p.adlar, p.anahtarlar)
        if _icinde_mi(izlenen, WHEN_IZLENEN) {
            _hata(toplamalar[i], dil.sec("'{ad}' bir when tarafından izleniyor; parallel repeat'in içinde değiştirilemez.\n   (when, değişiklik olunca hemen çalışır; o an başka çekirdekte olurdu.)", "'{ad}' is watched by a when; it can't be changed inside parallel repeat.\n   (when runs right away when something changes; at that moment it would be on another core.)"))
            return
        }
    }
    var dogrudan = _etki(_toplamalari_cikar(govde, p.adlar, p.sayac), p.adlar, p.anahtarlar, _bos_etki(), p.tip_icinde, listeler, p.sayac)
    repeat i from 1 to t_adlari.length {
        var anahtar = _anahtari(t_adlari[i], p.adlar, p.anahtarlar)
        if _icinde_mi(anahtar, dogrudan.okur) or _icinde_mi(anahtar, dogrudan.yazar) {
            _hata(p.dugum, dil.sec("'{t_adlari[i]}' bu parallel repeat'te toplanıyor; döngünün içinde başka bir yerde kullanılamaz.\n   (Döngü sürerken her çekirdek sadece kendi ara toplamını bilir; doğru sonuç döngü bitince hazır olur.)", "'{t_adlari[i]}' is being summed in this parallel repeat; it can't be used anywhere else inside the loop.\n   (While the loop runs, each core only knows its own partial sum; the correct result is ready when the loop ends.)"))
            return
        }
        repeat j from 1 to dogrudan.cagirir.length {
            var c = dogrudan.cagirir[j]
            if etkiler.has(c) and _icinde_mi(anahtar, etkiler[c].okur) {
                _hata(p.dugum, dil.sec("'{_cagri_adi(c)}' fonksiyonu '{t_adlari[i]}' değişkenini okuyor; o değişken bu döngüde toplanırken okunamaz.", "The '{_cagri_adi(c)}' function reads the '{t_adlari[i]}' variable; that variable can't be read while it is being summed in this loop."))
                return
            }
        }
    }
    if dogrudan.yazar.length > 0 {
        var x = _gorunen_ad(dogrudan.yazar[1])
        _hata(p.dugum, dil.sec("'{x}' parallel repeat'in turlarında değiştirilemez: turlar aynı anda çalışıyor.\n   Her tur sadece bir listenin kendi elemanını değiştirebilir:   liste[{p.sayac}] = ...\n   ya da toplayabilir:   toplam = toplam + ...   (+, - ya da *; listede:  sayilar[k] = sayilar[k] + ...)", "'{x}' can't be changed in the rounds of parallel repeat: the rounds run at the same time.\n   Each round can only change its own element of a list:   list[{p.sayac}] = ...\n   or add to a total:   total = total + ...   (+, - or *; in a list:  numbers[k] = numbers[k] + ...)"))
        return
    }
    repeat i from 1 to listeler.length {
        if _icinde_mi(_anahtari(listeler[i], p.adlar, p.anahtarlar), dogrudan.okur) {
            _hata(p.dugum, dil.sec("'{listeler[i]}' listesinin her turda sadece kendi elemanı kullanılabilir:   {listeler[i]}[{p.sayac}]\n   (Başka bir sıradaki eleman o anda başka bir çekirdekte değişiyor olabilir.)", "In each round only its own element of the '{listeler[i]}' list can be used:   {listeler[i]}[{p.sayac}]\n   (An element at another position may be changing at that moment on another core.)"))
            return
        }
    }
    repeat i from 1 to dogrudan.cagirir.length {
        var c = dogrudan.cagirir[i]
        if etkiler.has(c) {
            var f = etkiler[c]
            if f.yazar.length > 0 {
                _hata(p.dugum, dil.sec("'{_cagri_adi(c)}' fonksiyonu '{_gorunen_ad(f.yazar[1])}' değişkenini (kendisi ya da çağırdığı bir fonksiyon) değiştiriyor; parallel repeat'in içinden çağrılamaz (turlar aynı anda çalışıyor).", "The '{_cagri_adi(c)}' function changes the '{_gorunen_ad(f.yazar[1])}' variable (itself or through a function it calls); it can't be called from inside parallel repeat (the rounds run at the same time)."))
                return
            }
            repeat j from 1 to listeler.length {
                if _icinde_mi(_anahtari(listeler[j], p.adlar, p.anahtarlar), f.okur) {
                    _hata(p.dugum, dil.sec("'{_cagri_adi(c)}' fonksiyonu '{listeler[j]}' listesini okuyor; o liste bu döngüde değişirken başka çekirdekte okunamaz.", "The '{_cagri_adi(c)}' function reads the '{listeler[j]}' list; that list can't be read on another core while it changes in this loop."))
                    return
                }
            }
        }
    }
}

fn kontrol_et(program: parser.Dugum) -> Sonuc {
    use change HATA
    use change BASLATMALAR
    use change HATA_YIGINI
    use change HATA_IZNI
    use change SON_IZIN
    use change HATA_ELE_ALINDI
    use change GENERIKLER
    use change LAMBDALAR
    use change TIP_YERINE
    use change ORNEKLER
    use change GENERIK_TIPLER
    use change TIP_ORNEKLERI
    use change DESTEK
    use change FONKSIYONLAR
    use change ANA
    use change YIGIN
    use change FN
    use change UST_TANIMLAR
    use change KAPANAN
    use change DONGU
    use change WHEN
    use change ARENA
    use change C_YAPILARI
    use change PARALEL
    use change PARALEL_KAYITLARI
    use change WHEN_IZLENEN
    use change OLCUM
    use change TIPLER
    use change ENUMLAR
    use change AKTIF
    use change TIP_ICINDE
    use change PENCERE_SATIR
    HATA = ""
    DESTEK = ""
    FONKSIYONLAR = {}
    ANA = {}
    YIGIN = []
    FN = ""
    UST_TANIMLAR = {}
    KAPANAN = {}
    DONGU = 0
    WHEN = 0
    ARENA = 0
    C_YAPILARI = {}
    PARALEL = 0
    PARALEL_KAYITLARI = []
    WHEN_IZLENEN = []
    BASLATMALAR = []
    HATA_YIGINI = []
    GENERIKLER = {}
    LAMBDALAR = []
    TIP_YERINE = {}
    ORNEKLER = []
    GENERIK_TIPLER = {}
    TIP_ORNEKLERI = []
    HATA_IZNI = ""
    SON_IZIN = ""
    HATA_ELE_ALINDI = false
    OLCUM = 0
    TIPLER = {}
    ENUMLAR = {}
    AKTIF = _bos_fonksiyon()
    TIP_ICINDE = ""
    PENCERE_SATIR = 0
    var komutlar = program.cocuklar
    var sonuc = komutlar

    repeat i from 1 to komutlar.length {
        if komutlar[i].tur is "ImportKomutu" {
            _desteklenmiyor("ImportKomutu")
        }
    }

    # 0. TUR: kendi tipler ve enum'lar (adları, sonra ayrıntıları) — böylece sırası fark etmez
    repeat i from 1 to komutlar.length {
        var t = komutlar[i]
        if _tamam() and t.tur is "TipTanimi" and t.cocuklar.length > 2 {
            if TIP_ADLARI.has(t.deger) or TIPLER.has(t.deger) or GENERIK_TIPLER.has(t.deger) {
                _hata(t, dil.sec("'{t.deger}' adında bir tip zaten var.", "There is already a type named '{t.deger}'."))
            } else {
                GENERIK_TIPLER[t.deger] = t
            }
        } else if _tamam() and t.tur is "TipTanimi" {
            if TIP_ADLARI.has(t.deger) {
                _hata(t, dil.sec("'{t.deger}' dilin hazır bir tipi, aynı adla yeni tip tanımlanamaz.", "'{t.deger}' is a built-in type of the language; a new type with the same name can't be defined."))
            } else if TIPLER.has(t.deger) {
                _hata(t, dil.sec("'{t.deger}' adında bir tip zaten var (satır {TIPLER[t.deger].satir}).", "There is already a type named '{t.deger}' (line {TIPLER[t.deger].satir})."))
            } else {
                TIPLER[t.deger] = TipBilgisi(ad: t.deger, satir: t.satir, alan_adlari: [], alan_tipleri: [], alan_varsayilanli: [], alan_satirlari: [], metotlar: {})
            }
        }
    }
    repeat i from 1 to komutlar.length {                    # extern içindeki C yapıları
        var e = komutlar[i]
        if _tamam() and e.tur is "ExternBlok" and e.cocuklar.length > 2 {
            var yapilar = e.cocuklar[3].cocuklar
            repeat j from 1 to yapilar.length {
                var t = yapilar[j]
                if TIP_ADLARI.has(t.deger) or TIPLER.has(t.deger) {
                    _hata(t, dil.sec("'{t.deger}' adında bir tip zaten var.", "There is already a type named '{t.deger}'."))
                } else {
                    TIPLER[t.deger] = TipBilgisi(ad: t.deger, satir: t.satir, alan_adlari: [], alan_tipleri: [], alan_varsayilanli: [], alan_satirlari: [], metotlar: {})
                }
            }
        }
    }
    repeat i from 1 to komutlar.length {
        var t = komutlar[i]
        if _tamam() and t.tur is "EnumTanimi" {
            if TIP_ADLARI.has(t.deger) or TIPLER.has(t.deger) or ENUMLAR.has(t.deger) {
                _hata(t, dil.sec("'{t.deger}' adında bir tip zaten var.", "There is already a type named '{t.deger}'."))
            } else {
                ENUMLAR[t.deger] = EnumBilgisi(ad: t.deger, cesitler: [], alan_adlari: [], alan_tipleri: [])
            }
        }
    }
    repeat i from 1 to komutlar.length {
        if _tamam() and komutlar[i].tur is "EnumTanimi" {
            _enum_ayrintilari(komutlar[i])
        }
    }
    repeat i from 1 to komutlar.length {
        if _tamam() and komutlar[i].tur is "TipTanimi" and komutlar[i].cocuklar.length > 2 {
            sonuc[i] = parser.Dugum(tur: "Bos", deger: "", ek: "", cocuklar: [], satir: komutlar[i].satir, sutun: komutlar[i].sutun)
        } else if _tamam() and komutlar[i].tur is "TipTanimi" {
            sonuc[i] = _tip_ayrintilari(komutlar[i])
        }
    }
    repeat i from 1 to komutlar.length {                    # C yapılarının ayrıntıları (tipli hâlleri extern bloğuna geri konur)
        var e = komutlar[i]
        if _tamam() and e.tur is "ExternBlok" and e.cocuklar.length > 2 {
            var tipli_yapilar: [parser.Dugum] = []
            var yapilar = e.cocuklar[3].cocuklar
            repeat j from 1 to yapilar.length {
                tipli_yapilar.add(_c_yapi_ayrintilari(yapilar[j]))
            }
            sonuc[i] = _c(e, [e.cocuklar[1], e.cocuklar[2], _liste(tipli_yapilar)], "")
        }
    }

    # 1. TUR: C fonksiyonları ve bütün fonksiyonların imzası (böylece tanımlanmadan önce de çağrılabilir)
    repeat i from 1 to komutlar.length {
        if _tamam() and komutlar[i].tur is "ExternBlok" {
            _extern_kaydet(komutlar[i])
        }
    }
    repeat i from 1 to komutlar.length {
        var k = komutlar[i]
        if _tamam() and k.tur is "FonksiyonTanimi" and k.cocuklar.length > 3 {
            _generik_kaydet(k)
        } else if _tamam() and k.tur is "FonksiyonTanimi" {
            _imza_kaydet(k)
        } else if k.tur is "DegiskenTanimi" and not UST_TANIMLAR.has(k.deger) {
            UST_TANIMLAR[k.deger] = k.satir
        }
    }

    # 2. TUR: ana program, yukarıdan aşağı
    repeat i from 1 to komutlar.length {
        if not _tamam() {
            stop
        }
        var tur = komutlar[i].tur
        if tur is not "FonksiyonTanimi" and tur is not "TipTanimi" and tur is not "EnumTanimi" and tur is not "ExternBlok" {
            sonuc[i] = _komut(komutlar[i])
        }
    }

    # 3. TUR: her fonksiyonun ve her metodun içi, kendi kapsamında
    repeat i from 1 to komutlar.length {
        if not _tamam() {
            stop
        }
        if komutlar[i].tur is "FonksiyonTanimi" and komutlar[i].cocuklar.length > 3 {
            sonuc[i] = parser.Dugum(tur: "Bos", deger: "", ek: "", cocuklar: [], satir: komutlar[i].satir, sutun: komutlar[i].sutun)
        } else if komutlar[i].tur is "FonksiyonTanimi" {
            sonuc[i] = _fonksiyon_govdesi(komutlar[i], FONKSIYONLAR[komutlar[i].deger], "")
        }
    }
    repeat i from 1 to komutlar.length {
        if not _tamam() {
            stop
        }
        if komutlar[i].tur is "TipTanimi" and komutlar[i].cocuklar.length < 3 {
            var t = sonuc[i]
            var b = TIPLER[t.deger]
            var metotlar = t.cocuklar[2].cocuklar
            var tipli: [parser.Dugum] = []
            repeat j from 1 to metotlar.length {
                tipli.add(_fonksiyon_govdesi(metotlar[j], b.metotlar[metotlar[j].deger], t.deger))
                if not _tamam() {
                    stop
                }
            }
            sonuc[i] = _c(t, [t.cocuklar[1], _liste(tipli)], "")
        }
    }
    # Generic fonksiyonların kullanılan tipler için kopyaları (kopyalar yeni kopyalar isteyebilir)
    var ok_no = 1
    var tok_no = 1
    repeat while (ok_no <= ORNEKLER.length or tok_no <= TIP_ORNEKLERI.length) and _tamam() {
        if tok_no <= TIP_ORNEKLERI.length {          # generic tip kopyası: metotlarının içi
            var to = TIP_ORNEKLERI[tok_no]
            var onceki_y = TIP_YERINE
            TIP_YERINE = to.yerine
            var tb = TIPLER[to.ad]
            var tmetotlar = to.tipli.cocuklar[2].cocuklar
            var ttipli: [parser.Dugum] = []
            repeat j from 1 to tmetotlar.length {
                if _tamam() {
                    ttipli.add(_fonksiyon_govdesi(tmetotlar[j], tb.metotlar[tmetotlar[j].deger], to.ad))
                }
            }
            TIP_YERINE = onceki_y
            sonuc.add(_c(to.tipli, [to.tipli.cocuklar[1], _liste(ttipli)], ""))
            tok_no = tok_no + 1
            skip
        }
        var o = ORNEKLER[ok_no]
        var onceki_yerine = TIP_YERINE
        TIP_YERINE = o.yerine
        var kopya = parser.Dugum(tur: o.tanim.tur, deger: o.ad, ek: o.tanim.ek, cocuklar: [o.tanim.cocuklar[1], o.tanim.cocuklar[2], o.tanim.cocuklar[3]], satir: o.tanim.satir, sutun: o.tanim.sutun, dosya: o.tanim.dosya)
        sonuc.add(_fonksiyon_govdesi(kopya, FONKSIYONLAR[o.ad], ""))
        TIP_YERINE = onceki_yerine
        if not _tamam() {                            # hatanın hangi tipler için çıktığını söyle
            var baglar: [text] = []
            var tadlar = o.yerine.keys()
            repeat j from 1 to tadlar.length {
                baglar.add("{tadlar[j]} = {o.yerine[tadlar[j]]}")
            }
            HATA = dil.sec("{HATA}\n   (generic '{o.tanim.deger}' fonksiyonunun {baglar.join(", ")} için kopyasında)", "{HATA}\n   (in the copy of the generic function '{o.tanim.deger}' for {baglar.join(", ")})")
        }
        ok_no = ok_no + 1
    }
    if HATA.length is 0 and (PARALEL_KAYITLARI.length > 0 or BASLATMALAR.length > 0) {
        _paralel_dogrula(sonuc)                      # aynı anda çalışan işler aynı değişkene dokunuyor mu?
    }
    if DESTEK.length > 0 {
        return Sonuc.Hata(mesaj: "DESTEKLENMIYOR: {DESTEK}")
    }
    if HATA.length > 0 {
        return Sonuc.Hata(mesaj: HATA)
    }
    return Sonuc.Tamam(agac: _c(program, sonuc, ""))
}
