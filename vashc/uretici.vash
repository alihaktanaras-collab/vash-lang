# =====================================================================
#  4. İSTASYON: LLVM IR ÜRETİCİ — Vash ile yazılmış hâli
# =====================================================================
#  Python'daki derleyici/llvm_uretici.py'nin karşılığı.
#  Tipleri kontrol edilmiş ağacı LLVM IR'a (makineye çok yakın bir dile) çevirir.
#  Tip kontrolünün bulduğu bilgiler (tipler, fonksiyonlar, ana programın değişkenleri)
#  doğrudan tipler modülünden okunur.
#
#      var x = 2 + 3      →      %t1 = add i64 2, 3
#                                store i64 %t1, ptr %"v.x.1"
# =====================================================================

import parser
import tipler
import dil

type Adres {
    adres: text
    tip: text
}

type Dongu {
    ilerle: text            # skip'in gideceği yer
    cikis: text             # stop'un gideceği yer
}

# do { } catch hata { }: hata olunca atlanacak yer ve hatanın konacağı değişken
type Yakalayici {
    etiket: text
    adres: text
}

# Blok içinde yazılmış bir when: izlediği değişkenlerin adresleri ve kendi "önceki" bilgisi
type YerelWhen {
    kosul: parser.Dugum
    govde: [parser.Dugum]
    onceki: text
    uretiliyor: bool
    adresler: [text]
}

# Bir değer ve "yeni mi (sahibi biz miyiz)?" bilgisi
type Deger {
    v: text
    yeni: bool
}

# Bir döngünün kontrol ve ilerleme adımlarını üretmek için gereken bilgiler
type DonguBilgisi {
    tur: text               # "sayi" / "surece" / "sayac"
    kosul: parser.Dugum
    sayac: text = ""
    kac: text = ""
    i: text = ""
    son: text = ""
    adim: text = ""
    yon: text = ""          # "ileri" / "geri" / "calisirken"
    buyukluk: int = 0
    satir: int = 0
}

# C fonksiyonunun C tarafındaki imzası
type CBilgisi {
    ad: text
    parametreler: [text]
    donus: text
}

# Argümanlar: LLVM yazısı + sonra bırakılacak geçici değerler
type Argumanlar {
    parcalar: [text]
    dugumler: [parser.Dugum]
    degerler: [text]
}

type Kacisli {
    yazi: text
    bayt: int
}

enum Sonuc {
    Tamam(ir: text)
    Hata(mesaj: text)
}

